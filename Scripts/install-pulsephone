#!/bin/bash

set -euo pipefail

readonly repository="mengkaka/PulsePhone"
readonly asset_name="PulsePhone-macos-arm64.zip"
readonly checksum_name="${asset_name}.sha256"
readonly bundle_identifier="com.pulsephone.PulsePhone"
readonly team_identifier="GZC4TSS5TG"
readonly release_base_url="https://github.com/${repository}/releases/latest/download"

fail() {
    /usr/bin/printf 'PulsePhone installer: %s\n' "$*" >&2
    exit 1
}

require_macos_arm64() {
    [ "$(/usr/bin/uname -s)" = "Darwin" ] || fail "macOS is required"
    [ "$(/usr/bin/uname -m)" = "arm64" ] || fail "Apple silicon is required"

    local_version="$(/usr/bin/sw_vers -productVersion)"
    local_major="${local_version%%.*}"
    case "$local_major" in
        ''|*[!0-9]*) fail "could not determine the macOS version" ;;
    esac
    [ "$local_major" -ge 14 ] || fail "macOS 14 or later is required"
}

configure_shell_path() {
    local launcher_path="$1"
    local launcher_directory="${launcher_path%/*}"
    local shell_name="${SHELL:-}"
    local path_line='export PATH="$HOME/.local/bin:$PATH"'
    local profile
    local login_profile

    if [ "$launcher_path" != "${HOME:-}/.local/bin/PulsePhone" ]; then
        /usr/bin/printf '\nShell HOME differs from the install location.\n'
        report_incomplete_path "$launcher_path"
        return
    fi

    case "${shell_name##*/}" in
        zsh)
            /usr/bin/printf '\nShell: zsh\n'
            profile="${ZDOTDIR:-$HOME}/.zshrc"
            if ! profile_is_safe "$profile" || ! ensure_profile_path "$profile" "$path_line"; then
                /usr/bin/printf 'Cannot safely update %s.\n' "$profile"
                report_incomplete_path "$launcher_path"
                return
            fi
            ;;
        bash)
            /usr/bin/printf '\nShell: bash\n'
            login_profile="$HOME/.bash_profile"
            for profile in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
                if [ -e "$profile" ] || [ -L "$profile" ]; then
                    login_profile="$profile"
                    break
                fi
            done
            for profile in "$login_profile" "$HOME/.bashrc"; do
                if ! profile_is_safe "$profile"; then
                    /usr/bin/printf 'Cannot safely update %s.\n' "$profile"
                    report_incomplete_path "$launcher_path"
                    return
                fi
            done
            for profile in "$login_profile" "$HOME/.bashrc"; do
                if ! ensure_profile_path "$profile" "$path_line"; then
                    /usr/bin/printf 'Cannot safely update %s.\n' "$profile"
                    report_incomplete_path "$launcher_path"
                    return
                fi
            done
            ;;
        *)
            /usr/bin/printf '\nShell %s is not recognized.\n' "${SHELL:-unknown}"
            report_incomplete_path "$launcher_path"
            return ;;
    esac

    /usr/bin/printf '\nNew terminals will load this setting automatically.\n'
    case ":${PATH:-}:" in
        *":${launcher_directory}:"*) ;;
        *) /usr/bin/printf 'To use PulsePhone in this terminal, run:\n\n  %s\n' "$path_line" ;;
    esac
    /usr/bin/printf '\nThen get started with:\n\n  PulsePhone --help\n'
}

report_incomplete_path() {
    /usr/bin/printf 'PulsePhone is installed, but PATH configuration was not completed automatically.\nUse %s directly and configure PATH manually.\n' "$1"
}

profile_is_safe() {
    local profile="$1"
    local parent="${profile%/*}"
    local uid
    case "$profile" in
        /*) ;;
        *) return 1 ;;
    esac
    uid="$(/usr/bin/id -u)"
    [ -d "$parent" ] && [ ! -L "$parent" ] && [ -w "$parent" ] &&
        [ "$(/usr/bin/stat -f %u "$parent")" = "$uid" ] || return 1
    if [ -e "$profile" ] || [ -L "$profile" ]; then
        [ ! -L "$profile" ] && [ -f "$profile" ] && [ -r "$profile" ] && [ -w "$profile" ] &&
            [ "$(/usr/bin/stat -f %u "$profile")" = "$uid" ] || return 1
    fi
    return 0
}

ensure_profile_path() {
    local profile="$1"
    local path_line="$2"
    if [ -f "$profile" ] && /usr/bin/grep -Fqx "$path_line" "$profile"; then
        /usr/bin/printf 'PATH configuration already exists in %s.\nNo changes needed.\n' "$profile"
        return 0
    fi
    if ! profile_is_safe "$profile" || ! (umask 077; /usr/bin/printf '\n%s\n' "$path_line" >> "$profile"); then
        return 1
    fi
    /usr/bin/printf 'Updated %s:\n  %s\n' "$profile" "$path_line"
}

cleanup() {
    status="$?"
    trap - EXIT HUP INT TERM
    /bin/rm -rf "$temporary_directory"
    exit "$status"
}

[ "$(/usr/bin/id -u)" -ne 0 ] || fail "do not run with sudo"
require_macos_arm64

temporary_directory="$(/usr/bin/mktemp -d -t pulsephone-install)"
trap cleanup EXIT HUP INT TERM

archive_path="${temporary_directory}/${asset_name}"
checksum_path="${temporary_directory}/${checksum_name}"
extract_path="${temporary_directory}/extracted"

/usr/bin/printf 'Downloading PulsePhone...\n'
/usr/bin/curl --silent --show-error --fail --location --proto '=https' --tlsv1.2 --retry 3 \
    --connect-timeout 15 --output "$archive_path" "${release_base_url}/${asset_name}"
/usr/bin/curl --silent --show-error --fail --location --proto '=https' --tlsv1.2 --retry 3 \
    --connect-timeout 15 --output "$checksum_path" "${release_base_url}/${checksum_name}"
/usr/bin/printf 'Download complete.\n'

expected_hash="$(/usr/bin/awk -v asset="$asset_name" '$2 == asset { print $1; exit }' "$checksum_path")"
case "$expected_hash" in
    *[!0123456789abcdefABCDEF]*|'') fail "release checksum has an invalid format" ;;
esac
[ "${#expected_hash}" -eq 64 ] || fail "release checksum has an invalid format"

actual_hash="$(/usr/bin/shasum -a 256 "$archive_path" | /usr/bin/awk '{ print $1 }')"
[ "$actual_hash" = "$expected_hash" ] || fail "release archive checksum mismatch"
/usr/bin/printf 'Checksum verified.\n'

/bin/mkdir "$extract_path"
/usr/bin/ditto -x -k "$archive_path" "$extract_path"
application_path="${extract_path}/PulsePhone.app"
[ -d "$application_path" ] || fail "release archive does not contain PulsePhone.app"
[ -x "${application_path}/Contents/MacOS/PulsePhone" ] || fail "release app executable is missing"

actual_bundle_identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
    "${application_path}/Contents/Info.plist")"
[ "$actual_bundle_identifier" = "$bundle_identifier" ] || fail "release bundle identifier mismatch"

if ! /usr/bin/codesign --verify --deep --strict --verbose=2 "$application_path" > "${temporary_directory}/codesign.log" 2>&1; then
    /bin/cat "${temporary_directory}/codesign.log" >&2
    fail "release app signature verification failed"
fi
actual_team_identifier="$(/usr/bin/codesign -dv --verbose=4 "$application_path" 2>&1 \
    | /usr/bin/awk -F= '/^TeamIdentifier=/{ print $2; exit }')"
[ "$actual_team_identifier" = "$team_identifier" ] || fail "release signing team mismatch"
if ! /usr/sbin/spctl --assess --type execute --verbose=4 "$application_path" > "${temporary_directory}/gatekeeper.log" 2>&1; then
    /bin/cat "${temporary_directory}/gatekeeper.log" >&2
    fail "release app Gatekeeper assessment failed"
fi
/usr/bin/printf 'App signature and Gatekeeper assessment passed.\n'

/usr/bin/printf '\nInstalling PulsePhone...\n'
install_result="$("${application_path}/Contents/MacOS/PulsePhone" self install --json)"
launcher_path="$(/usr/bin/plutil -extract result.launcherPath raw -o - - <<< "$install_result")"
installed_app_path="$(/usr/bin/plutil -extract result.applicationPath raw -o - - <<< "$install_result")"
/usr/bin/printf 'PulsePhone installed successfully.\n  Application: %s\n  Command:     %s\n' "$installed_app_path" "$launcher_path"
configure_shell_path "$launcher_path"
