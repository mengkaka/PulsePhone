    store_verify_parser.add_argument("--objects-root", required=True)

    import_parser = store_commands.add_parser("import-flow-neutral")
    import_parser.add_argument("--source-record", required=True)
    import_parser.add_argument("--alpha-stage-record", required=True)
    import_parser.add_argument("--objects-root", required=True)

    hold_parser = store_commands.add_parser("hold")
    hold_parser.add_argument("--record", required=True)
    hold_parser.add_argument("--release-flow", required=True)
    hold_parser.add_argument(
        "--reason",
        choices=["thresholdFreeze", "selectedForRelease", "legalMaterial"],
        required=True,
    )
    hold_parser.add_argument("--objects-root", required=True)

    verify_hold_parser = store_commands.add_parser("verify-hold")
    verify_hold_parser.add_argument("--hold", required=True)
    verify_hold_parser.add_argument("--objects-root", required=True)

    artifact_parser = store_commands.add_parser("fetch-artifact")
    artifact_parser.add_argument("--record", required=True)
    artifact_parser.add_argument("--relative-path", required=True)
    artifact_parser.add_argument("--output", required=True)
    artifact_parser.add_argument("--objects-root", required=True)

    subtree_parser = store_commands.add_parser("fetch-subtree")
    subtree_parser.add_argument("--record", required=True)
    subtree_parser.add_argument("--artifact-id", required=True)
    subtree_parser.add_argument("--objects-root", required=True)

    checkpoint_parser = store_commands.add_parser("checkpoint-working-ledger")
    checkpoint_parser.add_argument("--release-flow", required=True)
    checkpoint_parser.add_argument("--wal", required=True)
    checkpoint_parser.add_argument("--expected-previous-revision", type=int, required=True)
    checkpoint_parser.add_argument("--objects-root", required=True)

    fetch_wal_parser = store_commands.add_parser("fetch-working-ledger")
    fetch_wal_parser.add_argument("--release-flow", required=True)
    fetch_wal_parser.add_argument("--ledger-id", required=True)
    fetch_wal_parser.add_argument("--objects-root", required=True)

    seal_wal_parser = store_commands.add_parser("seal-working-ledger")
    seal_wal_parser.add_argument("--release-flow", required=True)
    seal_wal_parser.add_argument("--ledger-id", required=True)
    seal_wal_parser.add_argument("--expected-revision", type=int, required=True)
    seal_wal_parser.add_argument("--expected-wal-hash", required=True)
    seal_wal_parser.add_argument("--objects-root", required=True)

    release = commands.add_parser("release")
    release_commands = release.add_subparsers(dest="release_command", required=True)
    create_flow = release_commands.add_parser("create-flow")
    create_flow.add_argument("--candidate-input", required=True)
    create_flow.add_argument("--reviewed-legal-record", required=True)
    create_flow.add_argument("--objects-root", required=True)

    review = release_commands.add_parser("verify-reviewed-development-input")
    review.add_argument("--candidate-input", required=True)
    review.add_argument("--reviewed-legal-record", required=True)
    review.add_argument("--objects-root", required=True)

    build_profile_parser = release_commands.add_parser("build-profile")
    build_profile_parser.add_argument(
        "--stage", choices=["internalAlpha", "externalBeta", "formalRelease"], required=True
    )
    build_profile_parser.add_argument("--release-flow")
    build_profile_parser.add_argument("--candidate-input")
    build_profile_parser.add_argument("--candidate-record")
    build_profile_parser.add_argument("--reviewed-legal-record")
    build_profile_parser.add_argument("--negative-removal-plan")
    build_profile_parser.add_argument("--threshold-freeze-record")
    build_profile_parser.add_argument("--threshold-freeze-hold")
    build_profile_parser.add_argument("--lineage-stage-record")
    build_profile_parser.add_argument("--broad-os-coverage-set")
    build_profile_parser.add_argument("--objects-root", required=True)

    broad_parser = release_commands.add_parser("build-broad-os-coverage")
    broad_parser.add_argument("--candidate-record", required=True)
    broad_parser.add_argument("--negative-removal-plan", required=True)
    broad_parser.add_argument("--exact-evidence-store-record", action="append", default=[])
    broad_parser.add_argument("--objects-root", required=True)

    aggregate_parser = release_commands.add_parser("aggregate")
    aggregate_parser.add_argument("--profile", required=True)
    aggregate_parser.add_argument("--selection", required=True)
    aggregate_parser.add_argument("--selection-hash", required=True)
    aggregate_parser.add_argument("--provisional", action="store_true")
    aggregate_parser.add_argument("--objects-root", required=True)

    validate_manifest_parser = release_commands.add_parser("validate-manifest")
    validate_manifest_parser.add_argument("--package", required=True)
    validate_manifest_parser.add_argument(
        "--mode", choices=["stage-result", "formal-provisional"], required=True
    )
    validate_manifest_parser.add_argument("--output", required=True)

    evaluate_stage_parser = release_commands.add_parser("evaluate-stage")
    evaluate_stage_parser.add_argument("--stage-record", required=True)
    evaluate_stage_parser.add_argument("--output", required=True)
    evaluate_stage_parser.add_argument("--objects-root", default="build/evidence/objects")

    evaluate_provisional_parser = release_commands.add_parser("evaluate-provisional")
    evaluate_provisional_parser.add_argument("--stage-record", required=True)
    evaluate_provisional_parser.add_argument("--output", required=True)
    evaluate_provisional_parser.add_argument("--objects-root", default="build/evidence/objects")

    hold_selected_parser = release_commands.add_parser("hold-selected")
    hold_selected_parser.add_argument("--stage-record", required=True)
    hold_selected_parser.add_argument("--objects-root", required=True)

    finalize_parser = release_commands.add_parser("finalize")
    finalize_parser.add_argument("--provisional-stage-record", required=True)
    finalize_parser.add_argument("--hold-set", required=True)
    finalize_parser.add_argument("--objects-root", required=True)

    hold_stage_parser = release_commands.add_parser("hold-stage-manifest")
    hold_stage_parser.add_argument("--stage-record", required=True)
    hold_stage_parser.add_argument("--objects-root", required=True)

    preflight_removal_parser = release_commands.add_parser(
        "preflight-negative-removal"
    )
    preflight_removal_parser.add_argument("--alpha-stage-record", required=True)
    preflight_removal_parser.add_argument("--supersedes-plan-record")
    preflight_removal_parser.add_argument("--objects-root", required=True)

    finalize_removal_parser = release_commands.add_parser(
        "finalize-negative-removal"
    )
    finalize_removal_parser.add_argument("--write-grant", required=True)
    finalize_removal_parser.add_argument("--alpha-stage-record", required=True)
    finalize_removal_parser.add_argument("--m0-gate-report", required=True)
    finalize_removal_parser.add_argument("--m2-gate-report", required=True)
    finalize_removal_parser.add_argument("--supersedes-plan-record")
    finalize_removal_parser.add_argument("--objects-root", required=True)

    publish_parser = release_commands.add_parser("publish-final")
    publish_parser.add_argument("--stage-record", required=True)
    publish_parser.add_argument("--stage-hold", required=True)
    publish_parser.add_argument("--objects-root", required=True)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    arguments = build_parser().parse_args(argv)
    try:
        if arguments.command == "owners":
            print_json(owners_query(arguments.task))
        elif arguments.command == "contracts":
            if arguments.profile == "evidence-policy-release-complete":
                result = verify_release_complete()
            elif arguments.profile == "evidence-policy-structural":
                result = verify_policy_structural()
            else:
                result = verify_bootstrap_contracts()
            print_json({"outcome": "passed", "profile": arguments.profile, **result})
        elif arguments.command == "contract-identity":
            print_json(
                policy_identity()
                if arguments.kind == "evidence-policy"
                else gate_identity()
            )
        elif arguments.command == "artifact-path":
            objects_root = verified_objects_root(arguments.objects_root)
            key = artifact_path_key(arguments.domain, arguments.opaque_id)
            print_json(
                {
                    "artifactDomain": arguments.domain,
                    "opaqueID": arguments.opaque_id,
                    "relativePath": relative_path(objects_root / key),
                    "schemaVersion": 1,
                }
            )
        elif arguments.command == "source-snapshot":
            value = source_snapshot()
            if arguments.output:
                write_canonical_atomic(ROOT / arguments.output, value)
            print_json({**value, "snapshotHash": source_snapshot_hash(value)})
        elif arguments.command == "run":
            if arguments.profile is not None:
                require(not arguments.member and arguments.suite is None, "profile/member selection conflict")
                require(
                    arguments.release_profile is None
                    and not arguments.input_artifact,
                    "profile runner direct input conflict",
                )
                print_json(
                    run_release_profile(
                        arguments.profile,
                        arguments.candidate_record,
                        arguments.reusable_legal_record,
                        arguments.evidence_record,
                        arguments.profile_input_artifact,
                        arguments.objects_root,
                    )
                )
            else:
                require(arguments.task is not None, "--task required for member or suite run")
                require(
                    not arguments.evidence_record
                    and not arguments.profile_input_artifact
                    and not arguments.reusable_legal_record,
                    "member runner stored record conflict",
                )
                paths = run_members(
                    arguments.member,
                    arguments.suite,
                    arguments.task,
                    arguments.objects_root,
                    arguments.input_artifact,
                    arguments.release_flow,
                    arguments.evidence_stage,
                    arguments.candidate_record,
                    arguments.negative_removal_plan,
                    arguments.release_profile,
                )
                for path in paths:
                    sys.stdout.write(path + "\n")
        elif arguments.command == "validate-package":
            print_json(validate_package(arguments.package, arguments.output))
        elif arguments.command == "store":
            if arguments.store_command == "put":
                sys.stdout.write(
                    store_put(
                        arguments.package,
                        arguments.validation,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.store_command == "fetch":
                sys.stdout.write(
                    store_fetch(arguments.record, arguments.objects_root) + "\n"
                )
            elif arguments.store_command == "verify":
                print_json(store_verify(arguments.record, arguments.objects_root))
            elif arguments.store_command == "import-flow-neutral":
                sys.stdout.write(
                    import_flow_neutral(
                        arguments.source_record,
                        arguments.alpha_stage_record,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.store_command == "hold":
                sys.stdout.write(
                    create_release_hold(
                        arguments.record,
                        arguments.release_flow,
                        arguments.reason,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.store_command == "verify-hold":
                print_json(verify_release_hold(arguments.hold, arguments.objects_root))
            elif arguments.store_command == "fetch-artifact":
                output = ROOT / arguments.output
                write_canonical_atomic(
                    output,
                    load_canonical_bytes(
                        stored_artifact_bytes(
                            arguments.record,
                            arguments.relative_path,
                            arguments.objects_root,
                        )
                    ),
                )
                sys.stdout.write(relative_path(output) + "\n")
            elif arguments.store_command == "fetch-subtree":
                sys.stdout.write(
                    store_fetch_subtree(
                        arguments.record,
                        arguments.artifact_id,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.store_command == "checkpoint-working-ledger":
                print_json(
                    checkpoint_wal(
                        arguments.release_flow,
                        arguments.wal,
                        arguments.expected_previous_revision,
                        arguments.objects_root,
                    )
                )
            elif arguments.store_command == "fetch-working-ledger":
                print_json(
                    fetch_wal(
                        arguments.release_flow,
                        arguments.ledger_id,
                        arguments.objects_root,
                    )
                )
            else:
                print_json(
                    seal_wal(
                        arguments.release_flow,
                        arguments.ledger_id,
                        arguments.expected_revision,
                        arguments.expected_wal_hash,
                        arguments.objects_root,
                    )
                )
        elif arguments.command == "release":
            if arguments.release_command == "create-flow":
                sys.stdout.write(
                    create_release_flow(
                        arguments.candidate_input,
                        arguments.reviewed_legal_record,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.release_command == "verify-reviewed-development-input":
                print_json(
                    verify_reviewed_record(
                        arguments.candidate_input,
                        arguments.reviewed_legal_record,
                        arguments.objects_root,
                    )
                )
            elif arguments.release_command == "build-profile":
                sys.stdout.write(
                    build_release_profile(
                        arguments.stage,
                        arguments.release_flow,
                        arguments.candidate_input,
                        arguments.candidate_record,
                        arguments.reviewed_legal_record,
                        arguments.negative_removal_plan,
                        arguments.threshold_freeze_record,
                        arguments.threshold_freeze_hold,
                        arguments.lineage_stage_record,
                        arguments.broad_os_coverage_set,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.release_command == "build-broad-os-coverage":
                sys.stdout.write(
                    build_broad_os_coverage(
                        arguments.candidate_record,
                        arguments.negative_removal_plan,
                        arguments.exact_evidence_store_record,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.release_command == "aggregate":
                sys.stdout.write(
                    aggregate_release_stage(
                        arguments.profile,
                        arguments.selection,
                        arguments.selection_hash,
                        arguments.provisional,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.release_command == "validate-manifest":
                print_json(
                    validate_release_package(
                        arguments.package,
                        arguments.mode,
                        arguments.output,
                    )
                )
            elif arguments.release_command == "hold-selected":
                sys.stdout.write(
                    hold_selected_lineage(
                        arguments.stage_record, arguments.objects_root
                    )
                    + "\n"
                )
            elif arguments.release_command == "finalize":
                sys.stdout.write(
                    finalize_formal_release(
                        arguments.provisional_stage_record,
                        arguments.hold_set,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.release_command == "hold-stage-manifest":
                record, package = store_resolve(
                    arguments.stage_record, arguments.objects_root
                )
                manifest = load_canonical(
                    package / "release-evidence-manifest.v1.json"
                )
                require(
                    record.get("packageKind") == "releaseStageManifest"
                    and manifest.get("releaseStage") == "formalRelease"
                    and manifest.get("manifestState") == "immutableStageResult"
                    and manifest.get("stageOutcome") == "passed",
                    "passing final stage required",
                )
                sys.stdout.write(
                    create_release_hold_for_flow(
                        arguments.stage_record,
                        {
                            "evidenceStoreBindingID": manifest[
                                "evidenceStoreBindingID"
                            ],
                            "releaseFlowID": manifest["releaseFlowID"],
                        },
                        "selectedForRelease",
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.release_command == "preflight-negative-removal":
                sys.stdout.write(
                    preflight_negative_removal(
                        arguments.alpha_stage_record,
                        arguments.supersedes_plan_record,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.release_command == "finalize-negative-removal":
                sys.stdout.write(
                    finalize_negative_removal(
                        arguments.write_grant,
                        arguments.alpha_stage_record,
                        arguments.m0_gate_report,
                        arguments.m2_gate_report,
                        arguments.supersedes_plan_record,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            elif arguments.release_command == "publish-final":
                sys.stdout.write(
                    publish_final_release(
                        arguments.stage_record,
                        arguments.stage_hold,
                        arguments.objects_root,
                    )
                    + "\n"
                )
            else:
                report, status = evaluate_stage_record(
                    arguments.stage_record,
                    "formalProvisional"
                    if arguments.release_command == "evaluate-provisional"
                    else "stageResult",
                    arguments.output,
                    arguments.objects_root,
                )
                print_json(report)
                return status
        return 0
    except (ContractError, CanonicalJSONError, KeyError, TypeError, ValueError) as error:
        print(f"evidence-tool: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
