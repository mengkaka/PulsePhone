class ContractError(ValueError):
    pass


def canonical_bytes(value: Mapping[str, Any]) -> bytes:
    return encode_document(value)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def domain_hash(domain: str, value: Mapping[str, Any]) -> str:
    return sha256_bytes(domain.encode("ascii") + b"\0" + canonical_bytes(value))


def release_candidate_input_hash(value: Mapping[str, Any]) -> str:
    return domain_hash(CANDIDATE_INPUT_DOMAIN, value)


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ContractError(message)


def relative_path(path: Path) -> str:
    try:
        return path.relative_to(ROOT).as_posix()
    except ValueError as error:
        raise ContractError(f"path escapes repository: {path}") from error


def validate_relative_path(value: str, *, directory: bool = False) -> None:
    require(isinstance(value, str), "relative path must be string")
    encoded = value.encode("utf-8")
    require(0 < len(encoded) <= 1024, f"relative path byte cap: {value!r}")
    require(not value.startswith("/"), f"absolute path forbidden: {value}")
    require("\\" not in value, f"backslash forbidden: {value}")
    if directory:
        require(value.endswith("/"), f"directory prefix must end in slash: {value}")
        value = value[:-1]
    else:
        require(not value.endswith("/"), f"file path must not end in slash: {value}")
    parts = value.split("/")
    require(all(part not in ("", ".", "..") for part in parts), f"unsafe path: {value}")


def lstat_regular(path: Path, *, allow_multiple_links: bool = False) -> os.stat_result:
    try:
        metadata = path.lstat()
    except FileNotFoundError as error:
        raise ContractError(f"missing file: {relative_path(path)}") from error
    require(not stat.S_ISLNK(metadata.st_mode), f"symlink forbidden: {relative_path(path)}")
    require(stat.S_ISREG(metadata.st_mode), f"regular file required: {relative_path(path)}")
    if not allow_multiple_links:
        require(metadata.st_nlink == 1, f"hardlink forbidden: {relative_path(path)}")
    return metadata


def load_canonical(path: Path, maximum: int = MAX_DOCUMENT_BYTES) -> Dict[str, Any]:
    lstat_regular(path)
    data = path.read_bytes()
    try:
        document = validate_document(data, maximum)
    except CanonicalJSONError as error:
        raise ContractError(f"noncanonical {relative_path(path)}: {error.kind}") from error
    return dict(document.root)


def load_canonical_bytes(data: bytes, maximum: int = MAX_DOCUMENT_BYTES) -> Dict[str, Any]:
    try:
        document = validate_document(data, maximum)
    except CanonicalJSONError as error:
        raise ContractError(f"noncanonical artifact bytes: {error.kind}") from error
    return dict(document.root)


def write_canonical_atomic(path: Path, value: Mapping[str, Any], mode: int = 0o600) -> None:
    data = canonical_bytes(value)
    require(len(data) <= MAX_DOCUMENT_BYTES, "canonical output exceeds byte cap")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_fd, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=str(path.parent)
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(temporary_fd, mode)
        with os.fdopen(temporary_fd, "wb", closefd=True) as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary.exists():
            temporary.unlink()


def artifact_set(
    set_id: str, revision: str, paths: Sequence[str]
) -> Dict[str, Any]:
    entries = []
    seen = set()
    for item in sorted(paths, key=lambda value: value.encode("ascii")):
        validate_relative_path(item)
        require(item not in seen, f"duplicate artifact member: {item}")
        seen.add(item)
        path = ROOT / item
        data = path.read_bytes() if lstat_regular(path) else b""
        load_canonical(path)
        entries.append({"relativePath": item, "sha256": sha256_bytes(data)})
    return {
        "entries": entries,
        "revision": revision,
        "schemaVersion": 1,
        "setID": set_id,
    }


def evidence_policy_paths() -> List[str]:
    requirement_paths = sorted(
        relative_path(path)
        for path in (ROOT / "Verification/release-requirements").glob("T-*/**/*.json")
    )
    schema_paths = [
        f"Schemas/evidence/{name}" for name in sorted(EVIDENCE_SCHEMA_IDS)
    ]
    return [POLICY_ROOT, SUITES_ROOT, *requirement_paths, *schema_paths]


def policy_identity() -> Dict[str, Any]:
    policy = load_canonical(ROOT / POLICY_ROOT)
    policy_id = policy.get("policyID")
    require(isinstance(policy_id, str), "policyID missing")
    projection = artifact_set("evidencePolicy", policy_id, evidence_policy_paths())
    return {
        "artifactSet": projection,
        "hash": domain_hash(POLICY_DOMAIN, projection),
        "policyID": policy_id,
        "schemaVersion": 1,
    }


def gate_identity() -> Dict[str, Any]:
    definition = load_canonical(ROOT / GATES_ROOT)
    revision = definition.get("revision")
    require(isinstance(revision, str), "gate revision missing")
    paths = [
        GATES_ROOT,
        *[
            f"Schemas/implementation/{name}"
            for name in sorted(IMPLEMENTATION_SCHEMA_IDS)
        ],
    ]
    projection = artifact_set("implementationGateContract", revision, paths)
    return {
        "artifactSet": projection,
        "hash": domain_hash(GATE_DOMAIN, projection),
        "revision": revision,
        "schemaVersion": 1,
    }


def assert_sorted_unique(
    values: Sequence[Any], key, label: str
) -> None:
    keys = [key(value) for value in values]
    require(len(keys) == len(set(keys)), f"duplicate {label}")
    require(keys == sorted(keys, key=lambda value: value.encode("ascii")), f"unsorted {label}")


def validate_schema_directory(
    directory: str, expected: Mapping[str, str]
) -> None:
    root = ROOT / directory
    actual = sorted(path.name for path in root.glob("*.json"))
    require(actual == sorted(expected), f"unexpected schema path set in {directory}")
    for name, schema_id in expected.items():
        schema = load_canonical(root / name)
        require(schema.get("$schema") == "https://json-schema.org/draft/2020-12/schema", f"schema draft: {name}")
        require(schema.get("$id") == schema_id, f"schema ID: {name}")
        require(schema.get("type") == "object", f"schema root type: {name}")
        require(schema.get("additionalProperties") is False, f"open schema: {name}")
        require(schema.get("x-pulsephone-maxEncodedBytes") in (MAX_DOCUMENT_BYTES, MAX_BUNDLE_MANIFEST_BYTES), f"schema byte cap: {name}")


def task_graph() -> Tuple[Dict[str, str], Dict[str, List[str]]]:
    lifecycle = load_canonical(ROOT / IMPLEMENTATION_LIFECYCLE_ROOT)
    require(lifecycle.get("schemaVersion") == 1, "implementation lifecycle schema version")
    statuses = lifecycle.get("statuses")
    dependencies = lifecycle.get("dependencies")
    require(isinstance(statuses, dict), "implementation lifecycle statuses")
    require(isinstance(dependencies, dict), "implementation lifecycle dependencies")
    task_id_pattern = re.compile(r"^(?:PRE|M[0-3])-\d{3}[A-Z]?$")
    allowed_statuses = {"done", "in_progress", "pending", "blocked"}
    require(set(statuses) == set(dependencies), "implementation lifecycle task coverage")
    for task_id, status in statuses.items():
        require(isinstance(task_id, str) and task_id_pattern.fullmatch(task_id), "implementation lifecycle task ID")
        require(status in allowed_statuses, f"implementation lifecycle status: {task_id}")
        task_dependencies = dependencies[task_id]
        require(isinstance(task_dependencies, list), f"implementation lifecycle dependencies: {task_id}")
        require(
            all(isinstance(item, str) and item in statuses for item in task_dependencies),
            f"implementation lifecycle dependency reference: {task_id}",
        )
        require(len(task_dependencies) == len(set(task_dependencies)), f"duplicate implementation dependency: {task_id}")
    require("M0-011" in statuses, "implementation lifecycle missing M0-011")
    return statuses, dependencies


def is_ancestor(task_id: str, target_id: str, dependencies: Mapping[str, Sequence[str]]) -> bool:
    if task_id == target_id:
        return True
    pending = list(dependencies.get(target_id, ()))
    visited = set()
    while pending:
        current = pending.pop()
        if current == task_id:
            return True
        if current in visited:
            continue
        visited.add(current)
        pending.extend(dependencies.get(current, ()))
    return False


def load_requirements() -> Dict[str, Dict[str, Any]]:
    requirements: Dict[str, Dict[str, Any]] = {}
    paths = sorted((ROOT / "Verification/release-requirements").glob("T-*/*.json"))
    require(len(paths) == 147, f"requirement count: {len(paths)}")
    expected_keys = {
        "caseClass",
        "contractRefs",
        "evidenceRolePolicyID",
        "executionSuiteID",
        "failurePolicyID",
        "fixtureCaseKey",
        "fixtureExecutionProfileID",
        "fixtureMode",
        "level",
        "requirementID",
        "schemaVersion",
        "stageBindingPresetID",
        "subjectSetID",
        "title",
        "verificationID",
    }
    for path in paths:
        value = load_canonical(path)
        requirement_id = value.get("requirementID")
        require(isinstance(requirement_id, str), f"requirement ID: {relative_path(path)}")
        require(re.fullmatch(r"T-\d{3}/[a-z0-9]+(?:-[a-z0-9]+)*-l[0-5]", requirement_id) is not None, f"requirement format: {requirement_id}")
        require(requirement_id not in requirements, f"duplicate requirement: {requirement_id}")
        family, slug = requirement_id.split("/", 1)
        require(relative_path(path) == f"Verification/release-requirements/{family}/{slug}.v1.json", f"requirement path: {requirement_id}")
        require(value.get("schemaVersion") == 1, f"requirement schema version: {requirement_id}")
        require(value.get("verificationID") == family, f"verification mismatch: {requirement_id}")
        require(value.get("level") == "L" + requirement_id.rsplit("-l", 1)[1], f"level mismatch: {requirement_id}")
        mode = value.get("fixtureMode")
        keys = set(value)
        require(keys <= expected_keys, f"unknown requirement keys: {requirement_id}")
        mandatory = expected_keys - {"fixtureCaseKey", "fixtureExecutionProfileID"}
        require(mandatory <= keys, f"missing requirement keys: {requirement_id}")
        if mode in ("required", "optional"):
            require(value.get("fixtureCaseKey") == requirement_id, f"fixture case key: {requirement_id}")
            require(value.get("fixtureExecutionProfileID") in ("syntheticContract", "isolatedHost", "processHarness"), f"fixture profile: {requirement_id}")
        else:
            require(mode == "none", f"fixture mode: {requirement_id}")
            require("fixtureCaseKey" not in value and "fixtureExecutionProfileID" not in value, f"fixture fields for none: {requirement_id}")
        requirements[requirement_id] = value
    return requirements


def validate_fixture(requirement: Mapping[str, Any], fixture_root: Path) -> None:
    metadata = fixture_root.lstat()
    require(stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode), f"fixture root type: {relative_path(fixture_root)}")
    require(metadata.st_nlink >= 2, "fixture root metadata")
    case_path = fixture_root / "case.v1.json"
    expected_path = fixture_root / "expected.v1.json"
    case = load_canonical(case_path)
    load_canonical(expected_path)
    requirement_id = requirement["requirementID"]
    require(case.get("caseKey") == requirement_id, f"fixture case key: {requirement_id}")
    require(case.get("level") == requirement["level"], f"fixture level: {requirement_id}")
    require(case.get("caseClass") == requirement["caseClass"], f"fixture class: {requirement_id}")
    require(case.get("fixtureExecutionProfileID") == requirement["fixtureExecutionProfileID"], f"fixture profile: {requirement_id}")
    require(case.get("expectedRef") == "expected.v1.json", f"fixture expected path: {requirement_id}")
    input_refs = case.get("inputRefs")
    require(isinstance(input_refs, list), f"fixture input refs: {requirement_id}")
    assert_sorted_unique(input_refs, lambda item: item["relativePath"], f"fixture input refs {requirement_id}")
    referenced = set()
    for input_ref in input_refs:
        input_relative = input_ref.get("relativePath")
        require(isinstance(input_relative, str), f"fixture input path: {requirement_id}")
        validate_relative_path(input_relative)
        require(input_relative.startswith(("input/", "scripts/")), f"fixture input root: {requirement_id}")
        path = fixture_root / input_relative
        data = path.read_bytes() if lstat_regular(path) else b""
        require(input_ref.get("sha256") == sha256_bytes(data), f"fixture input hash: {requirement_id}")
        referenced.add(input_relative)
    actual = set()
    for directory in [fixture_root / "input", fixture_root / "scripts"]:
        if not directory.exists():
            continue
        for path in directory.rglob("*"):
            if path.is_dir():
                continue
            lstat_regular(path)
            actual.add(path.relative_to(fixture_root).as_posix())
    require(actual == referenced, f"fixture input coverage: {requirement_id}")


def validate_adapter(requirement: Mapping[str, Any], route: Mapping[str, Any]) -> None:
    path = ROOT / route["runnerAdapterRelativePath"]
    adapter = load_canonical(path)
    requirement_id = requirement["requirementID"]
    require(adapter.get("schemaVersion") == 1, f"adapter schema: {requirement_id}")
    require(adapter.get("requirementID") == requirement_id, f"adapter requirement: {requirement_id}")
    require(adapter.get("executionSuiteID") == requirement["executionSuiteID"], f"adapter suite: {requirement_id}")
    kind = adapter.get("adapterKind")
    invocation = adapter.get("invocation")
    require(kind in ("goTest", "swiftTest", "pythonTest", "evidenceCommand", "releaseStageOperation"), f"adapter kind: {requirement_id}")
    require(isinstance(invocation, dict) and set(invocation) == {kind}, f"adapter invocation branch: {requirement_id}")
    oracle_kind = adapter.get("oracleKind")
    oracle = adapter.get("oracle")
    branches = {
        "fixtureExpected": "fixtureExpected",
        "testAssertion": "testAssertion",
        "evidencePredicate": "evidencePredicate",
        "releaseStagePredicate": "releaseStagePredicate",
    }
    require(oracle_kind in branches, f"adapter oracle kind: {requirement_id}")
    require(isinstance(oracle, dict) and set(oracle) == {branches[oracle_kind]}, f"adapter oracle branch: {requirement_id}")
    if oracle_kind == "fixtureExpected":
        expected_path = route.get("fixtureRelativePath")
        require(oracle["fixtureExpected"].get("fixtureRelativePath") == expected_path, f"adapter fixture path: {requirement_id}")
    inputs = adapter.get("inputArtifacts", [])
    require(isinstance(inputs, list), f"adapter input artifacts: {requirement_id}")
    assert_sorted_unique(inputs, lambda item: item["role"], f"adapter input roles {requirement_id}")
    if kind == "releaseStageOperation":
        require(
            invocation["releaseStageOperation"].get("operationID")
            == STAGE_OPERATION_ID,
            f"stage operation ID: {requirement_id}",
        )
        require(
            {item["role"]: item["cardinality"] for item in inputs}
            == {
                "developmentCandidateInput": "zeroOrOne",
                "performanceMeasurementProfile": "exactlyOne",
                "performanceMetrics": "exactlyOne",
                "performanceThresholdProfile": "zeroOrOne",
            },
            f"stage operation input contract: {requirement_id}",
        )


def verify_policy_structural() -> Dict[str, Any]:
    validate_schema_directory("Schemas/evidence", EVIDENCE_SCHEMA_IDS)
    policy = load_canonical(ROOT / POLICY_ROOT)
    require(policy.get("schemaVersion") == 1, "policy schema version")
    require(policy.get("implementationEnvironmentProfileID") == "env.implementation.clean-source", "implementation environment profile")
    require(policy.get("maximumScenarioCountPerSuite") == 4096, "suite scenario cap")
    expected_counts = {
        "applicabilityRules": 2,
        "environmentProfiles": 17,
        "evidenceRolePolicies": 3,
        "failurePolicies": 5,
        "scopeBindingPresets": 6,
        "stageBindingPresets": 29,
        "stageRules": 3,
        "subjectSets": 25,
    }
    id_keys = {
        "applicabilityRules": "applicabilityRuleID",
        "environmentProfiles": "profileID",
        "evidenceRolePolicies": "evidenceRolePolicyID",
        "failurePolicies": "failurePolicyID",
        "scopeBindingPresets": "scopeBindingID",
        "stageBindingPresets": "stageBindingPresetID",
        "stageRules": "releaseStage",
        "subjectSets": "subjectSetID",
    }
    for key, expected_count in expected_counts.items():
        values = policy.get(key)
        require(isinstance(values, list) and len(values) == expected_count, f"policy count {key}")
        assert_sorted_unique(values, lambda item, field=id_keys[key]: item[field], key)
    facets = policy.get("environmentFacets")
    require(isinstance(facets, list) and len(facets) == 20, "environment facet count")
    assert_sorted_unique(facets, lambda item: item["facetID"], "environment facets")
    facet_by_id = {item["facetID"]: item for item in facets}
    environments = {item["profileID"]: item for item in policy["environmentProfiles"]}
    for profile_id, profile in environments.items():
        facet_ids = profile.get("facetIDs")
        require(isinstance(facet_ids, list), f"environment facets: {profile_id}")
        require(facet_ids == sorted(set(facet_ids)), f"environment facet order: {profile_id}")
        dimensions = []
        for facet_id in facet_ids:
            require(facet_id in facet_by_id, f"unknown facet {facet_id}")
            dimensions.append(facet_by_id[facet_id]["dimension"])
        require(len(dimensions) == len(set(dimensions)), f"environment dimension conflict: {profile_id}")
    scope_ids = {item["scopeBindingID"] for item in policy["scopeBindingPresets"]}
    stage_presets = {item["stageBindingPresetID"]: item for item in policy["stageBindingPresets"]}
    all_bindings = []
    used_environments = {policy["implementationEnvironmentProfileID"]}
    used_scopes = set()
    for preset_id, preset in stage_presets.items():
        bindings = preset.get("bindings")
        require(isinstance(bindings, list) and bindings, f"empty stage preset: {preset_id}")
        assert_sorted_unique(bindings, lambda item: item["bindingID"], f"bindings {preset_id}")
        tuples = set()
        for binding in bindings:
            environment = binding.get("environmentProfileID")
            scope = binding.get("scopeBindingID")
            stage = binding.get("releaseStage")
            require(environment in environments, f"unknown environment: {preset_id}")
            require(scope in scope_ids, f"unknown scope: {preset_id}")
            require(stage in ("internalAlpha", "externalBeta", "formalRelease"), f"stage: {preset_id}")
            expected_id = f"{stage}.{environment}.{scope}"
            require(binding.get("bindingID") == expected_id, f"binding ID: {preset_id}")
            item_tuple = (stage, environment, scope)
            require(item_tuple not in tuples, f"duplicate binding tuple: {preset_id}")
            tuples.add(item_tuple)
            all_bindings.append(binding["bindingID"])
            used_environments.add(environment)
            used_scopes.add(scope)
    require(used_environments == set(environments), "unused environment profile")
    require(used_scopes == scope_ids, "unused scope preset")
    subjects = {item["subjectSetID"]: item for item in policy["subjectSets"]}
    applicability = {item["applicabilityRuleID"] for item in policy["applicabilityRules"]}
    for subject_id, value in subjects.items():
        rule = value.get("applicabilityRuleID")
        if rule is not None:
            require(rule in applicability, f"unknown applicability rule: {subject_id}")
        for key in ["productActionIDs", "nonCommandFeatureIDs", "preparationGroupIDs", "routes"]:
            values = value.get(key)
            require(isinstance(values, list) and values == sorted(set(values)), f"subject ordering: {subject_id}/{key}")
        mode = value.get("selectionMode")
        total = sum(len(value[key]) for key in ["productActionIDs", "nonCommandFeatureIDs", "preparationGroupIDs", "routes"])
        if mode in ("none", "allMatched"):
            require(total == 0, f"nonempty implicit subject: {subject_id}")
        else:
            require(mode == "explicit" and total > 0, f"invalid explicit subject: {subject_id}")
    requirements = load_requirements()
    suites_root = load_canonical(ROOT / SUITES_ROOT)
    require(suites_root.get("policyID") == policy.get("policyID"), "suite policy identity")
    suites = suites_root.get("suites")
    require(isinstance(suites, list) and len(suites) == 21, "suite count")
    assert_sorted_unique(suites, lambda item: item["executionSuiteID"], "execution suites")
    suite_by_id = {item["executionSuiteID"]: item for item in suites}
    failure_ids = {item["failurePolicyID"] for item in policy["failurePolicies"]}
    role_ids = {item["evidenceRolePolicyID"] for item in policy["evidenceRolePolicies"]}
    member_counts = {suite_id: 0 for suite_id in suite_by_id}
    used_subjects = set()
    used_presets = set()
    for requirement_id, requirement in requirements.items():
        suite_id = requirement["executionSuiteID"]
        require(suite_id in suite_by_id, f"unknown suite: {requirement_id}")
        require(suite_by_id[suite_id].get("primaryVerificationID") == requirement["verificationID"], f"suite verification: {requirement_id}")
        require(suite_by_id[suite_id].get("runnerID") == "evidence-tool.member-dispatch.v1", f"suite runner: {suite_id}")
        member_counts[suite_id] += 1
        require(requirement["stageBindingPresetID"] in stage_presets, f"unknown stage preset: {requirement_id}")
        require(requirement["subjectSetID"] in subjects, f"unknown subject: {requirement_id}")
        require(requirement["failurePolicyID"] in failure_ids, f"unknown failure policy: {requirement_id}")
        require(requirement["evidenceRolePolicyID"] in role_ids, f"unknown role policy: {requirement_id}")
        used_subjects.add(requirement["subjectSetID"])
        used_presets.add(requirement["stageBindingPresetID"])
        expanded = len(stage_presets[requirement["stageBindingPresetID"]]["bindings"])
        require(expanded <= policy["maximumScenarioCountPerSuite"], f"scenario cap: {requirement_id}")
    require(all(count > 0 for count in member_counts.values()), "unreferenced suite")
    require(used_subjects == set(subjects), "unused subject")
    require(used_presets == set(stage_presets), "unused stage preset")
    multiplicity = policy.get("currentCandidateMultiplicity")
    require(isinstance(multiplicity, dict), "multiplicity root")
    require(multiplicity.get("defaultRequiredDistinctPassingScenarioCount") == 1, "multiplicity default")
    cohorts = multiplicity.get("cohorts")
    require(isinstance(cohorts, list) and len(cohorts) == 1, "cohort count")
    cohort = cohorts[0]
    require(cohort.get("cohortID") == "formal.stability-performance.v1", "cohort ID")
    require(cohort.get("requirementIDs") == ["T-018/performance-threshold-evaluation-l5", "T-018/stability-stage-run-l5"], "cohort members")
    require(cohort.get("requiredDistinctPassingScenarioCount") == 3, "cohort count")
    require(cohort.get("requiredStageRunOrdinals") == [1, 2, 3], "cohort ordinals")
    owners = load_canonical(ROOT / OWNERS_ROOT)
    require(owners.get("evidencePolicyID") == policy.get("policyID"), "owner policy ID")
    routes = owners.get("routes")
    require(isinstance(routes, list) and len(routes) == 147, "owner route count")
    assert_sorted_unique(routes, lambda item: item["requirementID"], "owner routes")
    route_by_id = {route["requirementID"]: route for route in routes}
    require(set(route_by_id) == set(requirements), "owner route coverage")
    statuses, dependencies = task_graph()
    stage_tasks = {
        "internalAlpha": "M3-013",
        "externalBeta": "M3-015",
        "formalRelease": "M3-016",
    }
    for requirement_id, requirement in requirements.items():
        route = route_by_id[requirement_id]
        expected_adapter = f"Verification/runner-adapters/{requirement_id}.v1.json"
        require(route.get("runnerAdapterRelativePath") == expected_adapter, f"runner path: {requirement_id}")
        runner_owner = route.get("runnerOwnerTaskID")
        require(runner_owner in statuses, f"unknown runner owner: {requirement_id}")
        preset = stage_presets[requirement["stageBindingPresetID"]]
        stages = {binding["releaseStage"] for binding in preset["bindings"]}
        for stage in stages:
            require(is_ancestor(runner_owner, stage_tasks[stage], dependencies), f"runner owner ancestry: {requirement_id}/{stage}")
        mode = requirement["fixtureMode"]
        if mode == "none":
            require("fixtureOwnerTaskID" not in route and "fixtureRelativePath" not in route, f"fixture route for none: {requirement_id}")
        else:
            expected_fixture = f"Fixtures/requirements/{requirement_id}/"
            require(route.get("fixtureRelativePath") == expected_fixture, f"fixture path: {requirement_id}")
            fixture_owner = route.get("fixtureOwnerTaskID")
            require(fixture_owner in statuses, f"unknown fixture owner: {requirement_id}")
            if fixture_owner == "M0-011" or statuses[fixture_owner] == "done":
                validate_fixture(requirement, ROOT / expected_fixture)
        if runner_owner == "M0-011" or statuses[runner_owner] == "done":
            validate_adapter(requirement, route)
    identity = policy_identity()
    expected_identity = load_canonical(
        ROOT / "Fixtures/evidence/policy/evidence-policy-identity.v1.json"
    )
    require(identity == expected_identity, "evidence policy artifact-set identity")
    return {
        "evidencePolicyHash": identity["hash"],
        "policyID": identity["policyID"],
        "requirements": len(requirements),
        "routes": len(routes),
        "suites": len(suites),
    }


EXPECTED_GATE_ROWS = {
    "M0-900": (
        "verify-m0-gate",
        "M0-900",
        "build/gates/m0-contract-foundation.json",
    ),
    "M1-900": (
        "verify-m1-gate",
        "M1-900",
        "build/gates/m1-runtime-foundation.json",
    ),
    "M2-900": (
        "verify-m2-gate",
        "M2-900",
        "build/gates/m2-product-integration.json",
    ),
    "M3-010A": (
        "verify-negative-removal",
        "M3-010A",
        "build/gates/m3-negative-removal.json",
    ),
    "M3-014": (
        "verify-threshold-freeze",
        "M3-014",
        "build/gates/m3-threshold-freeze.json",
    ),
    "M3-900": (
        "verify-m3-release-gate",
        "M3-900",
        "build/gates/m3-release-evidence.json",
    ),
}


def cardinality_bounds(cardinality: str) -> Tuple[int, int]:
    return {
        "exactlyOne": (1, 1),
        "zeroOrOne": (0, 1),
        "oneOrMore": (1, 65536),
        "zeroOrMore": (0, 65536),
    }[cardinality]


def rules_overlap(left: Mapping[str, str], right: Mapping[str, str]) -> bool:
    left_kind, left_path = left["kind"], left["path"]
    right_kind, right_path = right["kind"], right["path"]
    if left_kind == right_kind == "exactFile":
        return left_path == right_path
    if left_kind == "directoryPrefix" and right_kind == "directoryPrefix":
        return left_path.startswith(right_path) or right_path.startswith(left_path)
    prefix = left if left_kind == "directoryPrefix" else right
    exact = right if left_kind == "directoryPrefix" else left
    return exact["path"].startswith(prefix["path"])


def validate_gate_contract() -> Dict[str, Any]:
    validate_schema_directory("Schemas/implementation", IMPLEMENTATION_SCHEMA_IDS)
    definition = load_canonical(ROOT / GATES_ROOT)
    require(definition.get("schemaVersion") == 1, "gate definition schema version")
    gates = definition.get("gates")
    require(isinstance(gates, list) and len(gates) == 6, "gate definition count")
    assert_sorted_unique(gates, lambda item: item["gateID"], "implementation gates")
    require({gate["gateID"] for gate in gates} == set(EXPECTED_GATE_ROWS), "gate ID set")
    for gate in gates:
        gate_id = gate["gateID"]
        make_target, owner, output = EXPECTED_GATE_ROWS[gate_id]
        require(gate.get("makeTarget") == make_target, f"gate target: {gate_id}")
        require(gate.get("ownerTaskID") == owner, f"gate owner: {gate_id}")
        require(gate.get("outputRelativePath") == output, f"gate output: {gate_id}")
        validate_relative_path(output)
        identities = gate.get("baseRequiredIdentityFields")
        slots = gate.get("baseInputSlots")
        checks = gate.get("baseChecks")
        policies = gate.get("sourcePolicies")
        require(isinstance(identities, list) and identities == sorted(set(identities)), f"base identities: {gate_id}")
        require(isinstance(slots, list), f"base input slots: {gate_id}")
        require(isinstance(checks, list) and checks, f"base checks: {gate_id}")
        require(isinstance(policies, list) and 1 <= len(policies) <= 2, f"source policies: {gate_id}")
        assert_sorted_unique(slots, lambda item: item["inputRole"], f"base slots {gate_id}")
        assert_sorted_unique(checks, lambda item: item["checkID"], f"base checks {gate_id}")
        assert_sorted_unique(policies, lambda item: item["sourcePolicyID"], f"source policies {gate_id}")
        require(len(identities) <= 8, f"identity cap: {gate_id}")
        require(len(slots) <= 32, f"input slot cap: {gate_id}")
        require(len(checks) <= 256, f"check cap: {gate_id}")
        base_roles = {slot["inputRole"] for slot in slots}
        base_checks = {item["checkID"] for item in checks}
        base_identity = set(identities)
        for slot in slots:
            require(slot.get("cardinality") in ("exactlyOne", "zeroOrOne", "oneOrMore", "zeroOrMore"), f"slot cardinality: {gate_id}")
            minimum, maximum = cardinality_bounds(slot["cardinality"])
            require(0 <= minimum <= maximum <= 65536, f"slot bounds: {gate_id}")
            locator = slot.get("locator")
            require(isinstance(locator, dict) and set(locator) == {"kind", "value"}, f"slot locator: {gate_id}")
            require(locator["kind"] in ("commandLineMakeVariable", "fixedRelativePath"), f"locator kind: {gate_id}")
            if locator["kind"] == "fixedRelativePath":
                validate_relative_path(locator["value"])
            else:
                require(re.fullmatch(r"GATE_[A-Z0-9_]+", locator["value"]) is not None, f"make variable: {gate_id}")
        for policy in policies:
            policy_id = policy["sourcePolicyID"]
            require(policy.get("mode") in ("clean", "taskOwnedSnapshot"), f"source mode: {gate_id}/{policy_id}")
            authority = policy.get("pathAuthority")
            require(authority in ("none", "definitionAllowlist", "negativeRemovalWriteGrant"), f"path authority: {gate_id}/{policy_id}")
            extra_ids = policy.get("additionalRequiredIdentityFields")
            extra_slots = policy.get("additionalInputSlots")
            extra_checks = policy.get("additionalChecks")
            require(isinstance(extra_ids, list) and extra_ids == sorted(set(extra_ids)), f"extra identity: {gate_id}/{policy_id}")
            require(isinstance(extra_slots, list), f"extra slots: {gate_id}/{policy_id}")
            require(isinstance(extra_checks, list), f"extra checks: {gate_id}/{policy_id}")
            assert_sorted_unique(extra_slots, lambda item: item["inputRole"], f"extra slots {gate_id}/{policy_id}")
            assert_sorted_unique(extra_checks, lambda item: item["checkID"], f"extra checks {gate_id}/{policy_id}")
            require(not (base_identity & set(extra_ids)), f"identity override: {gate_id}/{policy_id}")
            require(not (base_roles & {item['inputRole'] for item in extra_slots}), f"slot override: {gate_id}/{policy_id}")
            require(not (base_checks & {item['checkID'] for item in extra_checks}), f"check override: {gate_id}/{policy_id}")
            require(len(base_identity) + len(extra_ids) <= 8, f"effective identity cap: {gate_id}/{policy_id}")
            require(len(base_roles) + len(extra_slots) <= 32, f"effective slot cap: {gate_id}/{policy_id}")
            require(len(base_checks) + len(extra_checks) <= 256, f"effective check cap: {gate_id}/{policy_id}")
            rules = policy.get("allowedPathRules", [])
            require(isinstance(rules, list) and len(rules) <= 256, f"path rule cap: {gate_id}/{policy_id}")
            assert_sorted_unique(rules, lambda item: f"{item['kind']}:{item['path']}", f"path rules {gate_id}/{policy_id}")
            for index, rule in enumerate(rules):
                require(rule.get("kind") in ("directoryPrefix", "exactFile"), f"path rule kind: {gate_id}/{policy_id}")
                validate_relative_path(rule["path"], directory=rule["kind"] == "directoryPrefix")
                for other in rules[index + 1 :]:
                    require(not rules_overlap(rule, other), f"overlapping path rules: {gate_id}/{policy_id}")
            if authority == "definitionAllowlist":
                require(rules, f"definition allowlist missing: {gate_id}/{policy_id}")
                require("pathAuthorityInputRole" not in policy, f"unexpected path authority input: {gate_id}/{policy_id}")
            elif authority == "negativeRemovalWriteGrant":
                role = policy.get("pathAuthorityInputRole")
                effective_roles = base_roles | {item["inputRole"] for item in extra_slots}
                require(role in effective_roles, f"grant authority input: {gate_id}/{policy_id}")
                require(not rules, f"grant authority has static rules: {gate_id}/{policy_id}")
            else:
                require(not rules and "pathAuthorityInputRole" not in policy, f"none authority fields: {gate_id}/{policy_id}")
    identity = gate_identity()
    expected = load_canonical(
        ROOT / "Fixtures/evidence/gates/implementation-gate-contract-identity.v1.json"
    )
    require(identity == expected, "implementation gate artifact-set identity")
    return {
        "gateCount": len(gates),
        "hash": identity["hash"],
        "revision": identity["revision"],
    }


def verify_hard_caps() -> None:
    fixture = load_canonical(ROOT / "Fixtures/evidence/caps/hard-caps.v1.json")
    require(fixture.get("caps") == HARD_CAPS, "hard cap fixture")
    for name, maximum in HARD_CAPS.items():
        exact_count = name in ("gateDefinitionCount", "releaseStageManifestHolds")
        if exact_count:
            require(maximum - 1 != maximum and maximum == maximum and maximum + 1 != maximum, f"exact cap boundary: {name}")
        else:
            for value, expected in [
                (maximum - 1, True),
                (maximum, True),
                (maximum + 1, False),
            ]:
                require((value <= maximum) is expected, f"cap boundary: {name}/{value}")


def aggregate_registry_set(
    set_id: str, revision: str, paths: Sequence[str], domain: str
) -> str:
    projection = artifact_set(set_id, revision, paths)
    return domain_hash(domain, projection)


def verify_bootstrap_contracts() -> Dict[str, Any]:
    policy_result = verify_policy_structural()
    gate_result = validate_gate_contract()
    verify_hard_caps()
    subprocess.run(
        [str(ROOT / "Scripts/generate-registries"), "swift", "--verify"],
        cwd=ROOT,
        check=True,
    )
    subprocess.run(
        [str(ROOT / "Scripts/generate-registries"), "python", "--verify"],
        cwd=ROOT,
        check=True,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    )
    subprocess.run(
        [str(ROOT / "Scripts/implementation-gate"), "--self-test"],
        cwd=ROOT,
        check=True,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    )
    standard = load_canonical(ROOT / "Registries/standard-errors.v1.json")
    require(standard.get("setID") == "standardErrorRegistry", "standard error set ID")
    errors = standard.get("entries")
    require(isinstance(errors, list) and len(errors) == 87, "standard error count")
    error_codes = {entry["code"] for entry in errors}
    require(len(error_codes) == 87, "standard error uniqueness")
    details_paths = sorted(
        relative_path(path) for path in (ROOT / "Schemas/details-schemas").glob("*.json")
    )
    require(len(details_paths) == 15, "details schema count")
    standard_paths = ["Registries/standard-errors.v1.json", *details_paths]
    standard_hash = aggregate_registry_set(
        "standardErrorRegistry",
        standard["revision"],
        standard_paths,
        "pulsephone.standard-error-registry-set.v1",
    )
    require(standard_hash == "0e9cdbee93d04400aa6dee3edc3e24f3e613d5eba77a3ecf0d825429bfe7dbde", "standard error aggregate hash")
    wire_registry_paths = [
        "Registries/facts-probe-wire.v1.json",
        "Registries/guihost-wire.v1.json",
        "Registries/helper-wire.v1.json",
        "Registries/runtime-operations.v1.json",
        "Registries/runtime-wire-messages.v1.json",
    ]
    wire_schema_paths = sorted(
        relative_path(path) for path in (ROOT / "Schemas/wire").glob("*.json")
    )
    require(len(wire_schema_paths) == 5, "wire schema set count")
    wire_revision = load_canonical(ROOT / wire_registry_paths[0])["revision"]
    wire_hash = aggregate_registry_set(
        "wireRegistry",
        wire_revision,
        [*wire_registry_paths, *wire_schema_paths],
        "pulsephone.wire-registry-set.v1",
    )
    require(wire_hash == "5d2a1822d73224f3afb8e1d9b87613eb2dda3ea7cf69c997f9bcb5ff5e2dfa60", "wire aggregate hash")
    operations = load_canonical(ROOT / "Registries/runtime-operations.v1.json")
    operation_ids = {entry["id"] for entry in operations["entries"]}
    synthetic_command = load_canonical(
        ROOT / "Fixtures/evidence/contracts/bootstrap-command-matrix.v1.json"
    )
    require(synthetic_command.get("allowedCrossSetDependencies") == ["standardErrorRegistry", "wireRegistry"], "bootstrap command dependencies")
    for entry in synthetic_command["entries"]:
        require(entry["operationID"] in operation_ids, f"bootstrap operation ref: {entry['operationID']}")
        require(entry["errorCode"] in error_codes, f"bootstrap error ref: {entry['errorCode']}")
    synthetic_catalog = load_canonical(
        ROOT / "Fixtures/evidence/contracts/bootstrap-developer-image-catalog.v1.json"
    )
    command_ids = {entry["commandID"] for entry in synthetic_command["entries"]}
    require(synthetic_catalog.get("allowedCrossSetDependencies") == ["commandMatrix"], "bootstrap catalog dependencies")
    for entry in synthetic_catalog["entries"]:
        require(entry["commandID"] in command_ids, f"bootstrap command ref: {entry['commandID']}")
    profile = load_canonical(ROOT / "Fixtures/evidence/contracts/bootstrap-profile.v1.json")
    require(
        profile.get("crossSetDependencyGraph")
        == {
            "commandMatrix": ["standardErrorRegistry", "wireRegistry"],
            "developerImageCatalog": ["commandMatrix"],
            "standardErrorRegistry": [],
            "wireRegistry": ["standardErrorRegistry"],
        },
        "bootstrap dependency graph",
    )
    return {
        "gateContractHash": gate_result["hash"],
        "policyHash": policy_result["evidencePolicyHash"],
        "standardErrorRegistryHash": standard_hash,
        "wireRegistryHash": wire_hash,
    }


def owners_query(task_id: str) -> Dict[str, Any]:
    verify_policy_structural()
    statuses, _ = task_graph()
    require(task_id in statuses, f"unknown task ID: {task_id}")
    owner_map = load_canonical(ROOT / OWNERS_ROOT)
    fixture_routes = []
    runner_routes = []
    for route in owner_map["routes"]:
        if route.get("fixtureOwnerTaskID") == task_id:
            fixture_routes.append(
                {
                    "fixtureRelativePath": route["fixtureRelativePath"],
                    "requirementID": route["requirementID"],
                }
            )
        if route["runnerOwnerTaskID"] == task_id:
            runner_routes.append(
                {
                    "requirementID": route["requirementID"],
                    "runnerAdapterRelativePath": route["runnerAdapterRelativePath"],
                }
            )
    return {
        "evidencePolicyID": owner_map["evidencePolicyID"],
        "fixtureRoutes": fixture_routes,
        "runnerRoutes": runner_routes,
        "schemaVersion": 1,
        "taskID": task_id,
    }


def artifact_path_key(domain: str, opaque_id: str) -> str:
    require(domain in ARTIFACT_DOMAINS, f"unknown artifact domain: {domain}")
    require(isinstance(opaque_id, str) and 1 <= len(opaque_id.encode("ascii")) <= 128, "opaque ID byte cap")
    require("/" not in opaque_id and "\\" not in opaque_id, "opaque ID path content")
    require("://" not in opaque_id, "opaque ID URL content")
    value = {"artifactDomain": domain, "opaqueID": opaque_id, "schemaVersion": 1}
    return domain_hash(PATH_KEY_DOMAIN, value)


def verified_objects_root(value: str) -> Path:
    root = Path(value)
    require(not root.is_absolute(), "objects root must be repository-relative")
    normalized = root.as_posix()
    validate_relative_path(normalized, directory=False)
    require(normalized == "build/evidence/objects", "objects root must be build/evidence/objects")
    absolute = ROOT / normalized
    absolute.mkdir(parents=True, exist_ok=True, mode=0o700)
    metadata = absolute.lstat()
    require(stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode), "objects root type")
    return absolute


def validate_opaque_id(value: Any, label: str, maximum: int = 128) -> str:
    require(isinstance(value, str), f"{label} must be string")
    try:
        encoded = value.encode("ascii")
    except UnicodeEncodeError as error:
        raise ContractError(f"{label} must be ASCII") from error
    require(1 <= len(encoded) <= maximum, f"{label} byte cap")
    require(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]*", value) is not None, f"{label} format")
    require("://" not in value and "/" not in value and "\\" not in value, f"{label} path or URL content")
    return value


def typed_object_path(
    objects_root: Path, domain: str, opaque_id: str, filename: str
) -> Path:
    validate_opaque_id(opaque_id, "artifact opaque ID")
    return objects_root / artifact_path_key(domain, opaque_id) / filename


def load_typed_candidate(
    candidate_value: str,
    objects_root_value: str,
    expected_kind: str | None = None,
) -> Tuple[Dict[str, Any], str, Path]:
    objects_root = verified_objects_root(objects_root_value)
    candidate_path = ROOT / candidate_value
    candidate = load_canonical(candidate_path)
    require(candidate.get("schemaVersion") == 1, "candidate input schema version")
    candidate_kind = candidate.get("candidateKind")
    require(candidate_kind in ("developmentAssembly", "signedNotarized"), "candidate kind")
    if expected_kind is not None:
        require(candidate_kind == expected_kind, "candidate kind mismatch")
    require(candidate.get("worktreeState") == "clean", "candidate worktree state")
    candidate_hash = release_candidate_input_hash(candidate)
    domain = (
        "developmentCandidateInput"
        if candidate_kind == "developmentAssembly"
        else "releaseCandidateInput"
    )
    expected_path = typed_object_path(
        objects_root, domain, candidate_hash, "release-candidate-input.v1.json"
    )
    require(candidate_path == expected_path, "candidate typed path")
    return candidate, candidate_hash, candidate_path


def reviewed_candidate_projection(candidate: Mapping[str, Any]) -> Dict[str, Any]:
    projection = dict(candidate)
    projection.pop("sourceCommit", None)
    return projection


def verify_reviewed_continuity(
    reviewed: Mapping[str, Any], fresh: Mapping[str, Any]
) -> None:
    require(reviewed.get("candidateKind") == "developmentAssembly", "reviewed candidate kind")
    require(fresh.get("candidateKind") == "developmentAssembly", "fresh candidate kind")
    require(
        reviewed_candidate_projection(reviewed)
        == reviewed_candidate_projection(fresh),
        "reviewed development input continuity",
    )


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def git_output(arguments: Sequence[str]) -> bytes:
    return subprocess.run(
        ["/usr/bin/git", *arguments],
        cwd=ROOT,
        check=True,
        stdout=subprocess.PIPE,
    ).stdout


def git_head() -> str:
    return git_output(["rev-parse", "HEAD"]).decode("ascii").strip()


def source_snapshot() -> Dict[str, Any]:
    output = git_output(
        ["status", "--porcelain=v1", "-z", "--untracked-files=all"]
    )
    records = output.split(b"\0")
    entries_by_path: Dict[str, Dict[str, Any]] = {}
    index = 0
    while index < len(records):
        record = records[index]
        index += 1
        if not record:
            continue
        require(len(record) >= 4 and record[2:3] == b" ", "git status record")
        xy = record[:2].decode("ascii")
        path_bytes = record[3:]
        if xy[0] in ("R", "C"):
            require(index < len(records) and records[index], "git rename status")
            path_bytes = records[index]
            index += 1
        path_value = path_bytes.decode("utf-8")
        validate_relative_path(path_value)
        path_state = "added" if xy == "??" or "A" in xy else "deleted" if "D" in xy else "modified"
        entry: Dict[str, Any] = {
            "pathState": path_state,
            "relativePath": path_value,
        }
        path = ROOT / path_value
        if path_state != "deleted":
            metadata = path.lstat()
            require(not stat.S_ISLNK(metadata.st_mode), f"snapshot symlink: {path_value}")
            require(stat.S_ISREG(metadata.st_mode), f"snapshot non-file: {path_value}")
            require(metadata.st_nlink == 1, f"snapshot hardlink: {path_value}")
            data = path.read_bytes()
            entry.update(
                {
                    "byteLength": len(data),
                    "gitMode": (
                        "100755" if metadata.st_mode & stat.S_IXUSR else "100644"
                    ),
                    "sha256": sha256_bytes(data),
                }
            )
        entries_by_path[path_value] = entry
    entries = [entries_by_path[key] for key in sorted(entries_by_path)]
    require(len(entries) <= HARD_CAPS["sourceSnapshotEntries"], "source snapshot cap")
    return {
        "entries": entries,
        "gitHeadCommit": git_head(),
        "schemaVersion": 1,
        "worktreeState": "clean" if not entries else "taskOwnedDirty",
    }


def source_snapshot_hash(snapshot: Mapping[str, Any]) -> str:
    return domain_hash(SNAPSHOT_DOMAIN, snapshot)


def implementation_contract_identity() -> Dict[str, Any]:
    standard = load_canonical(ROOT / "Registries/standard-errors.v1.json")
    wire = load_canonical(ROOT / "Registries/runtime-wire-messages.v1.json")
    return {
        "commandMatrix": {"revision": "bootstrap.synthetic.command-matrix.v1"},
        "developerImageCatalog": {"revision": "bootstrap.synthetic.developer-image-catalog.v1"},
        "plannerContractVersion": "planner-contract.v2-20260718",
        "standardErrorRegistry": {
            "revision": standard["revision"],
            "sha256": "0e9cdbee93d04400aa6dee3edc3e24f3e613d5eba77a3ecf0d825429bfe7dbde",
        },
        "wireRegistry": {
            "revision": wire["revision"],
            "sha256": "5d2a1822d73224f3afb8e1d9b87613eb2dda3ea7cf69c997f9bcb5ff5e2dfa60",
        },
    }


def environment_snapshot() -> Dict[str, Any]:
    macos = subprocess.run(
        ["/usr/bin/sw_vers", "-productVersion"],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout.strip()
    build = subprocess.run(
        ["/usr/bin/sw_vers", "-buildVersion"],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout.strip()
    architecture = subprocess.run(
        ["/usr/bin/uname", "-m"],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout.strip()
    return {
        "architecture": architecture,
        "environmentProfileID": "env.implementation.clean-source",
        "macOSBuild": build,
        "macOSVersion": macos,
        "schemaVersion": 1,
    }


def execute_adapter(adapter: Mapping[str, Any]) -> Tuple[str, str]:
    kind = adapter["adapterKind"]
    invocation = adapter["invocation"][kind]
    cwd = ROOT
    if kind == "swiftTest":
        command = [
            "/usr/bin/xcrun",
            "swift",
            "test",
            "--filter",
            invocation["filter"],
        ]
        environment = {
            **os.environ,
            "DEVELOPER_DIR": subprocess.run(
                ["/usr/bin/xcode-select", "-p"],
                check=True,
                stdout=subprocess.PIPE,
                text=True,
            ).stdout.strip(),
        }
    elif kind == "goTest":
        command = [
            "go",
            "test",
            invocation["package"],
            "-run",
            invocation["filter"],
            "-count=1",
        ]
        cwd = ROOT / "GoHelpers"
        environment = {
            **os.environ,
            "CGO_ENABLED": "0",
            "GOENV": "off",
            "GOFLAGS": "-mod=vendor",
            "GOTOOLCHAIN": "local",
            "GOWORK": "off",
        }
    elif kind == "pythonTest":
        command = [
            "/usr/bin/make",
            invocation["makeTarget"],
            f"PYTHON_TEST={invocation['selector']}",
        ]
        environment = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
    else:
        return "unknown", "runner.not-implemented"
    result = subprocess.run(
        command,
        cwd=cwd,
        env=environment,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return ("passed", "runner.passed") if result.returncode == 0 else ("failed", "runner.failed")


def execute_performance_evidence_command(
    adapter: Mapping[str, Any],
    inputs: Mapping[str, Sequence[str]],
    candidate_input: Mapping[str, Any] | None,
    flow: Mapping[str, Any] | None,
    package_root: Path,
) -> Tuple[str, str, Dict[str, Any], Dict[str, Any], Dict[str, Any]]:
    invocation = adapter["invocation"]["evidenceCommand"]
    require(
        invocation.get("entrypointID") == PERFORMANCE_EVALUATION_ENTRYPOINT_ID,
        "performance evidence entrypoint",
    )
    require(candidate_input is not None and flow is not None, "performance release context")
    require(
        set(inputs) == {"performanceMetrics", "performanceThresholdProfile"}
        and len(inputs["performanceMetrics"]) == 1
        and len(inputs["performanceThresholdProfile"]) == 1,
        "performance evidence inputs",
    )
    metrics_value = inputs["performanceMetrics"][0]
    threshold_value = inputs["performanceThresholdProfile"][0]
    metrics = load_canonical(ROOT / metrics_value)
    threshold = load_canonical(ROOT / threshold_value)
    evaluation_id = f"evaluation-{uuid.uuid4()}"
    output = package_root / "performance-evaluation.generated.v1.json"
    result = subprocess.run(
        [
            str(ROOT / "Scripts/performance-evidence"),
            "evaluate",
            "--metrics",
            metrics_value,
            "--threshold-profile",
            threshold_value,
            "--threshold-set",
            metrics["thresholdSetID"],
            "--evaluation-id",
            evaluation_id,
            "--output",
            str(output),
        ],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    )
    require(
        result.returncode == 0,
        f"performance evidence command: {result.stderr.strip()}",
    )
    evaluation = load_canonical(output)
    output.unlink()
    require(
        evaluation.get("candidate") == candidate_input["candidate"],
        "performance evaluation candidate",
    )
    require(
        evaluation.get("releaseFlowID") == flow["releaseFlowID"]
        and evaluation.get("evidenceStoreBindingID")
        == flow["evidenceStoreBindingID"],
        "performance evaluation flow",
    )
    threshold_sets = threshold.get("thresholdSets")
    require(isinstance(threshold_sets, list), "performance threshold sets")
    matching_sets = [
        item
        for item in threshold_sets
        if item.get("thresholdSetID") == metrics.get("thresholdSetID")
    ]
    require(len(matching_sets) == 1, "performance threshold set")
    measurement = matching_sets[0].get("measurementProfile")
    require(isinstance(measurement, dict), "performance measurement profile")
    outcome = evaluation.get("overallOutcome")
    require(outcome in ("passed", "failed", "unknown"), "performance outcome")
    disposition = {
        "passed": "runner.performance-evaluation-passed",
        "failed": "runner.performance-threshold-failed",
        "unknown": "runner.performance-evaluation-incomplete",
    }[outcome]
    return outcome, disposition, evaluation, measurement, threshold


def nonnegative_integer(value: Any, label: str) -> int:
    require(
        isinstance(value, int) and not isinstance(value, bool) and value >= 0,
        label,
    )
    return value


def stage_observation_predicate(
    metrics: Mapping[str, Any], evidence_stage: str
) -> Tuple[str, str]:
    require(evidence_stage in STAGE_OBSERVATION_LIMITS, "stage observation stage")
    minimum_duration_ms, required_reconnects = STAGE_OBSERVATION_LIMITS[
        evidence_stage
    ]
    duration_ms = nonnegative_integer(
        metrics.get("monotonicDurationMs"), "stage metrics duration"
    )
    stability = metrics.get("stability")
    require(isinstance(stability, dict), "stage metrics stability")
    require(
        nonnegative_integer(stability.get("durationMs"), "stability duration")
        == duration_ms,
        "stage duration identity",
    )
    counters = stability.get("counters")
    require(
        isinstance(counters, dict) and set(counters) == STABILITY_COUNTER_IDS,
        "stability counter set",
    )
    counter_values = {
        key: nonnegative_integer(value, f"stability counter: {key}")
        for key, value in counters.items()
    }
    reconnects = metrics.get("reconnects")
    require(isinstance(reconnects, list), "stage reconnects")
    attempt_ids = []
    not_recovered = False
    for reconnect in reconnects:
        require(isinstance(reconnect, dict), "stage reconnect row")
        attempt_id = validate_opaque_id(
            reconnect.get("attemptID"), "stage reconnect attempt ID"
        )
        attempt_ids.append(attempt_id)
        for channel in ("control", "video"):
            channel_result = reconnect.get(channel)
            require(isinstance(channel_result, dict), f"stage reconnect {channel}")
            outcome = channel_result.get("outcome")
            require(
                outcome in ("recovered", "notApplicable", "notRecovered"),
                f"stage reconnect {channel} outcome",
            )
            if outcome == "recovered":
                nonnegative_integer(
                    channel_result.get("ms"), f"stage reconnect {channel} latency"
                )
                require("reason" not in channel_result, f"stage reconnect {channel} reason")
            elif outcome == "notApplicable":
                require(
                    "ms" not in channel_result
                    and isinstance(channel_result.get("reason"), str),
                    f"stage reconnect {channel} not applicable",
                )
            else:
                not_recovered = True
                require(
                    "ms" not in channel_result
                    and isinstance(channel_result.get("reason"), str),
                    f"stage reconnect {channel} not recovered",
                )
    require(
        len(attempt_ids) == len(set(attempt_ids)), "stage reconnect attempt uniqueness"
    )
    gate_values = metrics.get("gateValues")
    require(isinstance(gate_values, list), "stage gate values")
    data_quality_unknown = any(
        isinstance(row, dict) and row.get("dataQuality") != "complete"
        for row in gate_values
    )
    failure_reasons = stability.get("failureReasons")
    require(
        isinstance(failure_reasons, list)
        and all(isinstance(item, str) for item in failure_reasons)
        and failure_reasons == sorted(set(failure_reasons)),
        "stage failure reasons",
    )
    known_failure = (
        duration_ms < minimum_duration_ms
        or len(reconnects) != required_reconnects
        or not_recovered
        or any(
            counter_values[key] > 0
            for key in STABILITY_COUNTER_IDS - {"metricsGap", "outcomeUnknown"}
        )
    )
    unknown = (
        not known_failure
        and (
            counter_values["metricsGap"] > 0
            or counter_values["outcomeUnknown"] > 0
            or data_quality_unknown
        )
    )
    outcome = "failed" if known_failure else "unknown" if unknown else "passed"
    require(
        stability.get("passed") is (outcome == "passed"),
        "stage self-report consistency",
    )
    require(
        (not failure_reasons) == (outcome == "passed"),
        "stage failure reason consistency",
    )
    return outcome, {
        "passed": "runner.stage-observation-passed",
        "failed": "runner.stage-predicate-failed",
        "unknown": "runner.stage-observation-incomplete",
    }[outcome]


def validate_stage_operation(
    adapter: Mapping[str, Any],
    inputs: Mapping[str, Sequence[str]],
    evidence_stage: str | None,
    candidate_input: Mapping[str, Any] | None,
    expected_environment: Mapping[str, Any],
) -> Tuple[str, str, Dict[str, Any], Dict[str, Any], Dict[str, Any] | None]:
    require(evidence_stage is not None, "stage operation release context")
    require(
        adapter["invocation"]["releaseStageOperation"].get("operationID")
        == STAGE_OPERATION_ID,
        "stage operation ID",
    )
    require(candidate_input is not None, "stage operation candidate input")
    metrics_value = inputs["performanceMetrics"][0]
    measurement_value = inputs["performanceMeasurementProfile"][0]
    threshold_values = list(inputs["performanceThresholdProfile"])
    expected_threshold_count = 0 if evidence_stage == "internalAlpha" else 1
    require(
        len(threshold_values) == expected_threshold_count,
        "stage threshold profile cardinality",
    )
    command = [
        str(ROOT / "Scripts/performance-evidence"),
        "validate-metrics",
        "--metrics",
        metrics_value,
        "--measurement-profile",
        measurement_value,
    ]
    if threshold_values:
        command.extend(["--threshold-profile", threshold_values[0]])
    validation = subprocess.run(
        command,
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    )
    require(
        validation.returncode == 0,
        f"stage metrics contract: {validation.stderr.strip()}",
    )
    metrics = load_canonical(ROOT / metrics_value)
    measurement = load_canonical(ROOT / measurement_value)
    threshold = (
        load_canonical(ROOT / threshold_values[0]) if threshold_values else None
    )
    candidate = candidate_input["candidate"]
    require(metrics.get("appBuild") == candidate["buildID"], "stage candidate build")
    require(
        metrics.get("evaluationMode")
        == ("baseline" if evidence_stage == "internalAlpha" else "threshold"),
        "stage evaluation mode",
    )
    host = measurement.get("host")
    device = measurement.get("device")
    capture = measurement.get("capture")
    require(
        isinstance(host, dict)
        and isinstance(device, dict)
        and isinstance(capture, dict),
        "stage measurement shape",
    )
    exact_bindings = {
        "architecture": host.get("architecture"),
        "macOSBuild": host.get("macOSBuild"),
        "logicalCPUCount": host.get("logicalCPUCount"),
        "displayRefreshRateMilliHz": host.get("displayRefreshRateMilliHz"),
        "deviceClass": device.get("deviceClass"),
        "productType": device.get("productType"),
        "iOSBuild": device.get("osBuild"),
        "captureWidthPixels": capture.get("widthPixels"),
        "captureHeightPixels": capture.get("heightPixels"),
        "nominalCaptureFPSMilli": capture.get("nominalFPSMilli"),
        "windowWidthPixels": capture.get("windowWidthPixels"),
        "windowHeightPixels": capture.get("windowHeightPixels"),
        "audioMute": capture.get("audioMute"),
        "buildConfiguration": measurement.get("buildConfiguration"),
    }
    for key, expected in exact_bindings.items():
        require(metrics.get(key) == expected, f"stage measurement binding: {key}")
    require(
        metrics.get("reconnectReadinessProfileID")
        == measurement.get("reconnectReadinessProfileID")
        and metrics.get("reconnectReadinessProfileHash")
        == measurement.get("reconnectReadinessProfileHash"),
        "stage reconnect profile binding",
    )
    require(
        measurement.get("evidenceEnvironmentProfileID")
        == expected_environment["profileID"]
        and measurement.get("evidenceEnvironmentProfileHash")
        == domain_hash(
            "pulsephone.evidence-environment-profile.v1", expected_environment
        ),
        "stage environment binding",
    )
    predicate = stage_observation_predicate(metrics, evidence_stage)
    return predicate[0], predicate[1], metrics, measurement, threshold


def verify_stage_observation_predicate() -> int:
    def metrics(duration: int, reconnect_count: int) -> Dict[str, Any]:
        reconnects = [
            {
                "attemptID": f"reconnect-{index}",
                "control": {"ms": 1, "outcome": "recovered"},
                "video": {"ms": 1, "outcome": "recovered"},
            }
            for index in range(1, reconnect_count + 1)
        ]
        return {
            "gateValues": [{"dataQuality": "complete"}],
            "monotonicDurationMs": duration,
            "reconnects": reconnects,
            "stability": {
                "counters": {key: 0 for key in STABILITY_COUNTER_IDS},
                "durationMs": duration,
                "failureReasons": [],
                "passed": True,
            },
        }

    alpha = metrics(30 * 60 * 1000, 5)
    require(stage_observation_predicate(alpha, "internalAlpha")[0] == "passed", "Alpha stage predicate")
    beta = metrics(2 * 60 * 60 * 1000, 20)
    require(stage_observation_predicate(beta, "externalBeta")[0] == "passed", "Beta stage predicate")
    formal = metrics(8 * 60 * 60 * 1000, 50)
    require(stage_observation_predicate(formal, "formalRelease")[0] == "passed", "Formal stage predicate")
    for changed in (
        metrics(30 * 60 * 1000 - 1, 5),
        metrics(30 * 60 * 1000, 4),
    ):
        changed["stability"]["passed"] = False
        changed["stability"]["failureReasons"] = ["stageRequirementNotMet"]
        require(stage_observation_predicate(changed, "internalAlpha")[0] == "failed", "stage negative predicate")
    crash = metrics(30 * 60 * 1000, 5)
    crash["stability"]["counters"]["crash"] = 1
    crash["stability"]["passed"] = False
    crash["stability"]["failureReasons"] = ["crash"]
    require(stage_observation_predicate(crash, "internalAlpha")[0] == "failed", "stage P0 predicate")
    gap = metrics(30 * 60 * 1000, 5)
    gap["stability"]["counters"]["metricsGap"] = 1
    gap["stability"]["passed"] = False
    gap["stability"]["failureReasons"] = ["metricsGap"]
    require(stage_observation_predicate(gap, "internalAlpha")[0] == "unknown", "stage unknown predicate")
    return 7


def verify_profile_input_contract() -> int:
    def expect_contract_error(callback: Any, label: str) -> None:
        try:
            callback()
        except ContractError:
            return
        raise ContractError(label)

    scope_hash = "a" * 64
    environment_hash = "b" * 64
    requirement_id = "T-018/stability-stage-run-l5"
    target = f"1:{requirement_id}:{scope_hash}:{environment_hash}:performanceMetrics"
    parsed = parse_profile_input_artifacts([f"{target}=metrics.json"])
    require(
        parsed
        == {
            (1, requirement_id, scope_hash, environment_hash): [
                "performanceMetrics=metrics.json"
            ]
        },
        "profile input parse",
    )
    expect_contract_error(
        lambda: parse_profile_input_artifacts(
            [f"{target}=metrics.json", f"{target}=metrics-2.json"]
        ),
        "duplicate profile input accepted",
    )
    expect_contract_error(
        lambda: parse_profile_input_artifacts(
            [
                f"4:{requirement_id}:{scope_hash}:{environment_hash}:performanceMetrics=metrics.json"
            ]
        ),
        "invalid profile ordinal accepted",
    )
    adapter = load_canonical(
        ROOT / "Verification/runner-adapters/T-018/stability-stage-run-l5.v1.json"
    )
    missing_allowed = validate_adapter_inputs(
        adapter, {}, allow_missing_required=True
    )
    require(
        missing_required_input_roles(adapter, missing_allowed)
        == ["performanceMeasurementProfile", "performanceMetrics"],
        "stage missing input projection",
    )
    expect_contract_error(
        lambda: validate_adapter_inputs(adapter, {}),
        "strict stage input cardinality accepted",
    )
    profile = {
        "releaseStage": "formalRelease",
        "requirements": [
            {
                "environmentProfileHash": environment_hash,
                "requirementID": requirement_id,
                "scopeProjectionHash": scope_hash,
                "stageRunCohortID": "formal.stability-performance.v1",
            }
        ],
    }
    assignments = []
    for ordinal in (1, 2, 3):
        prefix = f"{ordinal}:{requirement_id}:{scope_hash}:{environment_hash}"
        assignments.extend(
            [
                f"{prefix}:performanceMeasurementProfile=measurement.json",
                f"{prefix}:performanceMetrics=metrics-{ordinal}.json",
                f"{prefix}:performanceThresholdProfile=threshold.json",
            ]
        )
    require(
        len(validate_formal_profile_inputs(profile, assignments)) == 3,
        "Formal profile input coverage",
    )
    expect_contract_error(
        lambda: validate_formal_profile_inputs(profile, assignments[:-1]),
        "incomplete Formal profile inputs accepted",
    )
    reused_metrics = [
        value.replace("performanceMetrics=metrics-3.json", "performanceMetrics=metrics-2.json")
        for value in assignments
    ]
    expect_contract_error(
        lambda: validate_formal_profile_inputs(profile, reused_metrics),
        "reused Formal metrics accepted",
    )
    expect_contract_error(
        lambda: validate_adapter_inputs(
            adapter,
            {"undeclaredRole": ["value.json"]},
            allow_missing_required=True,
        ),
        "undeclared stage input accepted",
    )
    return 8


def verify_performance_evidence_command() -> int:
    threshold = load_canonical(
        ROOT / "Fixtures/performance/threshold-profile/profile.v1.json"
    )
    adapter = {
        "adapterKind": "evidenceCommand",
        "invocation": {
            "evidenceCommand": {
                "argumentSchemaRef": "Schemas/evidence/performance-evaluation.v1.schema.json",
                "entrypointID": PERFORMANCE_EVALUATION_ENTRYPOINT_ID,
            }
        },
    }
    inputs = {
        "performanceMetrics": [
            "Fixtures/performance/metrics-contract/threshold.metrics.v1.json"
        ],
        "performanceThresholdProfile": [
            "Fixtures/performance/threshold-profile/profile.v1.json"
        ],
    }
    with tempfile.TemporaryDirectory(
        prefix="performance-command-self-test-",
        dir=ROOT / "build/evidence",
    ) as temporary:
        outcome, disposition, evaluation, measurement, resolved_threshold = (
            execute_performance_evidence_command(
                adapter,
                inputs,
                {"candidate": threshold["baselineCandidate"]},
                {
                    "evidenceStoreBindingID": threshold[
                        "evidenceStoreBindingID"
                    ],
                    "releaseFlowID": threshold["releaseFlowID"],
                },
                Path(temporary),
            )
        )
    require(
        outcome == "passed"
        and disposition == "runner.performance-evaluation-passed"
        and evaluation["performanceContract"] == threshold["performanceContract"]
        and measurement["profileID"]
        == evaluation["measurementProfileID"]
        and resolved_threshold == threshold,
        "performance evidence command self-test",
    )
    return 1


def copy_file_artifact(
    package_root: Path,
    artifact_id: str,
    source_data: bytes,
    role: str,
    produced_by: Sequence[str],
    sensitivity: str = "internal",
    owner_role: str = "testRunner",
) -> Dict[str, Any]:
    relative = f"artifacts/{artifact_id}.json"
    path = package_root / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(source_data)
    os.chmod(path, 0o600)
    return {
        "artifactID": artifact_id,
        "artifactKind": "file",
        "file": {
            "byteLength": len(source_data),
            "mediaType": CANONICAL_MEDIA,
            "sha256": sha256_bytes(source_data),
        },
        "ownerRole": owner_role,
        "producedByScenarioIDs": sorted(produced_by),
        "redactionState": "notRequired",
        "relativePath": relative,
        "role": role,
        "sensitivityClass": sensitivity,
    }


def copy_tree_artifact(
    package_root: Path,
    artifact_id: str,
    source_root: Path,
    candidate_input: Mapping[str, Any],
    manifest_artifact_id: str,
    produced_by: Sequence[str],
) -> Dict[str, Any]:
    metadata = source_root.lstat()
    require(
        stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode),
        "candidate tree root",
    )
    require(source_root.name == "PulsePhone.app", "candidate tree basename")
    manifest = candidate_input["appBundleContentManifest"]
    entries = manifest.get("entries")
    require(isinstance(entries, list), "candidate tree manifest entries")
    expected_paths = set()
    total_bytes = 0
    for entry in entries:
        relative = entry["relativePath"]
        directory = entry["nodeType"] == "directory"
        validate_relative_path(relative, directory=directory)
        relative_without_slash = relative[:-1] if directory else relative
        expected_paths.add(relative_without_slash)
        source = source_root / relative_without_slash
        source_metadata = source.lstat()
        require(not stat.S_ISLNK(source_metadata.st_mode), "candidate tree symlink")
        require(source_metadata.st_nlink == 1 or directory, "candidate tree hardlink")
        require((source_metadata.st_mode & 0o777) == entry["mode"], "candidate tree mode")
        if directory:
            require(stat.S_ISDIR(source_metadata.st_mode), "candidate tree directory")
        else:
            require(stat.S_ISREG(source_metadata.st_mode), "candidate tree file")
            data = source.read_bytes()
            require(len(data) == entry["byteLength"], "candidate tree byte length")
            require(sha256_bytes(data) == entry["sha256"], "candidate tree file hash")
            total_bytes += len(data)
            require(total_bytes <= (1 << 63) - 1, "candidate tree byte overflow")
    actual_paths = set()
    for source in source_root.rglob("*"):
        relative = source.relative_to(source_root).as_posix()
        actual_paths.add(relative)
        source_metadata = source.lstat()
        require(not stat.S_ISLNK(source_metadata.st_mode), "candidate tree symlink")
        require(
            stat.S_ISDIR(source_metadata.st_mode)
            or (stat.S_ISREG(source_metadata.st_mode) and source_metadata.st_nlink == 1),
            "candidate tree node",
        )
    require(actual_paths == expected_paths, "candidate tree manifest coverage")
    relative_root = f"artifacts/{artifact_id}/PulsePhone.app"
    destination = package_root / relative_root
    destination.parent.mkdir(mode=0o700, parents=True)
    shutil.copytree(source_root, destination, symlinks=False)
    return {
        "artifactID": artifact_id,
        "artifactKind": "tree",
        "ownerRole": "releaseOwner",
        "producedByScenarioIDs": sorted(produced_by),
        "redactionState": "notRequired",
        "relativePath": relative_root,
        "role": "releaseCandidateAppTree",
        "sensitivityClass": "internal",
        "tree": {
            "entryCount": len(entries),
            "manifestArtifactID": manifest_artifact_id,
            "totalFileByteLength": total_bytes,
            "treeContentHash": candidate_input["candidate"]["appBundleContentHash"],
            "treeHashAlgorithm": "appBundleContent.v1",
        },
    }


def parse_input_artifacts(assignments: Sequence[str]) -> Dict[str, List[str]]:
    values: Dict[str, List[str]] = {}
    for assignment in assignments:
        role, separator, path = assignment.partition("=")
        require(separator == "=" and role and path, "input artifact assignment")
        validate_opaque_id(role, "input artifact role")
        values.setdefault(role, []).append(path)
    return values


def parse_profile_input_artifacts(
    assignments: Sequence[str],
) -> Dict[Tuple[int, str, str, str], List[str]]:
    values: Dict[Tuple[int, str, str, str], List[str]] = {}
    seen_roles = set()
    for assignment in assignments:
        target, separator, path = assignment.partition("=")
        require(separator == "=" and target and path, "profile input assignment")
        parts = target.split(":")
        require(len(parts) == 5, "profile input target")
        ordinal_value, requirement_id, scope_hash, environment_hash, role = parts
        require(ordinal_value in ("1", "2", "3"), "profile input ordinal")
        require(
            re.fullmatch(r"[0-9a-f]{64}", scope_hash) is not None,
            "profile input scope hash",
        )
        require(
            re.fullmatch(r"[0-9a-f]{64}", environment_hash) is not None,
            "profile input environment hash",
        )
        validate_opaque_id(role, "profile input role")
        key = (int(ordinal_value), requirement_id, scope_hash, environment_hash)
        role_key = (*key, role)
        require(role_key not in seen_roles, "duplicate profile input role")
        seen_roles.add(role_key)
        values.setdefault(key, []).append(f"{role}={path}")
    return values


def adapter_input_specs(adapter: Mapping[str, Any] | None) -> Dict[str, Dict[str, Any]]:
    if adapter is None:
        return {}
    inputs = adapter.get("inputArtifacts", [])
    require(isinstance(inputs, list), "adapter input artifacts")
    specs = {item["role"]: item for item in inputs}
    require(len(specs) == len(inputs), "adapter input role uniqueness")
    return specs


def validate_adapter_inputs(
    adapter: Mapping[str, Any] | None,
    supplied: Mapping[str, Sequence[str]],
    allow_missing_required: bool = False,
) -> Dict[str, List[str]]:
    specs = adapter_input_specs(adapter)
    require(set(supplied) <= set(specs), "undeclared input artifact role")
    result: Dict[str, List[str]] = {}
    for role, spec in specs.items():
        values = list(supplied.get(role, []))
        cardinality = spec["cardinality"]
        minimum, maximum = cardinality_bounds(cardinality)
        require(len(values) <= maximum, f"input artifact cardinality: {role}")
        if not allow_missing_required:
            require(minimum <= len(values), f"input artifact cardinality: {role}")
        result[role] = values
    return result


def missing_required_input_roles(
    adapter: Mapping[str, Any] | None,
    inputs: Mapping[str, Sequence[str]],
) -> List[str]:
    missing = []
    for role, spec in adapter_input_specs(adapter).items():
        minimum, _ = cardinality_bounds(spec["cardinality"])
        if len(inputs.get(role, [])) < minimum:
            missing.append(role)
    return sorted(missing)


def resolve_file_input(
    role: str,
    spec: Mapping[str, Any],
    value: str,
    objects_root_value: str,
) -> Tuple[bytes, Dict[str, Any]]:
    require(spec.get("artifactKind") == "file", f"file input kind: {role}")
    domain = spec.get("artifactDomain")
    path = ROOT / value
    document = load_canonical(path)
    objects_root = verified_objects_root(objects_root_value)
    if domain in ("developmentCandidateInput", "releaseCandidateInput"):
        expected_kind = (
            "developmentAssembly"
            if domain == "developmentCandidateInput"
            else "signedNotarized"
        )
        candidate, candidate_hash, _ = load_typed_candidate(
            value, objects_root_value, expected_kind
        )
        return path.read_bytes(), {
            "candidate": candidate,
            "candidateInputHash": candidate_hash,
        }
    opaque_id = (
        document.get("coverageSetID")
        if domain == "broadOSCoverageSet"
        else document.get("grantID")
        if domain == "negativeRemovalWriteGrant"
        else None
    )
    if opaque_id is not None:
        filename = path.name
        require(
            path == typed_object_path(objects_root, domain, opaque_id, filename),
            f"typed input path: {role}",
        )
    return path.read_bytes(), {"document": document}


def run_members(
    member_ids: Sequence[str],
    suite_id: str | None,
    task_id: str,
    objects_root_value: str,
    input_artifact_values: Sequence[str] = (),
    release_flow_value: str | None = None,
    evidence_stage: str | None = None,
    candidate_record_value: str | None = None,
    negative_removal_plan_value: str | None = None,
    release_profile_value: str | None = None,
    release_stage_run: Mapping[str, Any] | None = None,
    release_selection_id: str | None = None,
    candidate_context_override: Mapping[str, Any] | None = None,
    candidate_input_hash_override: str | None = None,
) -> List[str]:
    structural = verify_policy_structural()
    requirements = load_requirements()
    if suite_id is not None:
        require(not member_ids, "--suite and --member are mutually exclusive")
        selected = sorted(
            requirement_id
            for requirement_id, requirement in requirements.items()
            if requirement["executionSuiteID"] == suite_id
        )
        require(selected, f"unknown or empty suite: {suite_id}")
    else:
        selected = list(member_ids)
        require(selected, "at least one --member or --suite is required")
    require(len(selected) == len(set(selected)), "duplicate member selection")
    for requirement_id in selected:
        require(requirement_id in requirements, f"unknown member: {requirement_id}")
    objects_root = verified_objects_root(objects_root_value)
    release_context = release_flow_value is not None or evidence_stage is not None
    require(
        (release_flow_value is None) == (evidence_stage is None),
        "release flow and evidence stage must appear together",
    )
    if evidence_stage is not None:
        require(
            evidence_stage in ("internalAlpha", "externalBeta", "formalRelease"),
            "release evidence stage",
        )
    flow = (
        load_release_flow(release_flow_value, objects_root_value)
        if release_flow_value is not None
        else None
    )
    release_profile = None
    if release_profile_value is not None:
        require(release_context, "release profile requires release run")
        release_profile = load_canonical(ROOT / release_profile_value)
        validate_profile(release_profile)
        require(
            ROOT / release_profile_value
            == typed_object_path(
                objects_root,
                "releaseGateProfile",
                release_profile["profileID"],
                "release-gate-profile.v1.json",
            ),
            "member release profile typed path",
        )
        require(
            release_profile["releaseStage"] == evidence_stage,
            "member release profile stage",
        )
        require(
            flow is not None
            and release_profile["releaseFlowID"] == flow["releaseFlowID"]
            and release_profile["evidenceStoreBindingID"]
            == flow["evidenceStoreBindingID"],
            "member release profile flow",
        )
    require(
        (candidate_context_override is None)
        == (candidate_input_hash_override is None),
        "candidate override pair",
    )
    require(
        candidate_record_value is None or candidate_context_override is None,
        "candidate record and override conflict",
    )
    candidate_context = (
        dict(candidate_context_override)
        if candidate_context_override is not None
        else None
    )
    candidate_input_hash = candidate_input_hash_override
    if candidate_record_value is not None:
        require(release_context, "candidate record requires release run")
        candidate_context, candidate_input_hash, candidate_manifest, candidate_verified = candidate_from_record(
            candidate_record_value, objects_root_value
        )
        require(
            candidate_manifest.get("releaseFlow", {}).get("releaseFlowID")
            == flow["releaseFlowID"],
            "candidate record release flow",
        )
        require(
            candidate_verified["record"]["evidenceStoreBindingID"]
            == flow["evidenceStoreBindingID"],
            "candidate record binding",
        )
    supplied_inputs = parse_input_artifacts(input_artifact_values)
    require(
        not (
            candidate_record_value is not None
            and set(supplied_inputs)
            & {"releaseCandidateInput", "releaseCandidateAppTree"}
        ),
        "candidate record and candidate producer inputs are mutually exclusive",
    )
    if "broadOSCoverageSet" in supplied_inputs:
        require(
            candidate_record_value is not None
            and negative_removal_plan_value is not None,
            "broad coverage input requires candidate record and removal plan",
        )
    source = source_snapshot()
    source_state = "clean" if source["worktreeState"] == "clean" else "dirty"
    results: List[str] = []
    for requirement_id in selected:
        requirement = requirements[requirement_id]
        adapter_path = ROOT / f"Verification/runner-adapters/{requirement_id}.v1.json"
        if not adapter_path.exists():
            outcome, disposition = "unknown", "runner.adapter-missing"
            adapter = None
        else:
            adapter = load_canonical(adapter_path)
            if adapter["adapterKind"] == "releaseStageOperation":
                outcome, disposition = "unknown", "runner.input-artifact-missing"
            else:
                outcome, disposition = execute_adapter(adapter)
        allow_missing_stage_input = (
            adapter is not None
            and adapter["adapterKind"] == "releaseStageOperation"
        )
        validated_inputs = validate_adapter_inputs(
            adapter,
            supplied_inputs,
            allow_missing_required=allow_missing_stage_input,
        )
        missing_stage_inputs = missing_required_input_roles(
            adapter, validated_inputs
        )
        started_wall = utc_now()
        start = time.monotonic_ns()
        ended_wall = utc_now()
        duration_ms = max(0, (time.monotonic_ns() - start) // 1_000_000)
        evidence_run_id = f"run-{uuid.uuid4()}"
        path_key = artifact_path_key("evidenceRunPackage", evidence_run_id)
        package_root = objects_root / path_key
        require(not package_root.exists(), "evidence package path collision")
        package_root.mkdir(mode=0o700)
        ordinal_suffix = (
            f".ordinal-{release_stage_run['stageRunOrdinal']}"
            if release_stage_run is not None
            else ""
        )
        scenario_id = (
            f"{requirement_id}.{evidence_stage or 'implementation'}"
            f"{ordinal_suffix}"
        )
        artifacts = []
        environment_id = "environment-snapshot"
        resolved_candidate = candidate_context
        resolved_candidate_hash = candidate_input_hash
        input_specs = adapter_input_specs(adapter)
        input_file_artifact_ids: Dict[str, str] = {}
        for role in sorted(
            validated_inputs,
            key=lambda item: (input_specs[item]["artifactKind"] == "tree", item),
        ):
            spec = input_specs[role]
            for index, value in enumerate(validated_inputs[role], 1):
                artifact_id = role if len(validated_inputs[role]) == 1 else f"{role}-{index}"
                if spec["artifactKind"] == "file":
                    data, resolved = resolve_file_input(
                        role, spec, value, objects_root_value
                    )
                    if "candidate" in resolved:
                        input_candidate = resolved["candidate"]
                        input_hash = resolved["candidateInputHash"]
                        if resolved_candidate is not None:
                            require(resolved_candidate == input_candidate, "input candidate conflict")
                        resolved_candidate = input_candidate
                        resolved_candidate_hash = input_hash
                    if role == "broadOSCoverageSet":
                        coverage = resolved["document"]
                        plan = load_canonical(ROOT / negative_removal_plan_value)
                        require(
                            flow is not None
                            and coverage.get("releaseFlowID")
                            == flow["releaseFlowID"]
                            and coverage.get("evidenceStoreBindingID")
                            == flow["evidenceStoreBindingID"],
                            "broad coverage flow binding",
                        )
                        require(
                            resolved_candidate_hash is not None
                            and coverage.get("candidateInputHash")
                            == resolved_candidate_hash,
                            "broad coverage candidate",
                        )
                        require(
                            coverage.get("negativeRemovalPlanHash")
                            == domain_hash(NEGATIVE_REMOVAL_DOMAIN, plan),
                            "broad coverage removal plan",
                        )
                        require(
                            coverage.get("coverageOutcome")
                            in ("passed", "failed", "unknown"),
                            "broad coverage outcome",
                        )
                    owner_role = (
                        "authorizedLegalReviewer"
                        if role == "reviewedDevelopmentCandidateInput"
                        else "releaseOwner"
                        if role
                        in (
                            "developmentCandidateInput",
                            "releaseCandidateInput",
                            "negativeRemovalWriteGrant",
                            "performanceMeasurementProfile",
                            "performanceThresholdProfile",
                        )
                        else "testRunner"
                    )
                    sensitivity = (
                        "restricted"
                        if role == "reviewedDevelopmentCandidateInput"
                        else "internal"
                    )
                    artifacts.append(
                        copy_file_artifact(
                            package_root,
                            artifact_id,
                            data,
                            role,
                            [scenario_id],
                            sensitivity=sensitivity,
                            owner_role=owner_role,
                        )
                    )
                    input_file_artifact_ids[role] = artifact_id
                else:
                    require(role == "releaseCandidateAppTree", "unsupported tree input role")
                    require(resolved_candidate is not None, "candidate tree requires candidate input")
                    source_tree = ROOT / value
                    require(
                        resolved_candidate_hash is not None
                        and source_tree
                        == typed_object_path(
                            objects_root,
                            "releaseCandidateAppTree",
                            resolved_candidate_hash,
                            "PulsePhone.app",
                        ).parent,
                        "candidate tree typed path",
                    )
                    require(
                        "releaseCandidateInput" in input_file_artifact_ids,
                        "candidate tree manifest artifact",
                    )
                    artifacts.append(
                        copy_tree_artifact(
                            package_root,
                            artifact_id,
                            source_tree,
                            resolved_candidate,
                            input_file_artifact_ids["releaseCandidateInput"],
                            [scenario_id],
                        )
                    )
        runner_source: Dict[str, Any] = {
            "gitCommit": source["gitHeadCommit"],
            "worktreeState": source_state,
        }
        if source_state == "dirty":
            snapshot_id = "runner-source-snapshot"
            runner_source["sourceSnapshotArtifactID"] = snapshot_id
            artifacts.append(
                copy_file_artifact(
                    package_root,
                    snapshot_id,
                    canonical_bytes(source),
                    "runnerSourceSnapshot",
                    [scenario_id],
                )
            )
        environment_profile = {
            "facetIDs": ["cleanliness.clean", "distribution.sourceTree"],
            "profileID": "env.implementation.clean-source",
        }
        scope_projection = {
            "nonCommandFeatureIDs": [],
            "preparationGroupIDs": [],
            "productActionIDs": [],
            "scopeKind": "global",
        }
        if release_context and resolved_candidate is not None:
            if release_profile is not None:
                require(
                    release_profile["releaseInput"]["candidateInput"]
                    == resolved_candidate,
                    "member release profile candidate",
                )
                rows = release_profile["requirements"]
                scopes = release_profile["scopeProjections"]
                environments = release_profile["environmentProfiles"]
            else:
                proposed = public_scope_from_candidate(resolved_candidate)
                rows, scopes, environments = derive_profile_requirements(
                    evidence_stage, resolved_candidate, proposed
                )
            matching_rows = [
                row for row in rows if row["requirementID"] == requirement_id
            ]
            require(
                len(matching_rows) == 1,
                f"release member tuple cardinality: {requirement_id}",
            )
            selected_row = matching_rows[0]
            scope_projection = next(
                scope
                for scope in scopes
                if domain_hash("pulsephone.release-gate-scope.v1", scope)
                == selected_row["scopeProjectionHash"]
            )
            environment_profile = next(
                environment
                for environment in environments
                if environment["profileID"]
                == selected_row["environmentProfileID"]
            )
        stage_metrics = None
        stage_measurement = None
        stage_threshold = None
        performance_evaluation = None
        if (
            adapter is not None
            and adapter["adapterKind"] == "evidenceCommand"
            and adapter["invocation"]["evidenceCommand"].get("entrypointID")
            == PERFORMANCE_EVALUATION_ENTRYPOINT_ID
        ):
            (
                outcome,
                disposition,
                performance_evaluation,
                stage_measurement,
                stage_threshold,
            ) = execute_performance_evidence_command(
                adapter,
                validated_inputs,
                resolved_candidate,
                flow,
                package_root,
            )
            stage_metrics = load_canonical(
                ROOT / validated_inputs["performanceMetrics"][0]
            )
            started_wall = stage_metrics["startedAtUTC"]
            ended_wall = stage_metrics["endedAtUTC"]
            duration_ms = stage_metrics["monotonicDurationMs"]
            artifacts.append(
                copy_file_artifact(
                    package_root,
                    "performanceEvaluation",
                    canonical_bytes(performance_evaluation),
                    "performanceEvaluation",
                    [scenario_id],
                )
            )
        elif (
            adapter is not None
            and adapter["adapterKind"] == "releaseStageOperation"
            and not missing_stage_inputs
        ):
            (
                outcome,
                disposition,
                stage_metrics,
                stage_measurement,
                stage_threshold,
            ) = validate_stage_operation(
                adapter,
                validated_inputs,
                evidence_stage,
                resolved_candidate,
                environment_profile,
            )
            started_wall = stage_metrics["startedAtUTC"]
            ended_wall = stage_metrics["endedAtUTC"]
            duration_ms = stage_metrics["monotonicDurationMs"]
        claim_effect = (
            "supportsActuallyVerifiedReview"
            if source_state == "clean" and outcome == "passed"
            else "none"
        )
        if requirement["failurePolicyID"] == "failure.product.v1" and outcome != "passed":
            claim_effect = "blocksReleaseStage" if release_context else "none"
        artifacts.append(
            copy_file_artifact(
                package_root,
                environment_id,
                canonical_bytes(
                    environment_profile
                    if release_context
                    else environment_snapshot()
                ),
                "environmentSnapshot",
                [scenario_id],
            )
        )
        scenario = {
            "applicability": "applicable",
            "artifactIDs": sorted(artifact["artifactID"] for artifact in artifacts),
            "blockerCodes": [] if outcome == "passed" else [disposition],
            "caseKey": requirement_id if requirement["fixtureMode"] != "none" else None,
            "claimEffect": claim_effect,
            "contractRefs": requirement["contractRefs"],
            "environmentProfileHash": domain_hash(
                "pulsephone.evidence-environment-profile.v1", environment_profile
            ),
            "environmentProfileID": environment_profile["profileID"],
            "expectedOracleRef": (
                adapter["oracleKind"] if adapter is not None else "runnerAdapter.required"
            ),
            "observedDisposition": disposition,
            "outcome": outcome,
            "requirementID": requirement_id,
            "scenarioID": scenario_id,
            "scopeProjection": scope_projection,
            "scopeProjectionHash": domain_hash(
                "pulsephone.release-gate-scope.v1", scope_projection
            ),
            "verificationID": requirement["verificationID"],
        }
        if scenario["caseKey"] is None:
            del scenario["caseKey"]
        implementation_identity = (
            resolved_candidate["implementationContractIdentity"]
            if resolved_candidate is not None
            else implementation_contract_identity()
        )
        retention_class = (
            "legalMaterial"
            if requirement["evidenceRolePolicyID"] == "role.reusable-legal.v1"
            else "candidateRun"
            if release_context or resolved_candidate is not None
            else "implementationRun"
        )
        manifest: Dict[str, Any] = {
            "artifacts": sorted(artifacts, key=lambda item: item["artifactID"]),
            "endedAtUTC": ended_wall,
            "environmentArtifactID": environment_id,
            "evidencePolicy": {
                "hash": structural["evidencePolicyHash"],
                "policyID": structural["policyID"],
            },
            "evidenceRunID": evidence_run_id,
            "evidenceStage": evidence_stage or "implementation",
            "generator": {"name": "Scripts/evidence-tool", "version": "1"},
            "implementationContractIdentity": implementation_identity,
            "monotonicDurationMs": duration_ms,
            "overallOutcome": outcome,
            "rawMaterialDisposition": {
                "cleanupOutcome": "notRequired",
                "derivedOnly": True,
                "rawPersisted": False,
            },
            "retentionClass": retention_class,
            "runnerSource": runner_source,
            "scenarioResults": [scenario],
            "schemaVersion": 1,
            "startedAtUTC": started_wall,
            "supersedesEvidenceRunIDs": [],
            "taskID": task_id,
            "validationStatus": {
                "integrity": "valid",
                "privacy": "valid",
                "rawCleanup": "valid",
                "retention": "valid",
            },
        }
        if flow is not None:
            manifest["releaseFlow"] = {
                "evidenceStoreBindingID": flow["evidenceStoreBindingID"],
                "releaseFlowID": flow["releaseFlowID"],
            }
        if release_stage_run is not None:
            require(
                flow is not None
                and release_profile is not None
                and release_selection_id is not None,
                "release stage run context",
            )
            manifest["releaseStageRun"] = {
                **release_stage_run,
                "releaseFlowID": flow["releaseFlowID"],
                "releaseGateProfileHash": validate_profile(release_profile),
                "releaseGateProfileID": release_profile["profileID"],
                "releaseStage": evidence_stage,
                "selectionSetID": release_selection_id,
            }
        if resolved_candidate is not None and (
            release_context or resolved_candidate.get("candidateKind") == "signedNotarized"
        ):
            manifest["candidate"] = resolved_candidate["candidate"]
        if stage_measurement is not None:
            manifest["measurementProfiles"] = [stage_measurement]
        if stage_threshold is not None:
            manifest["performanceThresholdProfiles"] = [stage_threshold]
        if performance_evaluation is not None:
            manifest["performanceContract"] = performance_evaluation[
                "performanceContract"
            ]
        if role_policy := requirement.get("evidenceRolePolicyID"):
            if role_policy == "role.reusable-legal.v1":
                require("candidate" not in manifest, "legal material candidate forbidden")
                if "reviewedDevelopmentCandidateInput" in validated_inputs:
                    require(
                        resolved_candidate is not None
                        and resolved_candidate.get("sourceCommit") == source["gitHeadCommit"],
                        "reviewed input source commit",
                    )
        if negative_removal_plan_value is not None:
            plan = load_canonical(ROOT / negative_removal_plan_value)
            validate_negative_removal_plan(plan)
            require(flow is not None and plan["releaseFlowID"] == flow["releaseFlowID"], "run removal plan flow")
        manifest_bytes = canonical_bytes(manifest)
        manifest_path = package_root / "evidence-manifest.v1.json"
        manifest_path.write_bytes(manifest_bytes)
        os.chmod(manifest_path, 0o600)
        sidecar = package_root / "evidence-manifest.v1.sha256"
        sidecar.write_bytes(sha256_bytes(manifest_bytes).encode("ascii"))
        os.chmod(sidecar, 0o600)
        results.append(relative_path(package_root))
    return results


def validate_package(package_value: str, output_value: str) -> Dict[str, Any]:
    package = ROOT / package_value
    require(package.is_dir() and not package.is_symlink(), "package root")
    manifest_path = package / "evidence-manifest.v1.json"
    sidecar_path = package / "evidence-manifest.v1.sha256"
    manifest = load_canonical(manifest_path)
    lstat_regular(sidecar_path)
    manifest_bytes = manifest_path.read_bytes()
    manifest_hash = sha256_bytes(manifest_bytes)
    require(sidecar_path.read_bytes() == manifest_hash.encode("ascii"), "manifest sidecar")
    require(manifest.get("schemaVersion") == 1, "evidence manifest schema version")
    policy = policy_identity()
    require(manifest.get("evidencePolicy") == {"policyID": policy["policyID"], "hash": policy["hash"]}, "manifest policy identity")
    artifacts = manifest.get("artifacts")
    scenarios = manifest.get("scenarioResults")
    require(isinstance(artifacts, list), "manifest artifacts")
    require(isinstance(scenarios, list) and scenarios, "manifest scenarios")
    assert_sorted_unique(artifacts, lambda item: item["artifactID"], "manifest artifacts")
    assert_sorted_unique(scenarios, lambda item: item["scenarioID"], "manifest scenarios")
    declared_files = set()
    declared_tree_prefixes = []
    artifact_ids = set()
    artifacts_by_id = {artifact["artifactID"]: artifact for artifact in artifacts}
    for artifact in artifacts:
        artifact_id = artifact["artifactID"]
        artifact_ids.add(artifact_id)
        artifact_relative = artifact["relativePath"]
        validate_relative_path(artifact_relative)
        require(artifact_relative.startswith("artifacts/"), f"artifact root: {artifact_id}")
        artifact_path = package / artifact_relative
        kind = artifact.get("artifactKind")
        require(kind in ("file", "tree"), f"artifact kind: {artifact_id}")
        if kind == "file":
            data = artifact_path.read_bytes() if lstat_regular(artifact_path) else b""
            file_info = artifact.get("file")
            require(isinstance(file_info, dict), f"artifact file record: {artifact_id}")
            require(file_info.get("byteLength") == len(data), f"artifact bytes: {artifact_id}")
            require(file_info.get("sha256") == sha256_bytes(data), f"artifact hash: {artifact_id}")
            require(file_info.get("mediaType") == CANONICAL_MEDIA, f"artifact media: {artifact_id}")
            declared_files.add(artifact_relative)
        else:
            require(artifact.get("role") == "releaseCandidateAppTree", "tree artifact role")
            tree_info = artifact.get("tree")
            require(isinstance(tree_info, dict), "tree artifact record")
            manifest_artifact = artifacts_by_id.get(tree_info.get("manifestArtifactID"))
            require(
                isinstance(manifest_artifact, dict)
                and manifest_artifact.get("role") == "releaseCandidateInput",
                "tree manifest artifact",
            )
            candidate_path = package / manifest_artifact["relativePath"]
            candidate_input = load_canonical(candidate_path)
            tree_root = artifact_path
            metadata = tree_root.lstat()
            require(
                stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode),
                "tree artifact root",
            )
            entries = candidate_input["appBundleContentManifest"]["entries"]
            total_bytes = sum(
                entry.get("byteLength", 0)
                for entry in entries
                if entry["nodeType"] == "file"
            )
            require(tree_info.get("entryCount") == len(entries), "tree entry count")
            require(tree_info.get("totalFileByteLength") == total_bytes, "tree total bytes")
            require(
                tree_info.get("treeContentHash")
                == candidate_input["candidate"]["appBundleContentHash"],
                "tree content hash",
            )
            expected_paths = {
                entry["relativePath"][:-1]
                if entry["nodeType"] == "directory"
                else entry["relativePath"]
                for entry in entries
            }
            actual_tree_paths = {
                path.relative_to(tree_root).as_posix()
                for path in tree_root.rglob("*")
            }
            require(actual_tree_paths == expected_paths, "tree artifact path coverage")
            declared_tree_prefixes.append(artifact_relative + "/")
        require(artifact.get("sensitivityClass") in ("public", "internal", "restricted"), f"artifact sensitivity: {artifact_id}")
        require(artifact.get("redactionState") in ("notRequired", "redacted", "manuallyReviewed"), f"artifact redaction: {artifact_id}")
    actual = set()
    artifact_root = package / "artifacts"
    if artifact_root.exists():
        for path in artifact_root.rglob("*"):
            if path.is_dir():
                require(not path.is_symlink(), "artifact directory symlink")
                continue
            lstat_regular(path)
            actual.add(path.relative_to(package).as_posix())
    require(
        all(
            path in declared_files
            or any(path.startswith(prefix) for prefix in declared_tree_prefixes)
            for path in actual
        ),
        "artifact path coverage",
    )
    require(declared_files <= actual, "declared file artifact coverage")
    for scenario in scenarios:
        require(set(scenario.get("artifactIDs", [])) <= artifact_ids, f"scenario artifact ref: {scenario.get('scenarioID')}")
        require(scenario.get("outcome") in ("passed", "failed", "unknown"), "scenario outcome")
        require(scenario.get("applicability") in ("applicable", "notApplicable"), "scenario applicability")
    validation_status = manifest.get("validationStatus")
    require(validation_status == {"integrity": "valid", "privacy": "valid", "rawCleanup": "valid", "retention": "valid"}, "manifest validation status")
    report = {
        "manifestSHA256": manifest_hash,
        "packageID": manifest["evidenceRunID"],
        "packageKind": "evidenceRun",
        "schemaVersion": 1,
        "validationStatus": validation_status,
    }
    output = ROOT / output_value
    require(output.parent.parent == package.parent or "build/evidence/objects" in output.as_posix(), "validation output root")
    write_canonical_atomic(output, report)
    return report


def package_byte_length(package: Path) -> int:
    total = 0
    for path in package.rglob("*"):
        if path.is_dir():
            require(not path.is_symlink(), "package directory symlink")
            continue
        metadata = lstat_regular(path)
        total += metadata.st_size
        require(total <= (1 << 63) - 1, "package byte length overflow")
    return total


def bootstrap_store_root(objects_root: Path) -> Path:
    root = objects_root.parent / "bootstrap-store"
    return verified_store_root(root)


def configured_durable_store_values() -> Tuple[str, Path]:
    configured_root = os.environ.get(DURABLE_ROOT_ENV)
    configured_binding = os.environ.get(DURABLE_BINDING_ENV)
    require(
        configured_root is not None and configured_binding is not None,
        "durable store root and binding ID are required",
    )
    require(configured_root != "" and configured_binding != "", "durable store configuration empty")
    binding_id = validate_opaque_id(configured_binding, "durable binding ID")
    require(binding_id != BOOTSTRAP_BINDING_ID, "durable binding must differ from bootstrap")
    root = Path(configured_root)
    require(root.is_absolute(), "durable store root must be absolute")
    require(".." not in root.parts, "durable store root traversal")
    require(not root.is_symlink(), "durable store root symlink")
    resolved = root.resolve(strict=False)
    repository = ROOT.resolve(strict=True)
    require(
        resolved != repository and repository not in resolved.parents,
        "durable store root must be outside repository",
    )
    return binding_id, resolved


def durable_store_root(objects_root: Path) -> Path:
    _, root = configured_durable_store_values()
    return verified_store_root(root)


def verified_store_root(root: Path) -> Path:
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    metadata = root.lstat()
    require(
        stat.S_ISDIR(metadata.st_mode) and not stat.S_ISLNK(metadata.st_mode),
        "store root type",
    )
    require(metadata.st_uid == os.getuid(), "store root owner")
    require(metadata.st_mode & 0o077 == 0, "store root permissions")
    for name in ("packages", "holds", "working-ledgers"):
        child = root / name
        child.mkdir(mode=0o700, exist_ok=True)
        child_metadata = child.lstat()
        require(
            stat.S_ISDIR(child_metadata.st_mode)
            and not stat.S_ISLNK(child_metadata.st_mode),
            f"store {name} type",
        )
        require(child_metadata.st_uid == os.getuid(), f"store {name} owner")
        require(child_metadata.st_mode & 0o077 == 0, f"store {name} permissions")
    return root


def store_root_for_binding(
    binding_id: str, objects_root: Path, *, writable: bool = False
) -> Path:
    validate_opaque_id(binding_id, "evidence store binding ID")
    if binding_id == BOOTSTRAP_BINDING_ID:
        require(not writable or binding_id == BOOTSTRAP_BINDING_ID, "bootstrap store writable")
        return bootstrap_store_root(objects_root)
    configured_binding, _ = configured_durable_store_values()
    require(binding_id == configured_binding, "unsupported store binding")
    return durable_store_root(objects_root)


def configured_durable_binding(objects_root: Path) -> Tuple[str, Path]:
    binding_id, _ = configured_durable_store_values()
    root = store_root_for_binding(binding_id, objects_root, writable=True)
    probe_id = str(uuid.uuid4())
    temporary = root / f".write-probe-{probe_id}.tmp"
    committed = root / f".write-probe-{probe_id}.committed"
    payload = b"pulsephone-evidence-store-v1"
    descriptor = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, committed)
        directory_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
        with committed.open("rb") as stream:
            require(stream.read() == payload, "durable store read/write probe")
        committed.unlink()
        directory_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary.exists():
            temporary.unlink()
        if committed.exists():
            committed.unlink()
    return binding_id, root


def verify_durable_store_configuration_contract(objects_root: Path) -> int:
    original_root = os.environ.get(DURABLE_ROOT_ENV)
    original_binding = os.environ.get(DURABLE_BINDING_ENV)
    test_count = 0

    def configure(root: str | None, binding: str | None) -> None:
        if root is None:
            os.environ.pop(DURABLE_ROOT_ENV, None)
        else:
            os.environ[DURABLE_ROOT_ENV] = root
        if binding is None:
            os.environ.pop(DURABLE_BINDING_ENV, None)
        else:
            os.environ[DURABLE_BINDING_ENV] = binding

    def expect_error(message: str, callback: Any) -> None:
        nonlocal test_count
        try:
            callback()
        except ContractError as error:
            require(str(error) == message, f"durable store expected error: {message}")
            test_count += 1
            return
        raise ContractError(f"durable store expected failure: {message}")

    try:
        configure(None, None)
        expect_error(
            "durable store root and binding ID are required",
            lambda: configured_durable_binding(objects_root),
        )
        configure("/tmp/pulsephone-root-only", None)
        expect_error(
            "durable store root and binding ID are required",
            lambda: configured_durable_binding(objects_root),
        )
        configure(None, "durable-self-test-v1")
        expect_error(
            "durable store root and binding ID are required",
            lambda: configured_durable_binding(objects_root),
        )
        configure("relative/store", "durable-self-test-v1")
        expect_error(
            "durable store root must be absolute",
            lambda: configured_durable_binding(objects_root),
        )
        forbidden = ROOT / "build/evidence/durable-self-test-forbidden"
        require(not forbidden.exists(), "durable self-test repository path precondition")
        configure(str(forbidden), "durable-self-test-v1")
        expect_error(
            "durable store root must be outside repository",
            lambda: configured_durable_binding(objects_root),
        )
        require(not forbidden.exists(), "durable repository rejection must be zero-write")
        with tempfile.TemporaryDirectory(prefix="pulsephone-durable-store-test-") as temporary_value:
            temporary_root = Path(temporary_value)
            actual = temporary_root / "actual"
            actual.mkdir(mode=0o700)
            link = temporary_root / "link"
            link.symlink_to(actual, target_is_directory=True)
            configure(str(link), "durable-self-test-v1")
            expect_error(
                "durable store root symlink",
                lambda: configured_durable_binding(objects_root),
            )
            public_root = temporary_root / "public"
            public_root.mkdir(mode=0o755)
            configure(str(public_root), "durable-self-test-v1")
            expect_error(
                "store root permissions",
                lambda: configured_durable_binding(objects_root),
            )
            external = temporary_root / "external"
            configure(str(external), "durable-self-test-v1")
            binding_id, resolved = configured_durable_binding(objects_root)
            require(binding_id == "durable-self-test-v1", "durable self-test binding")
            require(resolved == external.resolve(strict=True), "durable self-test root")
            require(
                sorted(path.name for path in external.iterdir())
                == ["holds", "packages", "working-ledgers"],
                "durable self-test probe cleanup",
            )
            expect_error(
                "unsupported store binding",
                lambda: store_root_for_binding("durable-foreign-v1", objects_root),
            )
            test_count += 1
    finally:
        configure(original_root, original_binding)
    return test_count


def package_manifest_path(package: Path) -> Tuple[str, Path]:
    evidence = package / "evidence-manifest.v1.json"
    release = package / "release-evidence-manifest.v1.json"
    present = [path for path in (evidence, release) if path.exists()]
    require(len(present) == 1, "package manifest path")
    return ("evidenceRun", evidence) if present[0] == evidence else ("releaseStageManifest", release)


def package_identity(package: Path) -> Dict[str, Any]:
    package_kind, manifest_path = package_manifest_path(package)
    manifest = load_canonical(manifest_path)
    manifest_bytes = manifest_path.read_bytes()
    manifest_hash = sha256_bytes(manifest_bytes)
    if package_kind == "evidenceRun":
        package_id = validate_opaque_id(manifest.get("evidenceRunID"), "evidence run ID")
        package_state = "finalized"
        release_flow = manifest.get("releaseFlow")
        release_flow_id = release_flow.get("releaseFlowID") if isinstance(release_flow, dict) else None
        binding_id = (
            release_flow.get("evidenceStoreBindingID")
            if isinstance(release_flow, dict)
            else BOOTSTRAP_BINDING_ID
        )
    else:
        package_id = validate_opaque_id(manifest.get("stageManifestID"), "stage manifest ID")
        package_state = (
            "formalProvisional"
            if manifest.get("manifestState") == "formalProvisional"
            else "finalized"
        )
        release_flow_id = validate_opaque_id(manifest.get("releaseFlowID"), "release flow ID", 64)
        binding_id = validate_opaque_id(
            manifest.get("evidenceStoreBindingID"), "evidence store binding ID"
        )
    return {
        "bindingID": binding_id,
        "manifest": manifest,
        "manifestBytes": manifest_bytes,
        "manifestPath": manifest_path,
        "manifestSHA256": manifest_hash,
        "packageID": package_id,
        "packageKind": package_kind,
        "packageState": package_state,
        "releaseFlowID": release_flow_id,
    }


def copy_package_immutable(package: Path, stored_package: Path) -> None:
    if stored_package.exists():
        _, existing_manifest = package_manifest_path(stored_package)
        _, source_manifest = package_manifest_path(package)
        require(
            sha256_bytes(existing_manifest.read_bytes())
            == sha256_bytes(source_manifest.read_bytes()),
            "immutable store collision",
        )
        return
    temporary = Path(tempfile.mkdtemp(prefix=".package.", dir=str(stored_package.parent)))
    try:
        destination = temporary / "package"
        for source in package.rglob("*"):
            target = destination / source.relative_to(package)
            metadata = source.lstat()
            require(not stat.S_ISLNK(metadata.st_mode), "store source symlink")
            if stat.S_ISDIR(metadata.st_mode):
                target.mkdir(mode=0o700, parents=True, exist_ok=True)
            else:
                require(
                    stat.S_ISREG(metadata.st_mode) and metadata.st_nlink == 1,
                    "store source node",
                )
                target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                shutil.copyfile(source, target)
                os.chmod(target, 0o600)
        os.replace(destination, stored_package)
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)


def store_record_hash(record: Mapping[str, Any]) -> str:
    return domain_hash(STORE_RECORD_DOMAIN, record)


def store_put(
    package_value: str,
    validation_value: str,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    package = ROOT / package_value
    validation = load_canonical(ROOT / validation_value)
    identity = package_identity(package)
    manifest = identity["manifest"]
    manifest_hash = identity["manifestSHA256"]
    require(validation.get("manifestSHA256") == manifest_hash, "validation manifest hash")
    require(validation.get("packageKind") == identity["packageKind"], "validation package kind")
    require(validation.get("packageID") == identity["packageID"], "validation package ID")
    require(
        validation.get("validationStatus")
        == {
            "integrity": "valid",
            "privacy": "valid",
            "rawCleanup": "valid",
            "retention": "valid",
        },
        "store validation status",
    )
    binding_id = identity["bindingID"]
    store_root = store_root_for_binding(binding_id, objects_root, writable=True)
    package_id = identity["packageID"]
    ref_domain = "pulsephone.evidence-store-ref.v1"
    manifest_store_ref = "ref-" + sha256_bytes(
        ref_domain.encode("ascii")
        + b"\0"
        + binding_id.encode("ascii")
        + b"\0"
        + identity["packageKind"].encode("ascii")
        + b"\0"
        + package_id.encode("ascii")
        + b"\0"
        + manifest_hash.encode("ascii")
    )
    packages_root = store_root / "packages"
    stored_package = packages_root / manifest_hash
    copy_package_immutable(package, stored_package)
    record_key = artifact_path_key("evidenceStoreRecord", manifest_store_ref)
    record_root = objects_root / record_key
    record_path = record_root / "evidence-store-record.v1.json"
    if record_path.exists():
        existing = load_canonical(record_path)
        require(
            existing.get("manifestSHA256") == manifest_hash
            and existing.get("evidenceStoreBindingID") == binding_id,
            "store record collision",
        )
        return relative_path(record_path)
    record = {
        "evidencePolicy": manifest["evidencePolicy"],
        "evidenceStoreBindingID": binding_id,
        "immutabilityState": "immutable",
        "manifestSHA256": manifest_hash,
        "manifestStoreRef": manifest_store_ref,
        "packageByteLength": package_byte_length(package),
        "packageID": package_id,
        "packageKind": identity["packageKind"],
        "packageState": identity["packageState"],
        "retentionClass": manifest.get("retentionClass", "candidateRun"),
        "schemaVersion": 1,
        "storedAtUTC": utc_now(),
        "validationStatus": validation["validationStatus"],
    }
    if identity["releaseFlowID"] is not None:
        record["releaseFlowID"] = identity["releaseFlowID"]
    record_root.mkdir(mode=0o700)
    write_canonical_atomic(record_path, record)
    return relative_path(record_path)


def store_resolve(record_value: str, objects_root_value: str) -> Tuple[Dict[str, Any], Path]:
    objects_root = verified_objects_root(objects_root_value)
    record_path = ROOT / record_value
    record = load_canonical(record_path)
    binding_id = validate_opaque_id(
        record.get("evidenceStoreBindingID"), "evidence store binding ID"
    )
    validate_opaque_id(record.get("manifestStoreRef"), "manifest store ref")
    expected_key = artifact_path_key("evidenceStoreRecord", record["manifestStoreRef"])
    require(record_path.parent == objects_root / expected_key, "store record path key")
    stored_package = (
        store_root_for_binding(binding_id, objects_root)
        / "packages"
        / record["manifestSHA256"]
    )
    require(stored_package.is_dir() and not stored_package.is_symlink(), "stored package missing")
    return record, stored_package


def store_verify(record_value: str, objects_root_value: str) -> Dict[str, Any]:
    record, stored_package = store_resolve(record_value, objects_root_value)
    package_kind, manifest_path = package_manifest_path(stored_package)
    manifest = load_canonical(manifest_path)
    manifest_hash = sha256_bytes(manifest_path.read_bytes())
    require(record.get("manifestSHA256") == manifest_hash, "stored manifest hash")
    package_id = (
        manifest.get("evidenceRunID")
        if package_kind == "evidenceRun"
        else manifest.get("stageManifestID")
    )
    require(record.get("packageKind") == package_kind, "stored package kind")
    require(record.get("packageID") == package_id, "stored package ID")
    require(record.get("evidencePolicy") == manifest.get("evidencePolicy"), "stored policy identity")
    expected_flow = (
        manifest.get("releaseFlow", {}).get("releaseFlowID")
        if package_kind == "evidenceRun"
        else manifest.get("releaseFlowID")
    )
    require(record.get("releaseFlowID") == expected_flow, "stored release flow")
    expected_binding = (
        manifest.get("releaseFlow", {}).get("evidenceStoreBindingID")
        if package_kind == "evidenceRun" and manifest.get("releaseFlow")
        else manifest.get("evidenceStoreBindingID")
        if package_kind == "releaseStageManifest"
        else record.get("evidenceStoreBindingID")
    )
    require(record.get("evidenceStoreBindingID") == expected_binding, "stored binding")
    return {
        "evidenceStoreBindingID": record["evidenceStoreBindingID"],
        "manifestSHA256": manifest_hash,
        "manifestStoreRef": record["manifestStoreRef"],
        "outcome": "valid",
        "packageID": record["packageID"],
        "packageKind": package_kind,
        "storeRecordSHA256": store_record_hash(record),
        "schemaVersion": 1,
    }


def store_fetch(record_value: str, objects_root_value: str) -> str:
    record, stored_package = store_resolve(record_value, objects_root_value)
    store_verify(record_value, objects_root_value)
    domain = (
        "evidenceRunPackage"
        if record["packageKind"] == "evidenceRun"
        else "releaseStagePackage"
    )
    key = artifact_path_key(domain, record["packageID"])
    destination = verified_objects_root(objects_root_value) / key
    if destination.exists():
        _, existing_manifest = package_manifest_path(destination)
        existing = sha256_bytes(existing_manifest.read_bytes())
        require(existing == record["manifestSHA256"], "fetch destination collision")
        return relative_path(destination)
    temporary = Path(tempfile.mkdtemp(prefix=".fetch.", dir=str(destination.parent)))
    try:
        shutil.copytree(stored_package, temporary / "package", symlinks=False)
        os.replace(temporary / "package", destination)
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)
    return relative_path(destination)


def stored_artifact_bytes(
    record_value: str,
    relative_value: str,
    objects_root_value: str,
) -> bytes:
    validate_relative_path(relative_value)
    record, stored_package = store_resolve(record_value, objects_root_value)
    store_verify(record_value, objects_root_value)
    require(relative_value.startswith("artifacts/"), "stored artifact fixed root")
    path = stored_package / relative_value
    return path.read_bytes() if lstat_regular(path) else b""


def store_fetch_subtree(
    record_value: str,
    artifact_id: str,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    record, stored_package = store_resolve(record_value, objects_root_value)
    store_verify(record_value, objects_root_value)
    require(record.get("packageKind") == "evidenceRun", "subtree package kind")
    manifest = load_canonical(stored_package / "evidence-manifest.v1.json")
    matches = [
        artifact
        for artifact in manifest.get("artifacts", [])
        if artifact.get("artifactID") == artifact_id
    ]
    require(len(matches) == 1, "subtree artifact ID")
    artifact = matches[0]
    require(
        artifact.get("artifactKind") == "tree"
        and artifact.get("role") == "releaseCandidateAppTree",
        "subtree artifact kind",
    )
    manifest_id = artifact["tree"]["manifestArtifactID"]
    input_artifacts = [
        item
        for item in manifest["artifacts"]
        if item.get("artifactID") == manifest_id
        and item.get("role") == "releaseCandidateInput"
    ]
    require(len(input_artifacts) == 1, "subtree candidate input artifact")
    input_path = stored_package / input_artifacts[0]["relativePath"]
    candidate_input = load_canonical(input_path)
    candidate_hash = release_candidate_input_hash(candidate_input)
    source = stored_package / artifact["relativePath"]
    destination = typed_object_path(
        objects_root,
        "releaseCandidateAppTree",
        candidate_hash,
        "PulsePhone.app",
    )
    if destination.exists():
        require(destination.is_dir() and not destination.is_symlink(), "subtree destination")
    else:
        destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        temporary = Path(
            tempfile.mkdtemp(prefix=".candidate-tree.", dir=str(destination.parent))
        )
        try:
            shutil.copytree(source, temporary / "PulsePhone.app", symlinks=False)
            os.replace(temporary / "PulsePhone.app", destination)
        finally:
            if temporary.exists():
                shutil.rmtree(temporary)
    require(
        artifact["tree"]["treeContentHash"]
        == candidate_input["candidate"]["appBundleContentHash"],
        "subtree candidate content hash",
    )
    return relative_path(destination)


def reviewed_input_from_record(
    record_value: str, objects_root_value: str
) -> Tuple[Dict[str, Any], Dict[str, Any], Dict[str, Any]]:
    record, stored_package = store_resolve(record_value, objects_root_value)
    verified = store_verify(record_value, objects_root_value)
    require(record.get("packageKind") == "evidenceRun", "review record package kind")
    manifest = load_canonical(stored_package / "evidence-manifest.v1.json")
    require("releaseFlow" not in manifest and "candidate" not in manifest, "review record flow neutrality")
    require(manifest.get("retentionClass") == "legalMaterial", "review record retention")
    matches = [
        artifact
        for artifact in manifest.get("artifacts", [])
        if artifact.get("role") == "reviewedDevelopmentCandidateInput"
    ]
    require(len(matches) == 1, "reviewed development input cardinality")
    artifact = matches[0]
    require(artifact.get("artifactKind") == "file", "reviewed input artifact kind")
    path = stored_package / artifact["relativePath"]
    reviewed = load_canonical(path)
    require(
        artifact.get("file", {}).get("sha256") == sha256_bytes(path.read_bytes()),
        "reviewed input artifact hash",
    )
    require(
        reviewed.get("sourceCommit") == manifest.get("runnerSource", {}).get("gitCommit"),
        "reviewed input runner source continuity",
    )
    return reviewed, manifest, {**verified, "record": record}


def verify_reviewed_record(
    candidate_value: str,
    reviewed_record_value: str,
    objects_root_value: str,
) -> Dict[str, Any]:
    fresh, fresh_hash, _ = load_typed_candidate(
        candidate_value, objects_root_value, "developmentAssembly"
    )
    reviewed, manifest, verified = reviewed_input_from_record(
        reviewed_record_value, objects_root_value
    )
    verify_reviewed_continuity(reviewed, fresh)
    return {
        "freshCandidateInputHash": fresh_hash,
        "outcome": "passed",
        "reviewedCandidateInputHash": sha256_bytes(canonical_bytes(reviewed)),
        "reviewedEvidenceRunID": manifest["evidenceRunID"],
        "sourceBindingID": verified["record"]["evidenceStoreBindingID"],
        "schemaVersion": 1,
    }


def create_release_flow(
    candidate_value: str,
    reviewed_record_value: str,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    continuity = verify_reviewed_record(
        candidate_value, reviewed_record_value, objects_root_value
    )
    binding_id, _ = configured_durable_binding(objects_root)
    release_flow_id = f"flow-{uuid.uuid4()}"
    value = {
        "createdAtUTC": utc_now(),
        "evidenceStoreBindingID": binding_id,
        "releaseFlowID": release_flow_id,
        "schemaVersion": 1,
    }
    path = typed_object_path(
        objects_root, "releaseFlow", release_flow_id, "release-flow.v1.json"
    )
    require(not path.exists(), "release flow path collision")
    path.parent.mkdir(mode=0o700)
    write_canonical_atomic(path, value)
    require(continuity["outcome"] == "passed", "reviewed continuity")
    return relative_path(path)


def load_release_flow(flow_value: str, objects_root_value: str) -> Dict[str, Any]:
    objects_root = verified_objects_root(objects_root_value)
    path = ROOT / flow_value
    flow = load_canonical(path)
    require(flow.get("schemaVersion") == 1, "release flow schema version")
    flow_id = validate_opaque_id(flow.get("releaseFlowID"), "release flow ID", 64)
    binding_id = validate_opaque_id(
        flow.get("evidenceStoreBindingID"), "evidence store binding ID"
    )
    require(
        path
        == typed_object_path(
            objects_root, "releaseFlow", flow_id, "release-flow.v1.json"
        ),
        "release flow typed path",
    )
    configured_binding, _ = configured_durable_store_values()
    require(binding_id == configured_binding, "release flow configured binding")
    store_root_for_binding(binding_id, objects_root)
    return flow


def import_flow_neutral(
    source_record_value: str,
    alpha_record_value: str,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    reviewed, source_manifest, _ = reviewed_input_from_record(
        source_record_value, objects_root_value
    )
    alpha_record, alpha_package = store_resolve(alpha_record_value, objects_root_value)
    store_verify(alpha_record_value, objects_root_value)
    require(alpha_record.get("packageKind") == "releaseStageManifest", "alpha package kind")
    alpha = load_canonical(alpha_package / "release-evidence-manifest.v1.json")
    require(
        alpha.get("releaseStage") == "internalAlpha"
        and alpha.get("manifestState") == "immutableStageResult"
        and alpha.get("stageOutcome") == "passed",
        "passing alpha required",
    )
    fresh = alpha.get("releaseGateProfile", {}).get("releaseInput", {}).get("candidateInput")
    require(isinstance(fresh, dict), "alpha candidate input")
    verify_reviewed_continuity(reviewed, fresh)
    target_binding = alpha.get("evidenceStoreBindingID")
    require(target_binding == alpha_record.get("evidenceStoreBindingID"), "alpha record binding")
    source_record, source_package = store_resolve(source_record_value, objects_root_value)
    if source_record.get("evidenceStoreBindingID") == target_binding:
        return source_record_value
    require(source_manifest.get("evidencePolicy") == alpha.get("evidencePolicy"), "flow-neutral current policy")
    target_root = store_root_for_binding(target_binding, objects_root, writable=True)
    manifest_hash = source_record["manifestSHA256"]
    copy_package_immutable(source_package, target_root / "packages" / manifest_hash)
    manifest_store_ref = "ref-" + sha256_bytes(
        b"pulsephone.evidence-store-ref.v1\0"
        + target_binding.encode("ascii")
        + b"\0evidenceRun\0"
        + source_record["packageID"].encode("ascii")
        + b"\0"
        + manifest_hash.encode("ascii")
    )
    record = dict(source_record)
    record["evidenceStoreBindingID"] = target_binding
    record["manifestStoreRef"] = manifest_store_ref
    record["storedAtUTC"] = utc_now()
    record.pop("releaseFlowID", None)
    path = typed_object_path(
        objects_root,
        "evidenceStoreRecord",
        manifest_store_ref,
        "evidence-store-record.v1.json",
    )
    if path.exists():
        existing = load_canonical(path)
        comparable_existing = dict(existing)
        comparable_record = dict(record)
        comparable_existing.pop("storedAtUTC", None)
        comparable_record.pop("storedAtUTC", None)
        require(comparable_existing == comparable_record, "flow-neutral import collision")
        record = existing
    else:
        path.parent.mkdir(mode=0o700)
        write_canonical_atomic(path, record)
    return relative_path(path)


def create_release_hold(
    record_value: str,
    release_flow_value: str,
    reason: str,
    objects_root_value: str,
) -> str:
    flow = load_release_flow(release_flow_value, objects_root_value)
    return create_release_hold_for_flow(
        record_value, flow, reason, objects_root_value
    )


def create_release_hold_for_flow(
    record_value: str,
    flow: Mapping[str, Any],
    reason: str,
    objects_root_value: str,
) -> str:
    require(reason in ("thresholdFreeze", "selectedForRelease", "legalMaterial"), "hold reason")
    objects_root = verified_objects_root(objects_root_value)
    record, package = store_resolve(record_value, objects_root_value)
    verified = store_verify(record_value, objects_root_value)
    require(record.get("evidenceStoreBindingID") == flow["evidenceStoreBindingID"], "hold binding")
    manifest_kind, manifest_path = package_manifest_path(package)
    manifest = load_canonical(manifest_path)
    package_flow = (
        manifest.get("releaseFlow", {}).get("releaseFlowID")
        if manifest_kind == "evidenceRun"
        else manifest.get("releaseFlowID")
    )
    if reason != "legalMaterial":
        require(package_flow == flow["releaseFlowID"], "hold release flow")
    else:
        require(package_flow is None, "legal hold package flow")
    hold_identity = sha256_bytes(
        b"pulsephone.evidence-release-hold.v1\0"
        + record["manifestStoreRef"].encode("ascii")
        + b"\0"
        + flow["releaseFlowID"].encode("ascii")
        + b"\0"
        + reason.encode("ascii")
    )
    hold_id = "hold-" + hold_identity
    hold = {
        "appliedAtUTC": utc_now(),
        "evidencePolicy": manifest["evidencePolicy"],
        "evidenceStoreBindingID": flow["evidenceStoreBindingID"],
        "holdReason": reason,
        "manifestSHA256": record["manifestSHA256"],
        "manifestStoreRef": record["manifestStoreRef"],
        "releaseFlowID": flow["releaseFlowID"],
        "releaseHoldID": hold_id,
        "schemaVersion": 1,
        "storeRecordSHA256": verified["storeRecordSHA256"],
    }
    candidate = manifest.get("candidate")
    if isinstance(candidate, dict):
        hold["candidate"] = candidate
    backend_path = (
        store_root_for_binding(flow["evidenceStoreBindingID"], objects_root, writable=True)
        / "holds"
        / f"{hold_id}.json"
    )
    if backend_path.exists():
        existing = load_canonical(backend_path)
        comparable_existing = dict(existing)
        comparable_hold = dict(hold)
        comparable_existing.pop("appliedAtUTC", None)
        comparable_hold.pop("appliedAtUTC", None)
        require(comparable_existing == comparable_hold, "release hold conflict")
        hold = existing
    else:
        write_canonical_atomic(backend_path, hold)
    output = typed_object_path(
        objects_root, "evidenceReleaseHold", hold_id, "evidence-release-hold.v1.json"
    )
    if output.exists():
        require(load_canonical(output) == hold, "release hold output collision")
    else:
        output.parent.mkdir(mode=0o700)
        write_canonical_atomic(output, hold)
    return relative_path(output)


def verify_release_hold(hold_value: str, objects_root_value: str) -> Dict[str, Any]:
    objects_root = verified_objects_root(objects_root_value)
    path = ROOT / hold_value
    hold = load_canonical(path)
    hold_id = validate_opaque_id(hold.get("releaseHoldID"), "release hold ID")
    require(
        path
        == typed_object_path(
            objects_root,
            "evidenceReleaseHold",
            hold_id,
            "evidence-release-hold.v1.json",
        ),
        "release hold typed path",
    )
    binding_id = hold.get("evidenceStoreBindingID")
    backend = store_root_for_binding(binding_id, objects_root) / "holds" / f"{hold_id}.json"
    require(load_canonical(backend) == hold, "release hold backend bytes")
    return {
        "evidenceStoreBindingID": binding_id,
        "holdReason": hold["holdReason"],
        "outcome": "valid",
        "releaseFlowID": hold["releaseFlowID"],
        "releaseHoldID": hold_id,
        "schemaVersion": 1,
    }


def record_path_for_ref(
    manifest_store_ref: str, objects_root_value: str
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    return relative_path(
        typed_object_path(
            objects_root,
            "evidenceStoreRecord",
            manifest_store_ref,
            "evidence-store-record.v1.json",
        )
    )


def stage_lineage_records(
    provisional_record_value: str, objects_root_value: str
) -> Tuple[List[str], List[str], Dict[str, Any], Dict[str, Any]]:
    provisional_record, provisional_package = store_resolve(
        provisional_record_value, objects_root_value
    )
    store_verify(provisional_record_value, objects_root_value)
    provisional = load_canonical(
        provisional_package / "release-evidence-manifest.v1.json"
    )
    require(
        provisional.get("releaseStage") == "formalRelease"
        and provisional.get("manifestState") == "formalProvisional"
        and provisional.get("stageOutcome") == "passed",
        "Formal provisional record required",
    )
    provisional_profile = provisional["releaseGateProfile"]
    provisional_selection = load_canonical(
        provisional_package / "artifacts/evidence-selection-set.v1.json"
    )
    provisional_outcome, _ = evaluate_selection(
        provisional_profile, provisional_selection
    )
    require(provisional_outcome == "passed", "Formal provisional evaluation")
    stage_records = [provisional_record_value]
    run_records = []
    current = provisional
    expected_stages = ["externalBeta", "internalAlpha"]
    for expected_stage in expected_stages:
        pointer = current.get("previousStageManifest")
        require(isinstance(pointer, dict), "stage lineage pointer")
        record_path = record_path_for_ref(
            pointer["manifestStoreRef"], objects_root_value
        )
        record, package = store_resolve(record_path, objects_root_value)
        verified = store_verify(record_path, objects_root_value)
        require(
            record["manifestSHA256"] == pointer["manifestSHA256"]
            and verified["storeRecordSHA256"] == pointer["storeRecordSHA256"],
            "stage lineage pointer hashes",
        )
        current = load_canonical(package / "release-evidence-manifest.v1.json")
        require(
            current.get("releaseStage") == expected_stage
            and current.get("manifestState") == "immutableStageResult"
            and current.get("stageOutcome") == "passed",
            "passing stage lineage",
        )
        stage_records.append(record_path)
    for stage_record_value in stage_records:
        _, stage_package = store_resolve(stage_record_value, objects_root_value)
        stage_manifest = load_canonical(
            stage_package / "release-evidence-manifest.v1.json"
        )
        for selected in stage_manifest.get("selectedEvidenceRuns", []):
            run_records.append(
                record_path_for_ref(
                    selected["manifestStoreRef"], objects_root_value
                )
            )
    run_records = sorted(set(run_records))
    return stage_records, run_records, provisional, provisional_record


def hold_selected_lineage(
    provisional_record_value: str,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    stage_records, run_records, provisional, provisional_record = stage_lineage_records(
        provisional_record_value, objects_root_value
    )
    flow = {
        "evidenceStoreBindingID": provisional["evidenceStoreBindingID"],
        "releaseFlowID": provisional["releaseFlowID"],
    }
    hold_entries = []
    for record_value in [*run_records, *stage_records]:
        hold_path = create_release_hold_for_flow(
            record_value, flow, "selectedForRelease", objects_root_value
        )
        hold = load_canonical(ROOT / hold_path)
        record, _ = store_resolve(record_value, objects_root_value)
        hold_entries.append(
            {
                "holdAppliedAtUTC": hold["appliedAtUTC"],
                "holdReason": "selectedForRelease",
                "manifestSHA256": record["manifestSHA256"],
                "manifestStoreRef": record["manifestStoreRef"],
                "packageID": record["packageID"],
                "packageKind": record["packageKind"],
                "releaseHoldID": hold["releaseHoldID"],
                "storeRecordSHA256": hold["storeRecordSHA256"],
            }
        )
    hold_entries.sort(key=lambda item: (item["packageKind"], item["packageID"]))
    hold_set_id = f"hold-set-{uuid.uuid4()}"
    provisional_verified = store_verify(
        provisional_record_value, objects_root_value
    )
    hold_set = {
        "evidenceStoreBindingID": flow["evidenceStoreBindingID"],
        "formalProvisionalManifestSHA256": provisional_record["manifestSHA256"],
        "formalProvisionalManifestStoreRef": provisional_record["manifestStoreRef"],
        "formalProvisionalStageManifestID": provisional_record["packageID"],
        "formalProvisionalStoreRecordSHA256": provisional_verified[
            "storeRecordSHA256"
        ],
        "holdSetID": hold_set_id,
        "holds": hold_entries,
        "releaseFlowID": flow["releaseFlowID"],
        "schemaVersion": 1,
    }
    validate_hold_set(hold_set)
    path = typed_object_path(
        objects_root, "releaseHoldSet", hold_set_id, "release-hold-set.v1.json"
    )
    path.parent.mkdir(mode=0o700)
    write_canonical_atomic(path, hold_set)
    return relative_path(path)


def finalize_formal_release(
    provisional_record_value: str,
    hold_set_value: str,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    provisional_record, provisional_package = store_resolve(
        provisional_record_value, objects_root_value
    )
    provisional_verified = store_verify(
        provisional_record_value, objects_root_value
    )
    provisional = load_canonical(
        provisional_package / "release-evidence-manifest.v1.json"
    )
    require(provisional.get("manifestState") == "formalProvisional", "Formal provisional input")
    hold_set_path = ROOT / hold_set_value
    hold_set = load_canonical(hold_set_path)
    hold_set_hash = validate_hold_set(hold_set)
    require(
        hold_set["formalProvisionalStageManifestID"]
        == provisional_record["packageID"]
        and hold_set["formalProvisionalManifestSHA256"]
        == provisional_record["manifestSHA256"]
        and hold_set["formalProvisionalStoreRecordSHA256"]
        == provisional_verified["storeRecordSHA256"],
        "hold set provisional pointer",
    )
    hold_by_ref = {item["manifestStoreRef"]: item for item in hold_set["holds"]}
    expected_stage_records, expected_run_records, _, _ = stage_lineage_records(
        provisional_record_value, objects_root_value
    )
    expected_refs = set()
    for record_value in [*expected_stage_records, *expected_run_records]:
        record, _ = store_resolve(record_value, objects_root_value)
        expected_refs.add(record["manifestStoreRef"])
    require(set(hold_by_ref) == expected_refs, "hold set exact lineage coverage")
    final_id = f"stage-{uuid.uuid4()}"
    package = typed_object_path(
        objects_root,
        "releaseStagePackage",
        final_id,
        "release-evidence-manifest.v1.json",
    ).parent
    (package / "artifacts").mkdir(mode=0o700, parents=True)
    shutil.copyfile(
        provisional_package / "artifacts/evidence-selection-set.v1.json",
        package / "artifacts/evidence-selection-set.v1.json",
    )
    shutil.copyfile(hold_set_path, package / "artifacts/release-hold-set.v1.json")
    final = dict(provisional)
    final["formalFinalization"] = {
        "artifactRelativePath": "artifacts/release-hold-set.v1.json",
        "releaseHoldSetHash": hold_set_hash,
        "releaseHoldSetID": hold_set["holdSetID"],
    }
    final["generatedAtUTC"] = utc_now()
    final["manifestState"] = "immutableStageResult"
    final["stageManifestID"] = final_id
    selected = []
    for item in provisional["selectedEvidenceRuns"]:
        hold = hold_by_ref[item["manifestStoreRef"]]
        selected.append(
            {
                **item,
                "holdAppliedAtUTC": hold["holdAppliedAtUTC"],
                "releaseHoldID": hold["releaseHoldID"],
            }
        )
    final["selectedEvidenceRuns"] = selected
    manifest_path = package / "release-evidence-manifest.v1.json"
    manifest_bytes = canonical_bytes(final)
    manifest_path.write_bytes(manifest_bytes)
    os.chmod(manifest_path, 0o600)
    sidecar = package / "release-evidence-manifest.v1.sha256"
    sidecar.write_bytes(sha256_bytes(manifest_bytes).encode("ascii"))
    os.chmod(sidecar, 0o600)
    return relative_path(package)


def publish_final_release(
    final_stage_record_value: str,
    final_stage_hold_value: str,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    final_record, final_package = store_resolve(
        final_stage_record_value, objects_root_value
    )
    final_verified = store_verify(final_stage_record_value, objects_root_value)
    require(final_record.get("packageKind") == "releaseStageManifest", "final record kind")
    final_manifest_path = final_package / "release-evidence-manifest.v1.json"
    final_manifest = load_canonical(final_manifest_path)
    require(
        final_manifest.get("releaseStage") == "formalRelease"
        and final_manifest.get("manifestState") == "immutableStageResult"
        and final_manifest.get("stageOutcome") == "passed",
        "passing final Formal stage required",
    )
    outcome_path = typed_object_path(
        objects_root,
        "stageGateOutcomeReport",
        final_manifest["stageManifestID"],
        "stage-gate-outcome-report.v1.json",
    )
    outcome_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    outcome_report, outcome_status = evaluate_stage_record(
        final_stage_record_value,
        "stageResult",
        relative_path(outcome_path),
        objects_root_value,
    )
    require(outcome_status == 0 and outcome_report["outcome"] == "passed", "final stage evaluation")
    final_hold = load_canonical(ROOT / final_stage_hold_value)
    verify_release_hold(final_stage_hold_value, objects_root_value)
    require(
        final_hold.get("holdReason") == "selectedForRelease"
        and final_hold.get("manifestStoreRef") == final_record["manifestStoreRef"]
        and final_hold.get("storeRecordSHA256")
        == final_verified["storeRecordSHA256"],
        "final stage hold",
    )
    selection = load_canonical(
        final_package / "artifacts/evidence-selection-set.v1.json"
    )
    candidate_scenarios = []
    for entry in selection["entries"]:
        if entry["requirementID"] == "T-002/signed-notarized-stapled-bundle-l5":
            candidate_scenarios.extend(entry["selectedScenarios"])
    require(len(candidate_scenarios) == 1, "unique selected candidate scenario")
    candidate_pointer = candidate_scenarios[0]
    candidate_record_path = record_path_for_ref(
        candidate_pointer["manifestStoreRef"], objects_root_value
    )
    candidate_record, candidate_package = store_resolve(
        candidate_record_path, objects_root_value
    )
    candidate_verified = store_verify(candidate_record_path, objects_root_value)
    require(
        candidate_record["manifestSHA256"] == candidate_pointer["manifestSHA256"]
        and candidate_verified["storeRecordSHA256"]
        == candidate_pointer["storeRecordSHA256"],
        "selected candidate store pointer",
    )
    candidate_manifest = load_canonical(
        candidate_package / "evidence-manifest.v1.json"
    )
    input_artifacts = [
        artifact
        for artifact in candidate_manifest["artifacts"]
        if artifact["role"] == "releaseCandidateInput"
    ]
    tree_artifacts = [
        artifact
        for artifact in candidate_manifest["artifacts"]
        if artifact["role"] == "releaseCandidateAppTree"
    ]
    require(len(input_artifacts) == 1 and len(tree_artifacts) == 1, "candidate artifact pair")
    selected_projection = next(
        item
        for item in final_manifest["selectedEvidenceRuns"]
        if item["evidenceRunID"] == candidate_manifest["evidenceRunID"]
    )
    hold_set = load_canonical(
        final_package / "artifacts/release-hold-set.v1.json"
    )
    hold_set_hash = validate_hold_set(hold_set)
    candidate_hold = next(
        item
        for item in hold_set["holds"]
        if item["manifestStoreRef"] == candidate_record["manifestStoreRef"]
    )
    require(
        selected_projection.get("releaseHoldID") == candidate_hold["releaseHoldID"],
        "candidate selected hold",
    )
    candidate_input_path = candidate_package / input_artifacts[0]["relativePath"]
    candidate_input = load_canonical(candidate_input_path)
    candidate_input_hash = release_candidate_input_hash(candidate_input)
    require(
        candidate_input
        == final_manifest["releaseGateProfile"]["releaseInput"]["candidateInput"],
        "published candidate profile identity",
    )
    candidate_tree = store_fetch_subtree(
        candidate_record_path, tree_artifacts[0]["artifactID"], objects_root_value
    )
    candidate_tree_path = ROOT / candidate_tree
    codesign = subprocess.run(
        [
            "/usr/bin/codesign",
            "--verify",
            "--deep",
            "--strict",
            "--verbose=2",
            str(candidate_tree_path),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    require(codesign.returncode == 0, "candidate code signature validation")
    developer_dir = subprocess.run(
        ["/usr/bin/xcode-select", "-p"],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout.strip()
    staple = subprocess.run(
        ["/usr/bin/xcrun", "stapler", "validate", str(candidate_tree_path)],
        env={**os.environ, "DEVELOPER_DIR": developer_dir},
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    require(staple.returncode == 0, "candidate staple validation")
    dist = ROOT / "dist"
    dist.mkdir(mode=0o755, exist_ok=True)
    lock_path = ROOT / "build/evidence/dist-publish.lock"
    lock_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        require(
            not (dist / "PulsePhone.app").exists()
            and not (dist / "release-evidence-manifest.json").exists()
            and not (dist / "release-evidence-manifest.sha256").exists(),
            "dist output already exists",
        )
        temporary = Path(tempfile.mkdtemp(prefix=".publish.", dir=str(dist)))
        try:
            shutil.copytree(
                candidate_tree_path,
                temporary / "PulsePhone.app",
                symlinks=False,
            )
            manifest_bytes = final_manifest_path.read_bytes()
            (temporary / "release-evidence-manifest.json").write_bytes(
                manifest_bytes
            )
            detached_bytes = sha256_bytes(manifest_bytes).encode("ascii")
            (temporary / "release-evidence-manifest.sha256").write_bytes(
                detached_bytes
            )
            os.replace(temporary / "PulsePhone.app", dist / "PulsePhone.app")
            os.replace(
                temporary / "release-evidence-manifest.json",
                dist / "release-evidence-manifest.json",
            )
            os.replace(
                temporary / "release-evidence-manifest.sha256",
                dist / "release-evidence-manifest.sha256",
            )
        finally:
            if temporary.exists():
                shutil.rmtree(temporary)
    finally:
        os.close(lock_fd)
    report = {
        "distDetachedHashSHA256": sha256_bytes(
            (dist / "release-evidence-manifest.sha256").read_bytes()
        ),
        "distManifestSHA256": sha256_bytes(
            (dist / "release-evidence-manifest.json").read_bytes()
        ),
        "evidenceStoreBindingID": final_manifest["evidenceStoreBindingID"],
        "finalManifestSHA256": final_record["manifestSHA256"],
        "finalManifestStoreRef": final_record["manifestStoreRef"],
        "finalStageGateOutcomeReport": outcome_report,
        "finalStageGateOutcomeReportHash": domain_hash(
            STAGE_OUTCOME_DOMAIN, outcome_report
        ),
        "finalStageHoldAppliedAtUTC": final_hold["appliedAtUTC"],
        "finalStageManifestID": final_manifest["stageManifestID"],
        "finalStageReleaseHoldID": final_hold["releaseHoldID"],
        "finalStoreRecordSHA256": final_verified["storeRecordSHA256"],
        "outcome": "passed",
        "publicReleaseScopeIdentityHash": final_manifest[
            "publicReleaseScopeIdentityHash"
        ],
        "publishedCandidate": {
            "appBundleContentHash": candidate_input["candidate"][
                "appBundleContentHash"
            ],
            "codeSignatureValidation": "passed",
            "evidenceRunID": candidate_manifest["evidenceRunID"],
            "manifestSHA256": candidate_record["manifestSHA256"],
            "manifestStoreRef": candidate_record["manifestStoreRef"],
            "releaseCandidateAppTreeArtifactID": tree_artifacts[0][
                "artifactID"
            ],
            "releaseCandidateInputArtifactID": input_artifacts[0][
                "artifactID"
            ],
            "releaseCandidateInputHash": candidate_input_hash,
            "releaseHoldID": candidate_hold["releaseHoldID"],
            "stapleValidation": "passed",
            "storeRecordSHA256": candidate_verified["storeRecordSHA256"],
        },
        "releaseFlowID": final_manifest["releaseFlowID"],
        "releaseHoldSetHash": hold_set_hash,
        "releaseHoldSetID": hold_set["holdSetID"],
        "schemaVersion": 1,
        "selectionSetHash": domain_hash(SELECTION_DOMAIN, selection),
        "selectionSetID": selection["selectionSetID"],
    }
    output = ROOT / "build/gates/final-release-evidence.json"
    write_canonical_atomic(output, report)
    return relative_path(output)


def checkpoint_wal(
    release_flow_value: str,
    wal_value: str,
    expected_previous_revision: int,
    objects_root_value: str,
) -> Dict[str, Any]:
    objects_root = verified_objects_root(objects_root_value)
    flow = load_release_flow(release_flow_value, objects_root_value)
    wal = load_canonical(ROOT / wal_value)
    return checkpoint_wal_value(
        flow, wal, expected_previous_revision, objects_root_value
    )


def checkpoint_wal_value(
    flow: Mapping[str, Any],
    wal: Mapping[str, Any],
    expected_previous_revision: int,
    objects_root_value: str,
) -> Dict[str, Any]:
    objects_root = verified_objects_root(objects_root_value)
    require(wal.get("releaseFlowID") == flow["releaseFlowID"], "WAL release flow")
    require(wal.get("evidenceStoreBindingID") == flow["evidenceStoreBindingID"], "WAL binding")
    ledger_id = validate_opaque_id(wal.get("ledgerID"), "ledger ID", 64)
    revision = wal.get("checkpointRevision")
    require(
        isinstance(revision, int)
        and revision == expected_previous_revision + 1
        and revision >= 1,
        "WAL contiguous revision",
    )
    wal_hash = domain_hash(WAL_DOMAIN, wal)
    root = (
        store_root_for_binding(flow["evidenceStoreBindingID"], objects_root, writable=True)
        / "working-ledgers"
        / flow["releaseFlowID"]
        / ledger_id
    )
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    current = root / "current.v1.json"
    if expected_previous_revision == 0:
        require(not current.exists(), "WAL expected initial revision")
    else:
        previous = load_canonical(current)
        require(previous.get("checkpointRevision") == expected_previous_revision, "WAL compare-and-swap")
    write_canonical_atomic(current, wal)
    write_canonical_atomic(root / f"revision-{revision}.v1.json", wal)
    return {
        "checkpointRevision": revision,
        "ledgerID": ledger_id,
        "schemaVersion": 1,
        "walHash": wal_hash,
    }


def fetch_wal(
    release_flow_value: str, ledger_id: str, objects_root_value: str
) -> Dict[str, Any]:
    objects_root = verified_objects_root(objects_root_value)
    flow = load_release_flow(release_flow_value, objects_root_value)
    validate_opaque_id(ledger_id, "ledger ID", 64)
    path = (
        store_root_for_binding(flow["evidenceStoreBindingID"], objects_root)
        / "working-ledgers"
        / flow["releaseFlowID"]
        / ledger_id
        / "current.v1.json"
    )
    wal = load_canonical(path)
    return {"schemaVersion": 1, "wal": wal, "walHash": domain_hash(WAL_DOMAIN, wal)}


def seal_wal(
    release_flow_value: str,
    ledger_id: str,
    expected_revision: int,
    expected_wal_hash: str,
    objects_root_value: str,
) -> Dict[str, Any]:
    fetched = fetch_wal(release_flow_value, ledger_id, objects_root_value)
    wal = fetched["wal"]
    require(wal.get("checkpointRevision") == expected_revision, "WAL seal revision")
    require(fetched["walHash"] == expected_wal_hash, "WAL seal hash")
    require(wal.get("seriesState") == "finalized", "WAL series not finalized")
    attempts = wal.get("attempts")
    require(isinstance(attempts, list) and attempts, "WAL attempts")
    for index, attempt in enumerate(attempts, 1):
        require(attempt.get("attemptIndex") == index, "WAL attempt index")
        require(attempt.get("phase") == "terminal", "WAL unterminated attempt")
        require(attempt.get("outcome") == "passed", "WAL non-passing attempt")
    ledger = {
        "attempts": [
            {key: value for key, value in attempt.items() if key != "phase"}
            for attempt in attempts
        ],
        "environmentProfileHash": wal["environmentProfileHash"],
        "ledgerID": wal["ledgerID"],
        "ledgerState": "finalized",
        "schemaVersion": 1,
        "scopeProjectionHash": wal["scopeProjectionHash"],
        "stageRunCohortID": wal["stageRunCohortID"],
        "stageRunSeriesID": wal["stageRunSeriesID"],
    }
    return {"ledger": ledger, "ledgerHash": domain_hash(LEDGER_DOMAIN, ledger), "schemaVersion": 1}


def candidate_from_record(
    record_value: str, objects_root_value: str
) -> Tuple[Dict[str, Any], str, Dict[str, Any], Dict[str, Any]]:
    record, package = store_resolve(record_value, objects_root_value)
    verified = store_verify(record_value, objects_root_value)
    require(record.get("packageKind") == "evidenceRun", "candidate record package kind")
    manifest = load_canonical(package / "evidence-manifest.v1.json")
    matches = [
        artifact
        for artifact in manifest.get("artifacts", [])
        if artifact.get("role") == "releaseCandidateInput"
    ]
    trees = [
        artifact
        for artifact in manifest.get("artifacts", [])
        if artifact.get("role") == "releaseCandidateAppTree"
    ]
    require(len(matches) == 1 and len(trees) == 1, "candidate artifact cardinality")
    candidate_path = package / matches[0]["relativePath"]
    candidate = load_canonical(candidate_path)
    candidate_hash = release_candidate_input_hash(candidate)
    require(candidate.get("candidateKind") == "signedNotarized", "final candidate kind")
    require(manifest.get("candidate") == candidate.get("candidate"), "candidate manifest identity")
    require(
        manifest.get("runnerSource", {}).get("gitCommit") == candidate.get("sourceCommit"),
        "candidate producer source identity",
    )
    return candidate, candidate_hash, manifest, {**verified, "record": record}


def aggregate_outcomes(values: Sequence[str]) -> str:
    require(all(value in ("passed", "failed", "unknown") for value in values), "outcome enum")
    if "failed" in values:
        return "failed"
    if "unknown" in values:
        return "unknown"
    return "passed"


def public_scope_from_candidate(candidate: Mapping[str, Any]) -> List[Dict[str, Any]]:
    grouped: Dict[bytes, Dict[str, Any]] = {}
    for atomic in candidate.get("catalogExposedScopes", []):
        scope_kind = atomic.get("scopeKind")
        require(scope_kind in ("host", "device"), "catalog public scope kind")
        if scope_kind == "host":
            geometry: Dict[str, Any] = {
                "host": {"architecture": "arm64", "minimumMacOS": "14.0.0"},
                "scopeKind": "host",
            }
        else:
            geometry = {
                "device": {
                    "deviceClass": atomic.get("deviceClass"),
                    "osClaim": atomic.get("osClaim"),
                },
                "scopeKind": "device",
            }
        key = canonical_bytes(geometry)
        value = grouped.setdefault(
            key,
            {
                **geometry,
                "nonCommandFeatureIDs": [],
                "productActionIDs": [],
            },
        )
        if "productActionID" in atomic:
            value["productActionIDs"].append(atomic["productActionID"])
        if "nonCommandFeatureID" in atomic:
            value["nonCommandFeatureIDs"].append(atomic["nonCommandFeatureID"])
    scopes = []
    for value in grouped.values():
        value["productActionIDs"] = sorted(set(value["productActionIDs"]))
        value["nonCommandFeatureIDs"] = sorted(set(value["nonCommandFeatureIDs"]))
        if value["productActionIDs"] or value["nonCommandFeatureIDs"]:
            scopes.append(value)
    return sorted(scopes, key=canonical_bytes)


def next_major(value: str, delta: int) -> str:
    major, minor, patch = version_tuple(value)
    require(minor == 0 and patch == 0, "major boundary required")
    next_value = major + delta
    require(0 <= next_value <= 65535, "major boundary overflow")
    return f"{next_value}.0.0"


def connected_alpha_device() -> Dict[str, str]:
    developer_dir = subprocess.run(
        ["/usr/bin/xcode-select", "-p"],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout.strip()
    with tempfile.NamedTemporaryFile(prefix="pulsephone-devices-", suffix=".json") as output:
        subprocess.run(
            [
                "/usr/bin/xcrun",
                "devicectl",
                "list",
                "devices",
                "--json-output",
                output.name,
            ],
            check=True,
            env={**os.environ, "DEVELOPER_DIR": developer_dir},
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        payload = json.loads(Path(output.name).read_text(encoding="utf-8"))
    candidates = []
    for device in payload.get("result", {}).get("devices", []):
        hardware = device.get("hardwareProperties", {})
        properties = device.get("deviceProperties", {})
        connection = device.get("connectionProperties", {})
        if (
            hardware.get("deviceType") != "iPhone"
            or hardware.get("reality") != "physical"
            or connection.get("transportType") != "wired"
            or connection.get("pairingState") != "paired"
        ):
            continue
        version = properties.get("osVersionNumber")
        build = properties.get("osBuildUpdate")
        product_type = hardware.get("productType")
        if not all(isinstance(value, str) and value for value in (version, build, product_type)):
            continue
        normalized_parts = version.split(".")
        while len(normalized_parts) < 3:
            normalized_parts.append("0")
        normalized = ".".join(normalized_parts)
        version_tuple(normalized)
        candidates.append(
            {
                "deviceClass": "iPhone",
                "osBuild": build,
                "osVersion": normalized,
                "productType": product_type,
            }
        )
    require(candidates, "no paired physical wired iPhone for Internal Alpha")
    candidates.sort(key=lambda item: (version_tuple(item["osVersion"]), item["osBuild"]))
    return candidates[-1]


def alpha_exact_release_scopes(
    proposed: Sequence[Mapping[str, Any]], device: Mapping[str, str]
) -> List[Dict[str, Any]]:
    merged: Dict[bytes, Dict[str, Any]] = {}
    for scope in proposed:
        if scope["scopeKind"] == "host":
            merged[canonical_bytes(scope)] = dict(scope)
            continue
        claim = scope["device"]["osClaim"]
        broad = claim.get("boundedVersionRange")
        if not isinstance(broad, dict):
            continue
        if not (
            version_tuple(broad["minimumInclusive"])
            <= version_tuple(device["osVersion"])
            < version_tuple(broad["maximumExclusive"])
        ):
            continue
        geometry = {
            "device": {
                "deviceClass": device["deviceClass"],
                "osClaim": {
                    "claimKind": "exactBuildSet",
                    "exactBuilds": [
                        {
                            "osBuild": device["osBuild"],
                            "osVersion": device["osVersion"],
                        }
                    ],
                },
            },
            "scopeKind": "device",
        }
        key = canonical_bytes(geometry)
        target = merged.setdefault(
            key,
            {
                **geometry,
                "nonCommandFeatureIDs": [],
                "productActionIDs": [],
            },
        )
        target["nonCommandFeatureIDs"] = sorted(
            set(target["nonCommandFeatureIDs"])
            | set(scope["nonCommandFeatureIDs"])
        )
        target["productActionIDs"] = sorted(
            set(target["productActionIDs"]) | set(scope["productActionIDs"])
        )
    return sorted(merged.values(), key=canonical_bytes)


def exact_evidence_observations(
    record_values: Sequence[str], objects_root_value: str
) -> List[Dict[str, Any]]:
    observations = []
    for record_value in record_values:
        record, package = store_resolve(record_value, objects_root_value)
        verified = store_verify(record_value, objects_root_value)
        require(record.get("packageKind") == "evidenceRun", "coverage evidence package kind")
        manifest = load_canonical(package / "evidence-manifest.v1.json")
        for scenario in manifest.get("scenarioResults", []):
            if scenario.get("requirementID") not in (
                "T-004/exact-os-build-claim-evidence-l4",
                "T-021/device-matrix-exact-build-l4",
            ):
                continue
            device = scenario.get("scopeProjection", {}).get("device")
            if not isinstance(device, dict):
                continue
            os_version = device.get("osVersion")
            os_build = device.get("osBuild")
            if not isinstance(os_version, str) or not isinstance(os_build, str):
                continue
            observations.append(
                {
                    "evidenceRef": {
                        "evidenceRunID": manifest["evidenceRunID"],
                        "manifestSHA256": record["manifestSHA256"],
                        "manifestStoreRef": record["manifestStoreRef"],
                        "requirementID": scenario["requirementID"],
                        "scenarioID": scenario["scenarioID"],
                        "storeRecordSHA256": verified["storeRecordSHA256"],
                    },
                    "osBuild": os_build,
                    "osVersion": os_version,
                    "outcome": scenario["outcome"],
                }
            )
    observations.sort(
        key=lambda item: (
            item["osVersion"],
            item["osBuild"],
            item["evidenceRef"]["requirementID"],
            item["evidenceRef"]["scenarioID"],
            item["evidenceRef"]["evidenceRunID"],
        )
    )
    return observations


def build_broad_os_coverage(
    candidate_record_value: str,
    negative_removal_plan_value: str,
    evidence_record_values: Sequence[str],
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    candidate, candidate_hash, candidate_manifest, candidate_verified = candidate_from_record(
        candidate_record_value, objects_root_value
    )
    plan = load_canonical(ROOT / negative_removal_plan_value)
    validate_negative_removal_plan(plan)
    require(
        plan["releaseFlowID"]
        == candidate_manifest.get("releaseFlow", {}).get("releaseFlowID"),
        "coverage plan flow",
    )
    require(
        plan["evidenceStoreBindingID"]
        == candidate_verified["record"]["evidenceStoreBindingID"],
        "coverage plan binding",
    )
    proposed = public_scope_from_candidate(candidate)
    broad = [
        scope
        for scope in proposed
        if scope.get("scopeKind") == "device"
        and scope.get("device", {}).get("osClaim", {}).get("claimKind")
        == "boundedVersionRange"
    ]
    require(broad, "no broad OS claim")
    observations = exact_evidence_observations(
        evidence_record_values, objects_root_value
    )
    records = []
    for scope in broad:
        claim_hash = domain_hash("pulsephone.proposed-release-scope.v1", scope)
        os_range = scope["device"]["osClaim"]["boundedVersionRange"]
        minimum = os_range["minimumInclusive"]
        maximum = os_range["maximumExclusive"]
        lower_maximum = next_major(minimum, 1)
        upper_minimum = next_major(maximum, -1)
        require(
            version_tuple(lower_maximum) < version_tuple(upper_minimum),
            "broad range must span at least three majors",
        )
        slot_ranges = [
            ("lowerBoundary", minimum, lower_maximum),
            ("intermediate", lower_maximum, upper_minimum),
            ("upperBoundary", upper_minimum, maximum),
        ]
        slots = []
        for role, slot_minimum, slot_maximum in slot_ranges:
            in_slot = [
                item
                for item in observations
                if version_tuple(slot_minimum)
                <= version_tuple(item["osVersion"])
                < version_tuple(slot_maximum)
            ]
            by_build: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}
            for item in in_slot:
                by_build.setdefault((item["osVersion"], item["osBuild"]), []).append(item)
            passing_pairs = []
            for build_key, items in by_build.items():
                passed_requirements = {
                    item["evidenceRef"]["requirementID"]
                    for item in items
                    if item["outcome"] == "passed"
                }
                if passed_requirements == {
                    "T-004/exact-os-build-claim-evidence-l4",
                    "T-021/device-matrix-exact-build-l4",
                }:
                    passing_pairs.append((build_key, items))
            slot: Dict[str, Any] = {
                "blockerCodes": [],
                "evidenceRefs": [],
                "role": role,
                "slotOutcome": "unknown",
                "slotRange": {
                    "maximumExclusive": slot_maximum,
                    "minimumInclusive": slot_minimum,
                },
            }
            if passing_pairs:
                selected_key, selected_items = sorted(passing_pairs, key=lambda item: item[0])[0]
                slot["slotOutcome"] = "passed"
                slot["representative"] = {
                    "osBuild": selected_key[1],
                    "osVersion": selected_key[0],
                }
                slot["evidenceRefs"] = sorted(
                    [item["evidenceRef"] for item in selected_items],
                    key=lambda item: (
                        item["requirementID"],
                        item["scenarioID"],
                        item["evidenceRunID"],
                    ),
                )
            elif any(item["outcome"] == "failed" for item in in_slot):
                slot["slotOutcome"] = "failed"
                slot["blockerCodes"] = ["coverage.failed-exact-evidence"]
                slot["evidenceRefs"] = [item["evidenceRef"] for item in in_slot]
            else:
                slot["blockerCodes"] = ["coverage.missing-exact-evidence"]
                slot["evidenceRefs"] = [item["evidenceRef"] for item in in_slot]
            slots.append(slot)
        record_outcome = aggregate_outcomes([slot["slotOutcome"] for slot in slots])
        blocker_codes = sorted(
            {code for slot in slots for code in slot["blockerCodes"]}
        )
        records.append(
            {
                "blockerCodes": blocker_codes,
                "claimScopeHash": claim_hash,
                "coverageID": f"coverage-{uuid.uuid4()}",
                "range": os_range,
                "recordOutcome": record_outcome,
                "representativeSlots": slots,
                "schemaVersion": 1,
            }
        )
    records.sort(key=lambda item: item["claimScopeHash"])
    coverage_set_id = f"coverage-set-{uuid.uuid4()}"
    coverage = {
        "candidateInputHash": candidate_hash,
        "coverageOutcome": aggregate_outcomes(
            [record["recordOutcome"] for record in records]
        ),
        "coverageSetID": coverage_set_id,
        "developerImageCatalog": candidate["implementationContractIdentity"][
            "developerImageCatalog"
        ],
        "evaluatedAtUTC": utc_now(),
        "evidenceStoreBindingID": plan["evidenceStoreBindingID"],
        "negativeRemovalPlanHash": domain_hash(NEGATIVE_REMOVAL_DOMAIN, plan),
        "records": records,
        "releaseFlowID": plan["releaseFlowID"],
        "schemaVersion": 1,
    }
    path = typed_object_path(
        objects_root,
        "broadOSCoverageSet",
        coverage_set_id,
        "broad-os-coverage-set.v1.json",
    )
    path.parent.mkdir(mode=0o700)
    write_canonical_atomic(path, coverage)
    return relative_path(path)


def release_gate_scope_variants(
    candidate: Mapping[str, Any], proposed: Sequence[Mapping[str, Any]]
) -> Dict[str, List[Dict[str, Any]]]:
    variants: Dict[str, List[Dict[str, Any]]] = {
        "scope.global": [
            {
                "nonCommandFeatureIDs": [],
                "preparationGroupIDs": [],
                "productActionIDs": [],
                "scopeKind": "global",
            }
        ],
        "scope.host.all-public": [],
        "scope.device.aggregate": [],
        "scope.device.action": [],
        "scope.device.feature": [],
        "scope.device.preparation": [],
    }
    for public_scope in proposed:
        base: Dict[str, Any] = {
            "nonCommandFeatureIDs": list(public_scope["nonCommandFeatureIDs"]),
            "preparationGroupIDs": [],
            "productActionIDs": list(public_scope["productActionIDs"]),
            "scopeKind": public_scope["scopeKind"],
        }
        if public_scope["scopeKind"] == "host":
            base["host"] = public_scope["host"]
            variants["scope.host.all-public"].append(base)
        else:
            device = public_scope["device"]
            os_claim = device["osClaim"]
            gate_device: Dict[str, Any] = {
                "deviceClass": device["deviceClass"]
            }
            if os_claim["claimKind"] == "boundedVersionRange":
                gate_device["osVersionRange"] = os_claim["boundedVersionRange"]
            else:
                exact_builds = os_claim.get("exactBuilds")
                require(
                    isinstance(exact_builds, list) and len(exact_builds) == 1,
                    "Alpha exact build scope",
                )
                gate_device.update(exact_builds[0])
            base["device"] = gate_device
            variants["scope.device.aggregate"].append(base)
            for action_id in base["productActionIDs"]:
                variants["scope.device.action"].append(
                    {**base, "nonCommandFeatureIDs": [], "productActionIDs": [action_id]}
                )
            for feature_id in base["nonCommandFeatureIDs"]:
                variants["scope.device.feature"].append(
                    {**base, "nonCommandFeatureIDs": [feature_id], "productActionIDs": []}
                )
    for atomic in candidate.get("catalogExposedScopes", []):
        if "preparationGroupID" not in atomic:
            continue
        atomic_range = atomic["osClaim"].get("boundedVersionRange")
        for public_scope in proposed:
            if public_scope["scopeKind"] != "device":
                continue
            public_claim = public_scope["device"]["osClaim"]
            gate_device: Dict[str, Any] = {
                "deviceClass": atomic["deviceClass"],
                "route": atomic.get("route", "none"),
            }
            if public_claim["claimKind"] == "exactBuildSet":
                exact = public_claim["exactBuilds"][0]
                if not (
                    version_tuple(atomic_range["minimumInclusive"])
                    <= version_tuple(exact["osVersion"])
                    < version_tuple(atomic_range["maximumExclusive"])
                ):
                    continue
                gate_device.update(exact)
            else:
                public_range = public_claim["boundedVersionRange"]
                if public_range != atomic_range:
                    continue
                gate_device["osVersionRange"] = public_range
            variants["scope.device.preparation"].append(
                {
                    "device": gate_device,
                    "nonCommandFeatureIDs": [],
                    "preparationGroupIDs": [atomic["preparationGroupID"]],
                    "productActionIDs": [],
                    "scopeKind": "device",
                }
            )
    for key, values in variants.items():
        unique = {canonical_bytes(value): value for value in values}
        variants[key] = [unique[item] for item in sorted(unique)]
    return variants


def version_tuple(value: str) -> Tuple[int, int, int]:
    parts = value.split(".")
    require(len(parts) == 3 and all(part.isdigit() for part in parts), "canonical version")
    result = tuple(int(part) for part in parts)
    require(all(0 <= part <= 65535 for part in result), "version component")
    return result  # type: ignore[return-value]


def subject_matches(
    subject: Mapping[str, Any], scope: Mapping[str, Any]
) -> Dict[str, Any] | None:
    mode = subject.get("selectionMode")
    if mode == "allMatched":
        selected = dict(scope)
    elif mode == "none":
        selected = {
            **scope,
            "nonCommandFeatureIDs": [],
            "preparationGroupIDs": [],
            "productActionIDs": [],
        }
    else:
        require(mode == "explicit", "subject selection mode")
        actions = sorted(
            set(scope.get("productActionIDs", []))
            & set(subject.get("productActionIDs", []))
        )
        features = sorted(
            set(scope.get("nonCommandFeatureIDs", []))
            & set(subject.get("nonCommandFeatureIDs", []))
        )
        preparations = sorted(
            set(scope.get("preparationGroupIDs", []))
            & set(subject.get("preparationGroupIDs", []))
        )
        routes = set(subject.get("routes", []))
        route_matches = not routes or scope.get("device", {}).get("route") in routes
        if not route_matches or not (actions or features or preparations or routes):
            return None
        selected = {
            **scope,
            "nonCommandFeatureIDs": features,
            "preparationGroupIDs": preparations,
            "productActionIDs": actions,
        }
    applicability = subject.get("applicabilityRuleID")
    if applicability is not None:
        device = selected.get("device")
        if not isinstance(device, dict):
            return None
        os_range = device.get("osVersionRange")
        if applicability == "scope.device-os-claim-is-broad-range.v1":
            if not isinstance(os_range, dict):
                return None
        elif applicability == "scope.device-os-claim-intersects-ios14-16.v1":
            if isinstance(os_range, dict):
                if not (
                    version_tuple(os_range["minimumInclusive"]) < (17, 0, 0)
                    and version_tuple(os_range["maximumExclusive"]) > (14, 0, 0)
                ):
                    return None
            else:
                os_version = device.get("osVersion")
                if not isinstance(os_version, str) or not (
                    (14, 0, 0) <= version_tuple(os_version) < (17, 0, 0)
                ):
                    return None
        else:
            raise ContractError(f"unknown applicability rule: {applicability}")
    return selected


def derive_profile_requirements(
    release_stage: str,
    candidate: Mapping[str, Any],
    proposed: Sequence[Mapping[str, Any]],
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]], List[Dict[str, Any]]]:
    policy = load_canonical(ROOT / POLICY_ROOT)
    requirements = load_requirements()
    presets = {item["stageBindingPresetID"]: item for item in policy["stageBindingPresets"]}
    subjects = {item["subjectSetID"]: item for item in policy["subjectSets"]}
    environments = {item["profileID"]: item for item in policy["environmentProfiles"]}
    variants = release_gate_scope_variants(candidate, proposed)
    cohort_by_requirement: Dict[str, Mapping[str, Any]] = {}
    for cohort in policy["currentCandidateMultiplicity"]["cohorts"]:
        if cohort["releaseStage"] == release_stage:
            for requirement_id in cohort["requirementIDs"]:
                cohort_by_requirement[requirement_id] = cohort
    tuples: List[Dict[str, Any]] = []
    scope_by_hash: Dict[str, Dict[str, Any]] = {}
    used_environments: Dict[str, Dict[str, Any]] = {}
    for requirement_id, requirement in requirements.items():
        preset = presets[requirement["stageBindingPresetID"]]
        subject = subjects[requirement["subjectSetID"]]
        for binding in preset["bindings"]:
            if binding["releaseStage"] != release_stage:
                continue
            for raw_scope in variants[binding["scopeBindingID"]]:
                scope = subject_matches(subject, raw_scope)
                if scope is None:
                    continue
                scope_hash = domain_hash("pulsephone.release-gate-scope.v1", scope)
                environment = environments[binding["environmentProfileID"]]
                environment_hash = domain_hash(
                    "pulsephone.evidence-environment-profile.v1", environment
                )
                row: Dict[str, Any] = {
                    "environmentProfileHash": environment_hash,
                    "environmentProfileID": environment["profileID"],
                    "requiredDistinctPassingScenarioCount": policy[
                        "currentCandidateMultiplicity"
                    ]["defaultRequiredDistinctPassingScenarioCount"],
                    "requiredStageRunOrdinals": [],
                    "requirementID": requirement_id,
                    "scopeProjectionHash": scope_hash,
                    "verificationID": requirement["verificationID"],
                }
                cohort = cohort_by_requirement.get(requirement_id)
                if cohort is not None:
                    row["requiredDistinctPassingScenarioCount"] = cohort[
                        "requiredDistinctPassingScenarioCount"
                    ]
                    row["requiredStageRunOrdinals"] = cohort[
                        "requiredStageRunOrdinals"
                    ]
                    row["stageRunCohortID"] = cohort["cohortID"]
                tuples.append(row)
                scope_by_hash[scope_hash] = scope
                used_environments[environment["profileID"]] = environment
    tuples.sort(
        key=lambda item: (
            item["requirementID"],
            item["verificationID"],
            item["scopeProjectionHash"],
            item["environmentProfileHash"],
        )
    )
    tuple_keys = [canonical_bytes(item) for item in tuples]
    require(len(tuple_keys) == len(set(tuple_keys)), "duplicate release profile tuple")
    require(len(tuples) <= HARD_CAPS["releaseGateRequirements"], "release profile cap")
    scopes = [scope_by_hash[key] for key in sorted(scope_by_hash)]
    environment_values = [used_environments[key] for key in sorted(used_environments)]
    return tuples, scopes, environment_values


def threshold_freeze_projection(
    record_value: str,
    hold_value: str,
    flow: Mapping[str, Any],
    objects_root_value: str,
) -> Tuple[Dict[str, Any], str, Dict[str, Any]]:
    record, package = store_resolve(record_value, objects_root_value)
    verified = store_verify(record_value, objects_root_value)
    require(record.get("packageKind") == "evidenceRun", "threshold freeze package kind")
    manifest = load_canonical(package / "evidence-manifest.v1.json")
    require(
        manifest.get("releaseFlow", {}).get("releaseFlowID")
        == flow["releaseFlowID"],
        "threshold freeze flow",
    )
    require(
        record.get("evidenceStoreBindingID") == flow["evidenceStoreBindingID"],
        "threshold freeze binding",
    )
    by_role: Dict[str, List[Mapping[str, Any]]] = {}
    for artifact in manifest.get("artifacts", []):
        by_role.setdefault(artifact["role"], []).append(artifact)
    required_roles = {
        "performanceThresholdApproval": "approval",
        "performanceThresholdDecision": "decision",
        "performanceThresholdProfile": "profile",
    }
    loaded: Dict[str, Tuple[Mapping[str, Any], Dict[str, Any], str]] = {}
    for role, short_name in required_roles.items():
        matches = by_role.get(role, [])
        require(len(matches) == 1, f"threshold freeze {role} cardinality")
        artifact = matches[0]
        path = package / artifact["relativePath"]
        loaded[short_name] = (
            artifact,
            load_canonical(path),
            sha256_bytes(path.read_bytes()),
        )
    hold = load_canonical(ROOT / hold_value)
    verify_release_hold(hold_value, objects_root_value)
    require(
        hold.get("holdReason") == "thresholdFreeze"
        and hold.get("manifestStoreRef") == record["manifestStoreRef"]
        and hold.get("storeRecordSHA256") == verified["storeRecordSHA256"],
        "threshold freeze hold",
    )
    freeze = {
        "approvalArtifactID": loaded["approval"][0]["artifactID"],
        "approvalArtifactSHA256": loaded["approval"][2],
        "decisionArtifactID": loaded["decision"][0]["artifactID"],
        "decisionArtifactSHA256": loaded["decision"][2],
        "freezeEvidenceRunID": manifest["evidenceRunID"],
        "freezeHoldAppliedAtUTC": hold["appliedAtUTC"],
        "freezeHoldID": hold["releaseHoldID"],
        "freezeManifestSHA256": record["manifestSHA256"],
        "freezeManifestStoreRef": record["manifestStoreRef"],
        "freezeStoreRecordSHA256": verified["storeRecordSHA256"],
        "profileArtifactID": loaded["profile"][0]["artifactID"],
        "profileArtifactSHA256": loaded["profile"][2],
    }
    profile = loaded["profile"][1]
    return profile, domain_hash(
        "pulsephone.performance-threshold-profile.v1", profile
    ), freeze


def build_release_profile(
    stage: str,
    release_flow_value: str | None,
    candidate_input_value: str | None,
    candidate_record_value: str | None,
    reviewed_record_value: str | None,
    negative_removal_plan_value: str | None,
    threshold_freeze_record_value: str | None,
    threshold_freeze_hold_value: str | None,
    lineage_record_value: str | None,
    broad_coverage_value: str | None,
    objects_root_value: str,
) -> str:
    require(stage in ("internalAlpha", "externalBeta", "formalRelease"), "release stage")
    objects_root = verified_objects_root(objects_root_value)
    policy = policy_identity()
    previous_pointer = None
    previous_profile: Mapping[str, Any] = {}
    if stage == "formalRelease":
        require(lineage_record_value is not None, "Formal lineage record required")
        record, package = store_resolve(lineage_record_value, objects_root_value)
        verified = store_verify(lineage_record_value, objects_root_value)
        previous = load_canonical(package / "release-evidence-manifest.v1.json")
        require(
            previous.get("releaseStage") == "externalBeta"
            and previous.get("manifestState") == "immutableStageResult"
            and previous.get("stageOutcome") == "passed",
            "passing Beta lineage required",
        )
        previous_profile = previous["releaseGateProfile"]
        candidate = previous_profile["releaseInput"]["candidateInput"]
        candidate_hash = previous_profile["releaseInput"]["candidateInputHash"]
        flow = {
            "releaseFlowID": previous["releaseFlowID"],
            "evidenceStoreBindingID": previous["evidenceStoreBindingID"],
        }
        proposed = previous["proposedReleaseScopes"]
        previous_pointer = {
            "manifestSHA256": record["manifestSHA256"],
            "manifestStoreRef": record["manifestStoreRef"],
            "releaseStage": "externalBeta",
            "stageManifestID": record["packageID"],
            "storeRecordSHA256": verified["storeRecordSHA256"],
        }
    else:
        require(release_flow_value is not None, "release flow required")
        flow = load_release_flow(release_flow_value, objects_root_value)
        if stage == "internalAlpha":
            require(candidate_input_value is not None, "Alpha candidate input required")
            require(candidate_record_value is None, "Alpha candidate record forbidden")
            require(reviewed_record_value is not None, "Alpha reviewed record required")
            verify_reviewed_record(
                candidate_input_value, reviewed_record_value, objects_root_value
            )
            candidate, candidate_hash, _ = load_typed_candidate(
                candidate_input_value, objects_root_value, "developmentAssembly"
            )
            require(negative_removal_plan_value is None, "Alpha removal plan forbidden")
        else:
            require(candidate_record_value is not None, "Beta candidate record required")
            require(candidate_input_value is None, "Beta local candidate forbidden")
            candidate, candidate_hash, candidate_manifest, candidate_verified = candidate_from_record(
                candidate_record_value, objects_root_value
            )
            require(
                candidate_manifest.get("releaseFlow", {}).get("releaseFlowID")
                == flow["releaseFlowID"],
                "Beta candidate flow",
            )
            require(
                candidate_verified["record"]["evidenceStoreBindingID"]
                == flow["evidenceStoreBindingID"],
                "Beta candidate binding",
            )
            require(lineage_record_value is not None, "Beta Alpha lineage required")
            lineage_record, lineage_package = store_resolve(
                lineage_record_value, objects_root_value
            )
            lineage_verified = store_verify(
                lineage_record_value, objects_root_value
            )
            alpha = load_canonical(
                lineage_package / "release-evidence-manifest.v1.json"
            )
            require(
                alpha.get("releaseStage") == "internalAlpha"
                and alpha.get("manifestState") == "immutableStageResult"
                and alpha.get("stageOutcome") == "passed",
                "passing Alpha lineage required",
            )
            require(
                alpha.get("releaseFlowID") == flow["releaseFlowID"]
                and alpha.get("evidenceStoreBindingID")
                == flow["evidenceStoreBindingID"],
                "Alpha lineage flow",
            )
            previous_pointer = {
                "manifestSHA256": lineage_record["manifestSHA256"],
                "manifestStoreRef": lineage_record["manifestStoreRef"],
                "releaseStage": "internalAlpha",
                "stageManifestID": lineage_record["packageID"],
                "storeRecordSHA256": lineage_verified["storeRecordSHA256"],
            }
        proposed = public_scope_from_candidate(candidate)
        if stage == "internalAlpha":
            proposed = alpha_exact_release_scopes(
                proposed, connected_alpha_device()
            )
    tuples, scopes, environments = derive_profile_requirements(stage, candidate, proposed)
    profile_id = f"profile-{uuid.uuid4()}"
    profile: Dict[str, Any] = {
        "environmentProfiles": environments,
        "evidencePolicy": {"hash": policy["hash"], "policyID": policy["policyID"]},
        "evidenceStoreBindingID": flow["evidenceStoreBindingID"],
        "profileID": profile_id,
        "proposedReleaseScopes": proposed,
        "releaseFlowID": flow["releaseFlowID"],
        "releaseInput": {
            "candidateInput": candidate,
            "candidateInputHash": candidate_hash,
        },
        "releaseStage": stage,
        "requirements": tuples,
        "schemaVersion": 1,
        "scopeProjections": scopes,
    }
    if negative_removal_plan_value is not None:
        plan = load_canonical(ROOT / negative_removal_plan_value)
        require(plan.get("releaseFlowID") == flow["releaseFlowID"], "removal plan flow")
        require(plan.get("evidenceStoreBindingID") == flow["evidenceStoreBindingID"], "removal plan binding")
        require(plan.get("resultEvidencePolicy") == profile["evidencePolicy"], "removal plan policy")
        profile["negativeRemovalPlan"] = plan
        profile["negativeRemovalPlanHash"] = domain_hash(NEGATIVE_REMOVAL_DOMAIN, plan)
    require(
        (threshold_freeze_record_value is None)
        == (threshold_freeze_hold_value is None),
        "threshold freeze record and hold must appear together",
    )
    if stage == "externalBeta":
        require(
            threshold_freeze_record_value is not None,
            "Beta threshold freeze required",
        )
    if threshold_freeze_record_value is not None:
        threshold_profile, threshold_hash, threshold_freeze = threshold_freeze_projection(
            threshold_freeze_record_value,
            threshold_freeze_hold_value,
            flow,
            objects_root_value,
        )
        profile["performanceThresholdProfile"] = threshold_profile
        profile["performanceThresholdProfileHash"] = threshold_hash
        profile["performanceThresholdFreeze"] = threshold_freeze
    if broad_coverage_value is not None:
        coverage = load_canonical(ROOT / broad_coverage_value)
        require(coverage.get("coverageOutcome") == "passed", "broad coverage outcome")
        require(coverage.get("candidateInputHash") == candidate_hash, "broad coverage candidate")
        profile["broadOSCoverageSet"] = coverage
        profile["broadOSCoverageSetHash"] = domain_hash(BROAD_COVERAGE_DOMAIN, coverage)
    if previous_pointer is not None:
        profile["previousStageManifest"] = previous_pointer
        for key in (
            "negativeRemovalPlan",
            "negativeRemovalPlanHash",
            "performanceThresholdProfile",
            "performanceThresholdProfileHash",
            "performanceThresholdFreeze",
            "broadOSCoverageSet",
            "broadOSCoverageSetHash",
        ):
            if key in previous_profile:
                profile[key] = previous_profile[key]
    path = typed_object_path(
        objects_root, "releaseGateProfile", profile_id, "release-gate-profile.v1.json"
    )
    path.parent.mkdir(mode=0o700)
    write_canonical_atomic(path, profile)
    return relative_path(path)


def validate_profile(profile: Mapping[str, Any]) -> str:
    require(profile.get("schemaVersion") == 1, "release profile schema version")
    profile_id = validate_opaque_id(profile.get("profileID"), "release profile ID", 64)
    require(profile.get("releaseStage") in ("internalAlpha", "externalBeta", "formalRelease"), "profile stage")
    requirements = profile.get("requirements")
    require(isinstance(requirements, list), "profile requirements")
    keys = [
        (
            item["requirementID"],
            item["verificationID"],
            item["scopeProjectionHash"],
            item["environmentProfileHash"],
        )
        for item in requirements
    ]
    require(keys == sorted(set(keys)), "profile requirement ordering")
    scope_hashes = {
        domain_hash("pulsephone.release-gate-scope.v1", scope)
        for scope in profile.get("scopeProjections", [])
    }
    environment_hashes = {
        domain_hash("pulsephone.evidence-environment-profile.v1", environment)
        for environment in profile.get("environmentProfiles", [])
    }
    for row in requirements:
        require(row["scopeProjectionHash"] in scope_hashes, "profile scope reference")
        require(row["environmentProfileHash"] in environment_hashes, "profile environment reference")
        count = row.get("requiredDistinctPassingScenarioCount")
        require(isinstance(count, int) and count in (1, 3), "profile passing multiplicity")
        if count == 3:
            require(
                row.get("stageRunCohortID") == "formal.stability-performance.v1"
                and row.get("requiredStageRunOrdinals") == [1, 2, 3],
                "Formal cohort projection",
            )
        else:
            require("stageRunCohortID" not in row and row.get("requiredStageRunOrdinals") == [], "ordinary multiplicity")
    return domain_hash(RELEASE_PROFILE_DOMAIN, profile)


def validate_selection(
    profile: Mapping[str, Any], selection: Mapping[str, Any]
) -> str:
    profile_hash = validate_profile(profile)
    require(selection.get("schemaVersion") == 1, "selection schema version")
    validate_opaque_id(selection.get("selectionSetID"), "selection set ID", 64)
    require(selection.get("releaseFlowID") == profile["releaseFlowID"], "selection flow")
    require(selection.get("evidenceStoreBindingID") == profile["evidenceStoreBindingID"], "selection binding")
    require(selection.get("releaseStage") == profile["releaseStage"], "selection stage")
    require(selection.get("releaseGateProfileID") == profile["profileID"], "selection profile ID")
    require(selection.get("releaseGateProfileHash") == profile_hash, "selection profile hash")
    entries = selection.get("entries")
    require(isinstance(entries, list), "selection entries")
    profile_keys = [
        (
            item["requirementID"],
            item["verificationID"],
            item["scopeProjectionHash"],
            item["environmentProfileHash"],
        )
        for item in profile["requirements"]
    ]
    entry_keys = [
        (
            item["requirementID"],
            item["verificationID"],
            item["scopeProjectionHash"],
            item["environmentProfileHash"],
        )
        for item in entries
    ]
    require(entry_keys == profile_keys, "selection exact tuple coverage")
    for row, entry in zip(profile["requirements"], entries):
        scenarios = entry.get("selectedScenarios")
        require(isinstance(scenarios, list), "selection scenarios")
        require(
            len(scenarios) <= row["requiredDistinctPassingScenarioCount"],
            "selection scenario count",
        )
        if row["requiredDistinctPassingScenarioCount"] == 1:
            require(
                all("stageRunOrdinal" not in scenario for scenario in scenarios),
                "ordinary selection stage run",
            )
        else:
            ordinals = [scenario.get("stageRunOrdinal") for scenario in scenarios]
            require(ordinals == sorted(set(ordinals)) and set(ordinals) <= {1, 2, 3}, "Formal selection ordinals")
    ledgers = selection.get("formalStageRunAttemptLedgers")
    require(isinstance(ledgers, list), "selection Formal ledgers")
    ledger_keys = [
        (
            item["stageRunCohortID"],
            item["scopeProjectionHash"],
            item["environmentProfileHash"],
            item["ledgerID"],
        )
        for item in ledgers
    ]
    require(ledger_keys == sorted(set(ledger_keys)), "Formal ledger ordering")
    for ledger in ledgers:
        require(ledger.get("ledgerState") == "finalized", "Formal ledger state")
        attempts = ledger.get("attempts")
        require(isinstance(attempts, list) and attempts, "Formal ledger attempts")
        for index, attempt in enumerate(attempts, 1):
            require(
                attempt.get("attemptIndex") == index
                and attempt.get("stageRunOrdinal") == index,
                "Formal ledger attempt continuity",
            )
            if index == 1:
                require("previousStageRunID" not in attempt, "Formal first previous run")
            else:
                require(
                    attempt.get("previousStageRunID")
                    == attempts[index - 2]["stageRunID"],
                    "Formal previous run chain",
                )
            require(
                attempt.get("outcome") in ("passed", "failed", "unknown"),
                "Formal attempt outcome",
            )
            if attempt["outcome"] != "passed":
                require(index == len(attempts), "Formal series continues after failure")
    return domain_hash(SELECTION_DOMAIN, selection)


def evaluate_selection(
    profile: Mapping[str, Any],
    selection: Mapping[str, Any],
    objects_root_value: str = "build/evidence/objects",
) -> Tuple[str, List[Dict[str, Any]]]:
    validate_selection(profile, selection)
    evaluated = []
    for required, entry in zip(profile["requirements"], selection["entries"]):
        scenarios = entry["selectedScenarios"]
        outcomes = []
        for scenario in scenarios:
            record_path = record_path_for_ref(
                scenario["manifestStoreRef"], objects_root_value
            )
            record, package = store_resolve(record_path, objects_root_value)
            verified = store_verify(record_path, objects_root_value)
            require(
                record["manifestSHA256"] == scenario["manifestSHA256"]
                and verified["storeRecordSHA256"]
                == scenario["storeRecordSHA256"],
                "selected scenario store pointer",
            )
            run_manifest = load_canonical(package / "evidence-manifest.v1.json")
            require(run_manifest["evidenceRunID"] == scenario["evidenceRunID"], "selected scenario run ID")
            matches = [
                item
                for item in run_manifest["scenarioResults"]
                if item["scenarioID"] == scenario["scenarioID"]
            ]
            require(len(matches) == 1, "selected scenario ID")
            outcomes.append(matches[0]["outcome"])
        passing = sum(outcome == "passed" for outcome in outcomes)
        reasons = []
        if "failed" in outcomes:
            outcome = "failed"
            reasons.append("requiredScenarioFailed")
        elif "unknown" in outcomes:
            outcome = "unknown"
            reasons.append("requiredScenarioUnknown")
        elif not scenarios:
            outcome = "unknown"
            reasons.append("requiredScenarioMissing")
        elif passing < required["requiredDistinctPassingScenarioCount"]:
            outcome = "unknown"
            reasons.append("passingCountInsufficient")
        else:
            outcome = "passed"
        evaluated.append(
            {
                "environmentProfileHash": required["environmentProfileHash"],
                "outcome": outcome,
                "reasonCodes": sorted(reasons),
                "requirementID": required["requirementID"],
                "scopeProjectionHash": required["scopeProjectionHash"],
                "verificationID": required["verificationID"],
            }
        )
    return aggregate_outcomes([item["outcome"] for item in evaluated]), evaluated


def selected_run_projection(selection: Mapping[str, Any]) -> List[Dict[str, Any]]:
    by_run: Dict[str, Dict[str, Any]] = {}
    for entry in selection["entries"]:
        for scenario in entry["selectedScenarios"]:
            run_id = validate_opaque_id(scenario.get("evidenceRunID"), "selected evidence run ID")
            projection = {
                "evidenceRunID": run_id,
                "manifestSHA256": scenario["manifestSHA256"],
                "manifestStoreRef": scenario["manifestStoreRef"],
                "selectionRole": scenario["selectionRole"],
                "storeRecordSHA256": scenario["storeRecordSHA256"],
            }
            if run_id in by_run:
                require(by_run[run_id] == projection, "selected run projection conflict")
            by_run[run_id] = projection
    return [by_run[key] for key in sorted(by_run)]


def aggregate_release_stage(
    profile_value: str,
    selection_value: str,
    selection_hash_value: str,
    provisional: bool,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    profile = load_canonical(ROOT / profile_value)
    selection_path = ROOT / selection_value
    selection = load_canonical(selection_path)
    selection_hash = validate_selection(profile, selection)
    detached_path = ROOT / selection_hash_value
    lstat_regular(detached_path)
    require(detached_path.read_bytes() == selection_hash.encode("ascii"), "selection detached hash")
    stage = profile["releaseStage"]
    require((not provisional) or stage == "formalRelease", "provisional stage")
    outcome, evaluated = evaluate_selection(profile, selection)
    stage_manifest_id = f"stage-{uuid.uuid4()}"
    package = typed_object_path(
        objects_root,
        "releaseStagePackage",
        stage_manifest_id,
        "release-evidence-manifest.v1.json",
    ).parent
    require(not package.exists(), "stage package collision")
    (package / "artifacts").mkdir(mode=0o700, parents=True)
    selection_artifact = package / "artifacts/evidence-selection-set.v1.json"
    selection_artifact.write_bytes(selection_path.read_bytes())
    os.chmod(selection_artifact, 0o600)
    released = list(profile["proposedReleaseScopes"]) if outcome == "passed" else []
    if provisional:
        require(outcome == "passed", "Formal provisional requires passing selection")
        released = list(profile["proposedReleaseScopes"])
    public_identity = {
        "proposedReleaseScopes": profile["proposedReleaseScopes"],
        "releasedCapabilityScopes": released,
        "schemaVersion": 1,
    }
    selected_runs = selected_run_projection(selection)
    verification_results = []
    for entry, result in zip(selection["entries"], evaluated):
        run_ids = sorted(
            {scenario["evidenceRunID"] for scenario in entry["selectedScenarios"]}
        )
        verification_results.append(
            {
                "applicability": "applicable",
                "environmentProfileHash": result["environmentProfileHash"],
                "environmentProfileID": next(
                    row["environmentProfileID"]
                    for row in profile["requirements"]
                    if row["requirementID"] == result["requirementID"]
                    and row["scopeProjectionHash"] == result["scopeProjectionHash"]
                    and row["environmentProfileHash"] == result["environmentProfileHash"]
                ),
                "evidenceRunIDs": run_ids,
                "outcome": result["outcome"],
                "required": True,
                "requirementID": result["requirementID"],
                "scopeProjection": next(
                    scope
                    for scope in profile["scopeProjections"]
                    if domain_hash("pulsephone.release-gate-scope.v1", scope)
                    == result["scopeProjectionHash"]
                ),
                "scopeProjectionHash": result["scopeProjectionHash"],
                "verificationID": result["verificationID"],
            }
        )
    candidate_input = profile["releaseInput"]["candidateInput"]
    manifest: Dict[str, Any] = {
        "actuallyVerifiedScopes": [],
        "candidate": candidate_input["candidate"],
        "evidencePolicy": profile["evidencePolicy"],
        "evidenceSelectionSet": {
            "artifactRelativePath": "artifacts/evidence-selection-set.v1.json",
            "selectionSetHash": selection_hash,
            "selectionSetID": selection["selectionSetID"],
        },
        "evidenceStoreBindingID": profile["evidenceStoreBindingID"],
        "generatedAtUTC": utc_now(),
        "implementationContractIdentity": candidate_input["implementationContractIdentity"],
        "manifestState": "formalProvisional" if provisional else "immutableStageResult",
        "proposedReleaseScopes": profile["proposedReleaseScopes"],
        "publicReleaseScopeIdentity": public_identity,
        "publicReleaseScopeIdentityHash": domain_hash(PUBLIC_SCOPE_DOMAIN, public_identity),
        "reconnectReadinessProfiles": [],
        "releaseFlowID": profile["releaseFlowID"],
        "releaseGateProfile": profile,
        "releaseGateProfileHash": validate_profile(profile),
        "releaseStage": stage,
        "releasedCapabilityScopes": released,
        "schemaVersion": 1,
        "selectedEvidenceRuns": selected_runs,
        "sourceCommit": candidate_input["sourceCommit"],
        "stageManifestID": stage_manifest_id,
        "stageOutcome": outcome,
        "verificationResults": verification_results,
        "worktreeState": "clean",
    }
    for key in (
        "negativeRemovalPlan",
        "negativeRemovalPlanHash",
        "performanceThresholdProfile",
        "performanceThresholdProfileHash",
        "performanceThresholdFreeze",
        "previousStageManifest",
        "broadOSCoverageSet",
        "broadOSCoverageSetHash",
    ):
        if key in profile:
            manifest[key] = profile[key]
    manifest_path = package / "release-evidence-manifest.v1.json"
    manifest_bytes = canonical_bytes(manifest)
    manifest_path.write_bytes(manifest_bytes)
    os.chmod(manifest_path, 0o600)
    sidecar = package / "release-evidence-manifest.v1.sha256"
    sidecar.write_bytes(sha256_bytes(manifest_bytes).encode("ascii"))
    os.chmod(sidecar, 0o600)
    return relative_path(package)


def validate_release_package(
    package_value: str, mode: str, output_value: str
) -> Dict[str, Any]:
    require(mode in ("stage-result", "formal-provisional"), "release validation mode")
    package = ROOT / package_value
    require(package.is_dir() and not package.is_symlink(), "release package root")
    manifest_path = package / "release-evidence-manifest.v1.json"
    sidecar = package / "release-evidence-manifest.v1.sha256"
    manifest = load_canonical(manifest_path)
    manifest_hash = sha256_bytes(manifest_path.read_bytes())
    require(sidecar.read_bytes() == manifest_hash.encode("ascii"), "release manifest sidecar")
    expected_state = "formalProvisional" if mode == "formal-provisional" else "immutableStageResult"
    require(manifest.get("manifestState") == expected_state, "release manifest state")
    if mode == "formal-provisional":
        require(manifest.get("releaseStage") == "formalRelease", "Formal provisional stage")
    profile = manifest.get("releaseGateProfile")
    require(isinstance(profile, dict), "release manifest profile")
    require(manifest.get("releaseGateProfileHash") == validate_profile(profile), "release profile hash")
    selection_pointer = manifest.get("evidenceSelectionSet")
    require(isinstance(selection_pointer, dict), "selection pointer")
    require(
        selection_pointer.get("artifactRelativePath")
        == "artifacts/evidence-selection-set.v1.json",
        "selection artifact path",
    )
    selection_path = package / "artifacts/evidence-selection-set.v1.json"
    selection = load_canonical(selection_path)
    selection_hash = validate_selection(profile, selection)
    require(selection_pointer.get("selectionSetID") == selection["selectionSetID"], "selection ID")
    require(selection_pointer.get("selectionSetHash") == selection_hash, "selection hash")
    outcome, _ = evaluate_selection(profile, selection)
    require(manifest.get("stageOutcome") == outcome, "stage outcome projection")
    released = profile["proposedReleaseScopes"] if outcome == "passed" else []
    if mode == "formal-provisional":
        require(outcome == "passed", "provisional outcome")
        released = profile["proposedReleaseScopes"]
    require(manifest.get("releasedCapabilityScopes") == released, "released scope projection")
    public_identity = {
        "proposedReleaseScopes": profile["proposedReleaseScopes"],
        "releasedCapabilityScopes": released,
        "schemaVersion": 1,
    }
    require(manifest.get("publicReleaseScopeIdentity") == public_identity, "public scope identity")
    require(
        manifest.get("publicReleaseScopeIdentityHash")
        == domain_hash(PUBLIC_SCOPE_DOMAIN, public_identity),
        "public scope identity hash",
    )
    expected_selected = selected_run_projection(selection)
    finalization = manifest.get("formalFinalization")
    if finalization is not None:
        require(mode == "stage-result", "finalization validation mode")
        require(
            finalization.get("artifactRelativePath")
            == "artifacts/release-hold-set.v1.json",
            "hold set artifact path",
        )
        hold_set = load_canonical(package / "artifacts/release-hold-set.v1.json")
        hold_set_hash = validate_hold_set(hold_set)
        require(finalization.get("releaseHoldSetID") == hold_set["holdSetID"], "hold set ID")
        require(finalization.get("releaseHoldSetHash") == hold_set_hash, "hold set hash")
        holds = {item["manifestStoreRef"]: item for item in hold_set["holds"]}
        expected_selected = [
            {
                **item,
                "holdAppliedAtUTC": holds[item["manifestStoreRef"]][
                    "holdAppliedAtUTC"
                ],
                "releaseHoldID": holds[item["manifestStoreRef"]][
                    "releaseHoldID"
                ],
            }
            for item in expected_selected
        ]
    require(manifest.get("selectedEvidenceRuns") == expected_selected, "selected run projection")
    report = {
        "manifestSHA256": manifest_hash,
        "packageID": manifest["stageManifestID"],
        "packageKind": "releaseStageManifest",
        "schemaVersion": 1,
        "validationStatus": {
            "integrity": "valid",
            "privacy": "valid",
            "rawCleanup": "valid",
            "retention": "valid",
        },
    }
    write_canonical_atomic(ROOT / output_value, report)
    return report


def evaluate_stage_record(
    record_value: str,
    mode: str,
    output_value: str,
    objects_root_value: str,
) -> Tuple[Dict[str, Any], int]:
    require(mode in ("stageResult", "formalProvisional"), "stage evaluation mode")
    record, package = store_resolve(record_value, objects_root_value)
    verified = store_verify(record_value, objects_root_value)
    require(record.get("packageKind") == "releaseStageManifest", "stage record kind")
    manifest = load_canonical(package / "release-evidence-manifest.v1.json")
    expected_state = "formalProvisional" if mode == "formalProvisional" else "immutableStageResult"
    require(manifest.get("manifestState") == expected_state, "stage evaluation state")
    profile = manifest["releaseGateProfile"]
    selection = load_canonical(package / "artifacts/evidence-selection-set.v1.json")
    selection_hash = validate_selection(profile, selection)
    outcome, evaluated = evaluate_selection(profile, selection)
    report = {
        "evaluatedRequirements": evaluated,
        "evaluationMode": mode,
        "evidenceStoreBindingID": manifest["evidenceStoreBindingID"],
        "manifestSHA256": record["manifestSHA256"],
        "manifestState": manifest["manifestState"],
        "manifestStoreRef": record["manifestStoreRef"],
        "outcome": outcome,
        "releaseFlowID": manifest["releaseFlowID"],
        "releaseGateProfileHash": manifest["releaseGateProfileHash"],
        "releaseGateProfileID": profile["profileID"],
        "releaseStage": manifest["releaseStage"],
        "schemaVersion": 1,
        "selectionSetHash": selection_hash,
        "selectionSetID": selection["selectionSetID"],
        "stageManifestID": manifest["stageManifestID"],
        "storeRecordSHA256": verified["storeRecordSHA256"],
    }
    write_canonical_atomic(ROOT / output_value, report)
    return report, 0 if outcome == "passed" else 1


def create_profile_selection(
    profile_value: str, objects_root_value: str
) -> Dict[str, str]:
    objects_root = verified_objects_root(objects_root_value)
    profile = load_canonical(ROOT / profile_value)
    profile_hash = validate_profile(profile)
    selection_id = f"selection-{uuid.uuid4()}"
    selection = {
        "entries": [
            {
                "environmentProfileHash": row["environmentProfileHash"],
                "environmentProfileID": row["environmentProfileID"],
                "requirementID": row["requirementID"],
                "scopeProjectionHash": row["scopeProjectionHash"],
                "selectedScenarios": [],
                "verificationID": row["verificationID"],
            }
            for row in profile["requirements"]
        ],
        "evidenceStoreBindingID": profile["evidenceStoreBindingID"],
        "formalStageRunAttemptLedgers": [],
        "releaseFlowID": profile["releaseFlowID"],
        "releaseGateProfileHash": profile_hash,
        "releaseGateProfileID": profile["profileID"],
        "releaseStage": profile["releaseStage"],
        "schemaVersion": 1,
        "selectionSetID": selection_id,
    }
    selection_hash = validate_selection(profile, selection)
    root = typed_object_path(
        objects_root,
        "evidenceSelectionSet",
        selection_id,
        "evidence-selection-set.v1.json",
    ).parent
    root.mkdir(mode=0o700)
    path = root / "evidence-selection-set.v1.json"
    write_canonical_atomic(path, selection)
    detached = root / "evidence-selection-set.v1.sha256"
    detached.write_bytes(selection_hash.encode("ascii"))
    os.chmod(detached, 0o600)
    return {
        "selectionHashPath": relative_path(detached),
        "selectionPath": relative_path(path),
    }


def create_release_tuple_run(
    profile: Mapping[str, Any],
    row: Mapping[str, Any],
    selection_id: str,
    objects_root_value: str,
    stage_run: Mapping[str, Any] | None = None,
    input_artifact_values: Sequence[str] = (),
) -> Tuple[Dict[str, Any], str]:
    objects_root = verified_objects_root(objects_root_value)
    source = source_snapshot()
    require(source["worktreeState"] == "clean", "release runner source must be clean")
    requirement = load_requirements()[row["requirementID"]]
    adapter_path = ROOT / f"Verification/runner-adapters/{row['requirementID']}.v1.json"
    if input_artifact_values:
        flow_path = typed_object_path(
            objects_root,
            "releaseFlow",
            profile["releaseFlowID"],
            "release-flow.v1.json",
        )
        profile_path = typed_object_path(
            objects_root,
            "releaseGateProfile",
            profile["profileID"],
            "release-gate-profile.v1.json",
        )
        owner_routes = {
            item["requirementID"]: item
            for item in load_canonical(ROOT / OWNERS_ROOT)["routes"]
        }
        package_paths = run_members(
            [row["requirementID"]],
            None,
            owner_routes[row["requirementID"]]["runnerOwnerTaskID"],
            objects_root_value,
            input_artifact_values,
            relative_path(flow_path),
            profile["releaseStage"],
            None,
            None,
            relative_path(profile_path),
            stage_run,
            selection_id if stage_run is not None else None,
            profile["releaseInput"]["candidateInput"],
            profile["releaseInput"]["candidateInputHash"],
        )
        require(len(package_paths) == 1, "profile tuple package cardinality")
        package_path = package_paths[0]
        package = ROOT / package_path
        manifest = load_canonical(package / "evidence-manifest.v1.json")
        scenario = manifest["scenarioResults"][0]
        validation_path = typed_object_path(
            objects_root,
            "evidenceRunValidation",
            manifest["evidenceRunID"],
            "evidence-run-validation.v1.json",
        )
        validation_path.parent.mkdir(mode=0o700)
        validate_package(package_path, relative_path(validation_path))
        record_path = store_put(
            package_path, relative_path(validation_path), objects_root_value
        )
        record, _ = store_resolve(record_path, objects_root_value)
        verified = store_verify(record_path, objects_root_value)
        selection_role = {
            "role.current-candidate.v1": "currentCandidateEvidence",
            "role.reusable-legal.v1": "reusableLegalMaterial",
            "role.threshold-provenance.v1": "thresholdProvenance",
        }[requirement["evidenceRolePolicyID"]]
        pointer: Dict[str, Any] = {
            "evidenceRunID": manifest["evidenceRunID"],
            "manifestSHA256": record["manifestSHA256"],
            "manifestStoreRef": record["manifestStoreRef"],
            "scenarioID": scenario["scenarioID"],
            "selectionRole": selection_role,
            "storeRecordSHA256": verified["storeRecordSHA256"],
        }
        if stage_run is not None:
            pointer["stageRunID"] = stage_run["stageRunID"]
            pointer["stageRunOrdinal"] = stage_run["stageRunOrdinal"]
        return pointer, package_path
    if adapter_path.exists():
        adapter = load_canonical(adapter_path)
        if adapter_input_specs(adapter):
            outcome, disposition = "unknown", "runner.input-artifact-missing"
        else:
            outcome, disposition = execute_adapter(adapter)
    else:
        adapter = None
        outcome, disposition = "unknown", "runner.adapter-missing"
    run_id = f"run-{uuid.uuid4()}"
    package = typed_object_path(
        objects_root,
        "evidenceRunPackage",
        run_id,
        "evidence-manifest.v1.json",
    ).parent
    package.mkdir(mode=0o700)
    scope = next(
        item
        for item in profile["scopeProjections"]
        if domain_hash("pulsephone.release-gate-scope.v1", item)
        == row["scopeProjectionHash"]
    )
    environment = next(
        item
        for item in profile["environmentProfiles"]
        if item["profileID"] == row["environmentProfileID"]
    )
    ordinal_suffix = (
        f".ordinal-{stage_run['stageRunOrdinal']}" if stage_run is not None else ""
    )
    scenario_id = (
        f"{row['requirementID']}.{profile['releaseStage']}."
        f"{row['scopeProjectionHash'][:12]}.{row['environmentProfileHash'][:12]}"
        f"{ordinal_suffix}"
    )
    environment_artifact = copy_file_artifact(
        package,
        "environment-snapshot",
        canonical_bytes(environment),
        "environmentSnapshot",
        [scenario_id],
    )
    scenario = {
        "applicability": "applicable",
        "artifactIDs": ["environment-snapshot"],
        "blockerCodes": [] if outcome == "passed" else [disposition],
        "claimEffect": (
            "supportsActuallyVerifiedReview"
            if outcome == "passed"
            else "blocksReleaseStage"
            if requirement["failurePolicyID"] == "failure.product.v1"
            else "none"
        ),
        "contractRefs": requirement["contractRefs"],
        "environmentProfileHash": row["environmentProfileHash"],
        "environmentProfileID": row["environmentProfileID"],
        "expectedOracleRef": (
            adapter["oracleKind"] if adapter is not None else "runnerAdapter.required"
        ),
        "observedDisposition": disposition,
        "outcome": outcome,
        "requirementID": row["requirementID"],
        "scenarioID": scenario_id,
        "scopeProjection": scope,
        "scopeProjectionHash": row["scopeProjectionHash"],
        "verificationID": row["verificationID"],
    }
    if requirement["fixtureMode"] != "none":
        scenario["caseKey"] = row["requirementID"]
    manifest: Dict[str, Any] = {
        "artifacts": [environment_artifact],
        "candidate": profile["releaseInput"]["candidateInput"]["candidate"],
        "endedAtUTC": utc_now(),
        "environmentArtifactID": "environment-snapshot",
        "evidencePolicy": profile["evidencePolicy"],
        "evidenceRunID": run_id,
        "evidenceStage": profile["releaseStage"],
        "generator": {"name": "Scripts/evidence-tool", "version": "2"},
        "implementationContractIdentity": profile["releaseInput"]["candidateInput"][
            "implementationContractIdentity"
        ],
        "monotonicDurationMs": 0,
        "overallOutcome": outcome,
        "rawMaterialDisposition": {
            "cleanupOutcome": "notRequired",
            "derivedOnly": True,
            "rawPersisted": False,
        },
        "releaseFlow": {
            "evidenceStoreBindingID": profile["evidenceStoreBindingID"],
            "releaseFlowID": profile["releaseFlowID"],
        },
        "retentionClass": "candidateRun",
        "runnerSource": {
            "gitCommit": source["gitHeadCommit"],
            "worktreeState": "clean",
        },
        "scenarioResults": [scenario],
        "schemaVersion": 1,
        "startedAtUTC": utc_now(),
        "supersedesEvidenceRunIDs": [],
        "taskID": load_canonical(ROOT / OWNERS_ROOT)["routes"][[
            item["requirementID"] for item in load_canonical(ROOT / OWNERS_ROOT)["routes"]
        ].index(row["requirementID"])]["runnerOwnerTaskID"],
        "validationStatus": {
            "integrity": "valid",
            "privacy": "valid",
            "rawCleanup": "valid",
            "retention": "valid",
        },
    }
    if stage_run is not None:
        manifest["releaseStageRun"] = {
            **stage_run,
            "releaseFlowID": profile["releaseFlowID"],
            "releaseGateProfileHash": validate_profile(profile),
            "releaseGateProfileID": profile["profileID"],
            "releaseStage": profile["releaseStage"],
            "selectionSetID": selection_id,
        }
    manifest_bytes = canonical_bytes(manifest)
    manifest_path = package / "evidence-manifest.v1.json"
    manifest_path.write_bytes(manifest_bytes)
    os.chmod(manifest_path, 0o600)
    sidecar = package / "evidence-manifest.v1.sha256"
    sidecar.write_bytes(sha256_bytes(manifest_bytes).encode("ascii"))
    os.chmod(sidecar, 0o600)
    validation_path = typed_object_path(
        objects_root,
        "evidenceRunValidation",
        run_id,
        "evidence-run-validation.v1.json",
    )
    validation_path.parent.mkdir(mode=0o700)
    validate_package(relative_path(package), relative_path(validation_path))
    record_path = store_put(
        relative_path(package), relative_path(validation_path), objects_root_value
    )
    record, _ = store_resolve(record_path, objects_root_value)
    verified = store_verify(record_path, objects_root_value)
    role_policy = requirement["evidenceRolePolicyID"]
    selection_role = {
        "role.current-candidate.v1": "currentCandidateEvidence",
        "role.reusable-legal.v1": "reusableLegalMaterial",
        "role.threshold-provenance.v1": "thresholdProvenance",
    }[role_policy]
    pointer: Dict[str, Any] = {
        "evidenceRunID": run_id,
        "manifestSHA256": record["manifestSHA256"],
        "manifestStoreRef": record["manifestStoreRef"],
        "scenarioID": scenario_id,
        "selectionRole": selection_role,
        "storeRecordSHA256": verified["storeRecordSHA256"],
    }
    if stage_run is not None:
        pointer["stageRunID"] = stage_run["stageRunID"]
        pointer["stageRunOrdinal"] = stage_run["stageRunOrdinal"]
    return pointer, relative_path(package)


def existing_selection_candidates(
    record_values: Sequence[Tuple[str, str]],
    objects_root_value: str,
) -> Dict[Tuple[str, str, str, str], List[Dict[str, Any]]]:
    candidates: Dict[Tuple[str, str, str, str], List[Dict[str, Any]]] = {}
    for record_value, selection_role in record_values:
        record, package = store_resolve(record_value, objects_root_value)
        verified = store_verify(record_value, objects_root_value)
        if record["packageKind"] != "evidenceRun":
            continue
        manifest = load_canonical(package / "evidence-manifest.v1.json")
        for scenario in manifest["scenarioResults"]:
            key = (
                scenario["requirementID"],
                scenario["verificationID"],
                scenario["scopeProjectionHash"],
                scenario["environmentProfileHash"],
            )
            candidates.setdefault(key, []).append(
                {
                    "evidenceRunID": manifest["evidenceRunID"],
                    "manifestSHA256": record["manifestSHA256"],
                    "manifestStoreRef": record["manifestStoreRef"],
                    "scenarioID": scenario["scenarioID"],
                    "selectionRole": selection_role,
                    "storeRecordSHA256": verified["storeRecordSHA256"],
                }
            )
    return candidates


def validate_profile_evidence_record(
    profile: Mapping[str, Any],
    record_value: str,
    objects_root_value: str,
) -> None:
    record, package = store_resolve(record_value, objects_root_value)
    store_verify(record_value, objects_root_value)
    require(record.get("packageKind") == "evidenceRun", "profile evidence package kind")
    require(
        record.get("evidenceStoreBindingID") == profile["evidenceStoreBindingID"],
        "profile evidence binding",
    )
    manifest = load_canonical(package / "evidence-manifest.v1.json")
    require(
        manifest.get("releaseFlow")
        == {
            "evidenceStoreBindingID": profile["evidenceStoreBindingID"],
            "releaseFlowID": profile["releaseFlowID"],
        },
        "profile evidence flow",
    )
    require(
        manifest.get("evidenceStage") == profile["releaseStage"],
        "profile evidence stage",
    )
    require(
        manifest.get("candidate")
        == profile["releaseInput"]["candidateInput"]["candidate"],
        "profile evidence candidate",
    )
    require(
        manifest.get("evidencePolicy") == profile["evidencePolicy"],
        "profile evidence policy",
    )
    require(
        manifest.get("runnerSource", {}).get("worktreeState") == "clean",
        "profile evidence runner source",
    )
    allowed_keys = {
        (
            row["requirementID"],
            row["verificationID"],
            row["scopeProjectionHash"],
            row["environmentProfileHash"],
        )
        for row in profile["requirements"]
    }
    scenario_keys = {
        (
            scenario["requirementID"],
            scenario["verificationID"],
            scenario["scopeProjectionHash"],
            scenario["environmentProfileHash"],
        )
        for scenario in manifest["scenarioResults"]
    }
    require(scenario_keys and scenario_keys <= allowed_keys, "profile evidence tuple")


def validate_formal_profile_inputs(
    profile: Mapping[str, Any], assignments: Sequence[str]
) -> Dict[Tuple[int, str, str, str], List[str]]:
    parsed = parse_profile_input_artifacts(assignments)
    if not parsed:
        return {}
    require(
        profile["releaseStage"] == "formalRelease",
        "profile inputs require Formal release",
    )
    cohort_rows = [
        row
        for row in profile["requirements"]
        if row.get("stageRunCohortID") == "formal.stability-performance.v1"
    ]
    expected_keys = {
        (
            ordinal,
            row["requirementID"],
            row["scopeProjectionHash"],
            row["environmentProfileHash"],
        )
        for ordinal in (1, 2, 3)
        for row in cohort_rows
    }
    require(set(parsed) == expected_keys, "Formal profile input exact coverage")
    for key, values in parsed.items():
        adapter_path = ROOT / f"Verification/runner-adapters/{key[1]}.v1.json"
        require(adapter_path.exists(), f"Formal profile adapter missing: {key[1]}")
        adapter = load_canonical(adapter_path)
        require(
            all(
                spec["artifactKind"] == "file"
                for spec in adapter_input_specs(adapter).values()
            ),
            "Formal profile input file roles only",
        )
        supplied = parse_input_artifacts(values)
        validate_adapter_inputs(adapter, supplied)
        if adapter["adapterKind"] == "releaseStageOperation":
            require(
                not supplied.get("developmentCandidateInput")
                and len(supplied.get("performanceThresholdProfile", [])) == 1,
                "Formal stage candidate and threshold inputs",
            )
    role_paths: Dict[Tuple[str, str, int, str], set[str]] = {}
    for (ordinal, _, scope_hash, environment_hash), values in parsed.items():
        for role, paths in parse_input_artifacts(values).items():
            role_paths.setdefault(
                (scope_hash, environment_hash, ordinal, role), set()
            ).update(paths)
    require(
        all(len(paths) == 1 for paths in role_paths.values()),
        "Formal cohort shared role input",
    )
    group_keys = {
        (row["scopeProjectionHash"], row["environmentProfileHash"])
        for row in cohort_rows
    }
    for scope_hash, environment_hash in group_keys:
        metric_paths = [
            next(
                iter(
                    role_paths[
                        (
                            scope_hash,
                            environment_hash,
                            ordinal,
                            "performanceMetrics",
                        )
                    ]
                )
            )
            for ordinal in (1, 2, 3)
        ]
        require(
            len(set(metric_paths)) == 3,
            "Formal metrics must be distinct by ordinal",
        )
        for role in (
            "performanceMeasurementProfile",
            "performanceThresholdProfile",
        ):
            paths = [
                next(
                    iter(
                        role_paths[
                            (scope_hash, environment_hash, ordinal, role)
                        ]
                    )
                )
                for ordinal in (1, 2, 3)
            ]
            require(
                len(set(paths)) == 1,
                f"Formal shared {role}",
            )
    return parsed


def run_release_profile(
    profile_value: str,
    candidate_record_value: str | None,
    reusable_legal_records: Sequence[str],
    evidence_records: Sequence[str],
    profile_input_artifacts: Sequence[str],
    objects_root_value: str,
) -> Dict[str, Any]:
    objects_root = verified_objects_root(objects_root_value)
    profile = load_canonical(ROOT / profile_value)
    profile_hash = validate_profile(profile)
    formal_inputs = validate_formal_profile_inputs(
        profile, profile_input_artifacts
    )
    selection_id = f"selection-{uuid.uuid4()}"
    existing_records: List[Tuple[str, str]] = []
    if candidate_record_value is not None:
        existing_records.append((candidate_record_value, "currentCandidateEvidence"))
    require(
        len(evidence_records) == len(set(evidence_records)),
        "duplicate profile evidence record",
    )
    for evidence_record in evidence_records:
        validate_profile_evidence_record(
            profile, evidence_record, objects_root_value
        )
        existing_records.append((evidence_record, "currentCandidateEvidence"))
    existing_records.extend(
        (record, "reusableLegalMaterial") for record in reusable_legal_records
    )
    freeze = profile.get("performanceThresholdFreeze")
    if isinstance(freeze, dict):
        existing_records.append(
            (
                record_path_for_ref(
                    freeze["freezeManifestStoreRef"], objects_root_value
                ),
                "thresholdProvenance",
            )
        )
    if profile["releaseStage"] == "formalRelease":
        previous = profile.get("previousStageManifest")
        require(isinstance(previous, dict), "Formal previous stage")
        beta_record_path = record_path_for_ref(
            previous["manifestStoreRef"], objects_root_value
        )
        _, beta_package = store_resolve(beta_record_path, objects_root_value)
        beta_selection = load_canonical(
            beta_package / "artifacts/evidence-selection-set.v1.json"
        )
        beta_scenarios = []
        for entry in beta_selection["entries"]:
            beta_scenarios.extend(entry["selectedScenarios"])
        for scenario in beta_scenarios:
            existing_records.append(
                (
                    record_path_for_ref(
                        scenario["manifestStoreRef"], objects_root_value
                    ),
                    scenario["selectionRole"],
                )
            )
    existing = existing_selection_candidates(existing_records, objects_root_value)
    profile_rows = {
        (
            row["requirementID"],
            row["verificationID"],
            row["scopeProjectionHash"],
            row["environmentProfileHash"],
        ): row
        for row in profile["requirements"]
    }
    for key, candidates in existing.items():
        if key in profile_rows:
            require(
                len(candidates)
                <= profile_rows[key]["requiredDistinctPassingScenarioCount"],
                "ambiguous profile evidence tuple",
            )
    entries = []
    packages = []
    cohort_groups: Dict[Tuple[str, str, str], List[Tuple[int, Mapping[str, Any]]]] = {}
    for row in profile["requirements"]:
        key = (
            row["requirementID"],
            row["verificationID"],
            row["scopeProjectionHash"],
            row["environmentProfileHash"],
        )
        selected = sorted(
            existing.get(key, []),
            key=lambda item: (item["evidenceRunID"], item["scenarioID"]),
        )[:1]
        if row["requiredDistinctPassingScenarioCount"] == 3:
            selected = []
        if not selected and row["requiredDistinctPassingScenarioCount"] == 1:
            pointer, package = create_release_tuple_run(
                profile, row, selection_id, objects_root_value
            )
            selected = [pointer]
            packages.append(package)
        entries.append(
            {
                "environmentProfileHash": row["environmentProfileHash"],
                "environmentProfileID": row["environmentProfileID"],
                "requirementID": row["requirementID"],
                "scopeProjectionHash": row["scopeProjectionHash"],
                "selectedScenarios": selected,
                "verificationID": row["verificationID"],
            }
        )
        cohort_id = row.get("stageRunCohortID")
        if cohort_id is not None:
            group_key = (
                cohort_id,
                row["scopeProjectionHash"],
                row["environmentProfileHash"],
            )
            cohort_groups.setdefault(group_key, []).append((len(entries) - 1, row))
    ledgers = []
    flow = {
        "evidenceStoreBindingID": profile["evidenceStoreBindingID"],
        "releaseFlowID": profile["releaseFlowID"],
    }
    for group_key in sorted(cohort_groups):
        grouped_rows = cohort_groups[group_key]
        require(
            {row["requirementID"] for _, row in grouped_rows}
            == {
                "T-018/performance-threshold-evaluation-l5",
                "T-018/stability-stage-run-l5",
            },
            "Formal cohort group membership",
        )
        ledger_id = f"ledger-{uuid.uuid4()}"
        series_id = f"series-{uuid.uuid4()}"
        attempts = []
        previous_stage_run_id = None
        revision = 0
        for ordinal in (1, 2, 3):
            stage_run_id = f"stage-run-{uuid.uuid4()}"
            started_attempt: Dict[str, Any] = {
                "attemptIndex": ordinal,
                "phase": "started",
                "stageRunID": stage_run_id,
                "stageRunOrdinal": ordinal,
            }
            if previous_stage_run_id is not None:
                started_attempt["previousStageRunID"] = previous_stage_run_id
            attempts.append(started_attempt)
            revision += 1
            started_wal = {
                "attempts": attempts,
                "checkpointRevision": revision,
                "environmentProfileHash": group_key[2],
                "evidenceStoreBindingID": profile["evidenceStoreBindingID"],
                "ledgerID": ledger_id,
                "releaseFlowID": profile["releaseFlowID"],
                "schemaVersion": 1,
                "scopeProjectionHash": group_key[1],
                "seriesState": "open",
                "stageRunCohortID": group_key[0],
                "stageRunSeriesID": series_id,
            }
            checkpoint_wal_value(flow, started_wal, revision - 1, objects_root_value)
            evidence_refs = []
            attempt_outcomes = []
            for entry_index, row in grouped_rows:
                stage_run = {
                    "stageRunAttemptIndex": ordinal,
                    "stageRunCohortID": group_key[0],
                    "stageRunID": stage_run_id,
                    "stageRunOrdinal": ordinal,
                    "stageRunSeriesID": series_id,
                }
                if previous_stage_run_id is not None:
                    stage_run["previousStageRunID"] = previous_stage_run_id
                pointer, package_path = create_release_tuple_run(
                    profile,
                    row,
                    selection_id,
                    objects_root_value,
                    stage_run,
                    formal_inputs.get(
                        (
                            ordinal,
                            row["requirementID"],
                            row["scopeProjectionHash"],
                            row["environmentProfileHash"],
                        ),
                        (),
                    ),
                )
                entries[entry_index]["selectedScenarios"].append(pointer)
                packages.append(package_path)
                record_path = record_path_for_ref(
                    pointer["manifestStoreRef"], objects_root_value
                )
                _, run_package = store_resolve(record_path, objects_root_value)
                run_manifest = load_canonical(
                    run_package / "evidence-manifest.v1.json"
                )
                run_scenario = run_manifest["scenarioResults"][0]
                attempt_outcomes.append(run_scenario["outcome"])
                evidence_refs.append(
                    {
                        "evidenceRunID": pointer["evidenceRunID"],
                        "manifestSHA256": pointer["manifestSHA256"],
                        "manifestStoreRef": pointer["manifestStoreRef"],
                        "requirementID": row["requirementID"],
                        "scenarioID": pointer["scenarioID"],
                        "scenarioOutcome": run_scenario["outcome"],
                        "storeRecordSHA256": pointer["storeRecordSHA256"],
                        "verificationID": row["verificationID"],
                    }
                )
            attempt_outcome = aggregate_outcomes(attempt_outcomes)
            terminal_attempt = {
                key: value
                for key, value in started_attempt.items()
                if key != "phase"
            }
            terminal_attempt.update(
                {
                    "evidenceRunRefs": sorted(
                        evidence_refs,
                        key=lambda item: (
                            item["requirementID"],
                            item["verificationID"],
                            item["evidenceRunID"],
                            item["scenarioID"],
                        ),
                    ),
                    "outcome": attempt_outcome,
                    "phase": "terminal",
                }
            )
            attempts[-1] = terminal_attempt
            revision += 1
            series_state = (
                "finalized"
                if attempt_outcome == "passed" and ordinal == 3
                else "closed"
                if attempt_outcome != "passed"
                else "open"
            )
            terminal_wal = {
                **started_wal,
                "attempts": attempts,
                "checkpointRevision": revision,
                "seriesState": series_state,
            }
            checkpoint_wal_value(flow, terminal_wal, revision - 1, objects_root_value)
            if attempt_outcome != "passed":
                break
            previous_stage_run_id = stage_run_id
        ledgers.append(
            {
                "attempts": [
                    {key: value for key, value in attempt.items() if key != "phase"}
                    for attempt in attempts
                ],
                "environmentProfileHash": group_key[2],
                "ledgerID": ledger_id,
                "ledgerState": "finalized",
                "schemaVersion": 1,
                "scopeProjectionHash": group_key[1],
                "stageRunCohortID": group_key[0],
                "stageRunSeriesID": series_id,
            }
        )
    selection = {
        "entries": entries,
        "evidenceStoreBindingID": profile["evidenceStoreBindingID"],
        "formalStageRunAttemptLedgers": sorted(
            ledgers,
            key=lambda item: (
                item["stageRunCohortID"],
                item["scopeProjectionHash"],
                item["environmentProfileHash"],
                item["ledgerID"],
            ),
        ),
        "releaseFlowID": profile["releaseFlowID"],
        "releaseGateProfileHash": profile_hash,
        "releaseGateProfileID": profile["profileID"],
        "releaseStage": profile["releaseStage"],
        "schemaVersion": 1,
        "selectionSetID": selection_id,
    }
    selection_hash = validate_selection(profile, selection)
    root = typed_object_path(
        objects_root,
        "evidenceSelectionSet",
        selection_id,
        "evidence-selection-set.v1.json",
    ).parent
    root.mkdir(mode=0o700)
    selection_path = root / "evidence-selection-set.v1.json"
    write_canonical_atomic(selection_path, selection)
    detached = root / "evidence-selection-set.v1.sha256"
    detached.write_bytes(selection_hash.encode("ascii"))
    os.chmod(detached, 0o600)
    return {
        "evidenceRunPackages": packages,
        "schemaVersion": 1,
        "selectionHashPath": relative_path(detached),
        "selectionPath": relative_path(selection_path),
    }


def validate_negative_removal_plan(plan: Mapping[str, Any]) -> None:
    require(plan.get("schemaVersion") == 1, "negative removal plan schema")
    validate_opaque_id(plan.get("planID"), "negative removal plan ID", 64)
    require(
        plan.get("writeGrantHash")
        == domain_hash("pulsephone.negative-removal-write-grant.v1", plan["writeGrant"]),
        "negative removal write grant hash",
    )
    changed = plan.get("changedContractArtifacts")
    require(isinstance(changed, list), "negative removal changed artifacts")
    paths = [item["relativePath"] for item in changed]
    require(paths == sorted(set(paths)), "negative removal path order")
    require(
        plan.get("surfaceValidation")
        == {
            "catalog": "passed",
            "cli": "passed",
            "docs": "passed",
            "gui": "passed",
            "help": "passed",
            "policy": "passed",
            "tests": "passed",
        },
        "negative removal surface validation",
    )
    reopened = plan.get("reopenedGateResults")
    require(
        isinstance(reopened, list)
        and [item.get("gateID") for item in reopened] == ["M0-900", "M2-900"]
        and all(item.get("outcome") == "passed" for item in reopened),
        "negative removal reopened gates",
    )


def prior_plan_projection(
    record_value: str, objects_root_value: str
) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    record, package = store_resolve(record_value, objects_root_value)
    verified = store_verify(record_value, objects_root_value)
    require(record.get("packageKind") == "evidenceRun", "prior plan package kind")
    manifest = load_canonical(package / "evidence-manifest.v1.json")
    matches = [
        artifact
        for artifact in manifest.get("artifacts", [])
        if artifact.get("role") == "negativeRemovalPlan"
    ]
    require(len(matches) == 1, "prior plan artifact cardinality")
    artifact = matches[0]
    path = package / artifact["relativePath"]
    plan = load_canonical(path)
    validate_negative_removal_plan(plan)
    plan_hash = domain_hash(NEGATIVE_REMOVAL_DOMAIN, plan)
    return plan, {
        "evidenceRunID": manifest["evidenceRunID"],
        "evidenceStoreBindingID": plan["evidenceStoreBindingID"],
        "manifestSHA256": record["manifestSHA256"],
        "manifestStoreRef": record["manifestStoreRef"],
        "planArtifactID": artifact["artifactID"],
        "planArtifactSHA256": sha256_bytes(path.read_bytes()),
        "planHash": plan_hash,
        "planID": plan["planID"],
        "releaseFlowID": plan["releaseFlowID"],
        "storeRecordSHA256": verified["storeRecordSHA256"],
    }


def alpha_stage_authority(
    record_value: str, objects_root_value: str
) -> Tuple[Dict[str, Any], Dict[str, Any], Dict[str, Any]]:
    record, package = store_resolve(record_value, objects_root_value)
    verified = store_verify(record_value, objects_root_value)
    require(record.get("packageKind") == "releaseStageManifest", "Alpha record kind")
    manifest = load_canonical(package / "release-evidence-manifest.v1.json")
    require(
        manifest.get("releaseStage") == "internalAlpha"
        and manifest.get("manifestState") == "immutableStageResult"
        and manifest.get("stageOutcome") == "passed",
        "passing Alpha authority required",
    )
    pointer = {
        "manifestSHA256": record["manifestSHA256"],
        "manifestStoreRef": record["manifestStoreRef"],
        "releaseStage": "internalAlpha",
        "stageManifestID": record["packageID"],
        "storeRecordSHA256": verified["storeRecordSHA256"],
    }
    return manifest, record, pointer


def preflight_negative_removal(
    alpha_record_value: str,
    supersedes_plan_record_value: str | None,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    source = source_snapshot()
    require(source["worktreeState"] == "clean", "negative removal preflight requires clean source")
    alpha, alpha_record, alpha_pointer = alpha_stage_authority(
        alpha_record_value, objects_root_value
    )
    candidate_input = alpha["releaseGateProfile"]["releaseInput"]["candidateInput"]
    grant_id = f"grant-{uuid.uuid4()}"
    grant: Dict[str, Any] = {
        "alphaStage": alpha_pointer,
        "evidenceStoreBindingID": alpha["evidenceStoreBindingID"],
        "grantID": grant_id,
        "grantedContractArtifacts": [],
        "releaseFlowID": alpha["releaseFlowID"],
        "removals": [],
        "repositoryBaseCommit": source["gitHeadCommit"],
        "schemaVersion": 1,
        "sourceEvidencePolicy": alpha["evidencePolicy"],
        "sourcePublicExposure": {
            "catalogExposedScopes": candidate_input["catalogExposedScopes"],
            "catalogExposureHash": candidate_input["catalogExposureHash"],
            "implementationContractIdentity": candidate_input[
                "implementationContractIdentity"
            ],
        },
        "sourceRefs": [],
    }
    if supersedes_plan_record_value is not None:
        prior_plan, prior_pointer = prior_plan_projection(
            supersedes_plan_record_value, objects_root_value
        )
        require(
            prior_plan["resultPublicExposure"]["catalogExposureHash"]
            == grant["sourcePublicExposure"]["catalogExposureHash"]
            and prior_plan["resultPublicExposure"]["catalogExposedScopes"]
            == grant["sourcePublicExposure"]["catalogExposedScopes"],
            "prior plan public exposure continuity",
        )
        grant["supersedesPlan"] = prior_pointer
    path = typed_object_path(
        objects_root,
        "negativeRemovalWriteGrant",
        grant_id,
        "negative-removal-write-grant.v1.json",
    )
    path.parent.mkdir(mode=0o700)
    write_canonical_atomic(path, grant)
    require(alpha_record["evidenceStoreBindingID"] == grant["evidenceStoreBindingID"], "grant Alpha binding")
    return relative_path(path)


def validate_remediation_gate_report(
    report: Mapping[str, Any],
    expected_gate: str,
    grant: Mapping[str, Any],
) -> None:
    require(report.get("schemaVersion") == 1, "remediation report schema")
    require(report.get("gateID") == expected_gate, "remediation gate ID")
    require(report.get("overallOutcome") == "passed", "remediation gate outcome")
    snapshot = report.get("sourceSnapshot")
    require(isinstance(snapshot, dict), "remediation source snapshot")
    require(
        snapshot.get("gitHeadCommit") == grant["repositoryBaseCommit"],
        "remediation source base commit",
    )
    require(
        report.get("negativeRemovalWriteGrant", {}).get("grantID")
        == grant["grantID"],
        "remediation write grant identity",
    )


def finalize_negative_removal(
    grant_value: str,
    alpha_record_value: str,
    m0_report_value: str,
    m2_report_value: str,
    supersedes_plan_record_value: str | None,
    objects_root_value: str,
) -> str:
    objects_root = verified_objects_root(objects_root_value)
    source = source_snapshot()
    require(source["worktreeState"] == "clean", "negative removal finalize requires clean source")
    grant_path = ROOT / grant_value
    grant = load_canonical(grant_path)
    require(grant.get("schemaVersion") == 1, "write grant schema")
    expected_grant_path = typed_object_path(
        objects_root,
        "negativeRemovalWriteGrant",
        grant["grantID"],
        "negative-removal-write-grant.v1.json",
    )
    require(grant_path == expected_grant_path, "write grant typed path")
    alpha, _, alpha_pointer = alpha_stage_authority(
        alpha_record_value, objects_root_value
    )
    require(grant["alphaStage"] == alpha_pointer, "finalize Alpha pointer")
    require(
        ("supersedesPlan" in grant)
        == (supersedes_plan_record_value is not None),
        "finalize prior plan presence",
    )
    if supersedes_plan_record_value is not None:
        _, prior_pointer = prior_plan_projection(
            supersedes_plan_record_value, objects_root_value
        )
        require(grant["supersedesPlan"] == prior_pointer, "finalize prior plan pointer")
    m0_path = ROOT / m0_report_value
    m2_path = ROOT / m2_report_value
    m0_report = load_canonical(m0_path)
    m2_report = load_canonical(m2_path)
    validate_remediation_gate_report(m0_report, "M0-900", grant)
    validate_remediation_gate_report(m2_report, "M2-900", grant)
    result_commit = source["gitHeadCommit"]
    if not grant["grantedContractArtifacts"]:
        require(result_commit == grant["repositoryBaseCommit"], "no-change result commit")
        changed = []
        require(
            m0_report["sourceSnapshot"]["entries"] == []
            and m2_report["sourceSnapshot"]["entries"] == [],
            "no-change remediation snapshot",
        )
    else:
        raise ContractError("non-empty negative removal finalize requires task-specific grant application")
    plan_id = f"plan-{uuid.uuid4()}"
    write_grant_hash = domain_hash(
        "pulsephone.negative-removal-write-grant.v1", grant
    )
    report_artifacts = [
        ("m0-remediation-report", m0_path, m0_report),
        ("m2-remediation-report", m2_path, m2_report),
    ]
    reopened = [
        {
            "gateID": report["gateID"],
            "outcome": "passed",
            "reportArtifactID": artifact_id,
            "reportSHA256": sha256_bytes(path.read_bytes()),
        }
        for artifact_id, path, report in report_artifacts
    ]
    reopened.sort(key=lambda item: item["gateID"])
    plan: Dict[str, Any] = {
        "changedContractArtifacts": changed,
        "evidenceStoreBindingID": grant["evidenceStoreBindingID"],
        "planID": plan_id,
        "releaseFlowID": grant["releaseFlowID"],
        "reopenedGateResults": reopened,
        "repositoryResultCommit": result_commit,
        "resultEvidencePolicy": grant["sourceEvidencePolicy"],
        "resultPublicExposure": grant["sourcePublicExposure"],
        "schemaVersion": 1,
        "surfaceValidation": {
            "catalog": "passed",
            "cli": "passed",
            "docs": "passed",
            "gui": "passed",
            "help": "passed",
            "policy": "passed",
            "tests": "passed",
        },
        "writeGrant": grant,
        "writeGrantHash": write_grant_hash,
    }
    if "supersedesPlan" in grant:
        plan["supersedesPlan"] = grant["supersedesPlan"]
    validate_negative_removal_plan(plan)
    run_id = f"run-{uuid.uuid4()}"
    package = typed_object_path(
        objects_root,
        "evidenceRunPackage",
        run_id,
        "evidence-manifest.v1.json",
    ).parent
    package.mkdir(mode=0o700)
    scenario_id = "T-017/negative-removal-consistency-l5.internalAlpha"
    artifacts = [
        copy_file_artifact(
            package,
            "negative-removal-write-grant",
            grant_path.read_bytes(),
            "negativeRemovalWriteGrant",
            [scenario_id],
            owner_role="releaseOwner",
        ),
        copy_file_artifact(
            package,
            "negative-removal-plan",
            canonical_bytes(plan),
            "negativeRemovalPlan",
            [scenario_id],
            owner_role="releaseOwner",
        ),
    ]
    for artifact_id, report_path, _ in report_artifacts:
        artifacts.append(
            copy_file_artifact(
                package,
                artifact_id,
                report_path.read_bytes(),
                "implementationGateReport",
                [scenario_id],
                owner_role="releaseOwner",
            )
        )
    scope = {
        "nonCommandFeatureIDs": [],
        "preparationGroupIDs": [],
        "productActionIDs": [],
        "scopeKind": "global",
    }
    environment = {
        "facetIDs": ["cleanliness.clean", "distribution.currentCandidate"],
        "profileID": "env.alpha.clean-current",
    }
    manifest = {
        "artifacts": sorted(artifacts, key=lambda item: item["artifactID"]),
        "candidate": alpha["candidate"],
        "endedAtUTC": utc_now(),
        "evidencePolicy": grant["sourceEvidencePolicy"],
        "evidenceRunID": run_id,
        "evidenceStage": "internalAlpha",
        "generator": {"name": "Scripts/evidence-tool", "version": "2"},
        "implementationContractIdentity": grant["sourcePublicExposure"][
            "implementationContractIdentity"
        ],
        "monotonicDurationMs": 0,
        "overallOutcome": "passed",
        "rawMaterialDisposition": {
            "cleanupOutcome": "notRequired",
            "derivedOnly": True,
            "rawPersisted": False,
        },
        "releaseFlow": {
            "evidenceStoreBindingID": grant["evidenceStoreBindingID"],
            "releaseFlowID": grant["releaseFlowID"],
        },
        "retentionClass": "candidateRun",
        "runnerSource": {"gitCommit": result_commit, "worktreeState": "clean"},
        "scenarioResults": [
            {
                "applicability": "applicable",
                "artifactIDs": sorted(item["artifactID"] for item in artifacts),
                "blockerCodes": [],
                "caseKey": "T-017/negative-removal-consistency-l5",
                "claimEffect": "supportsActuallyVerifiedReview",
                "contractRefs": load_requirements()[
                    "T-017/negative-removal-consistency-l5"
                ]["contractRefs"],
                "environmentProfileHash": domain_hash(
                    "pulsephone.evidence-environment-profile.v1", environment
                ),
                "environmentProfileID": environment["profileID"],
                "expectedOracleRef": "fixtureExpected",
                "observedDisposition": "negative-removal.plan-validated",
                "outcome": "passed",
                "requirementID": "T-017/negative-removal-consistency-l5",
                "scenarioID": scenario_id,
                "scopeProjection": scope,
                "scopeProjectionHash": domain_hash(
                    "pulsephone.release-gate-scope.v1", scope
                ),
                "verificationID": "T-017",
            }
        ],
        "schemaVersion": 1,
        "startedAtUTC": utc_now(),
        "supersedesEvidenceRunIDs": [],
        "taskID": "M3-010A",
        "validationStatus": {
            "integrity": "valid",
            "privacy": "valid",
            "rawCleanup": "valid",
            "retention": "valid",
        },
    }
    manifest_bytes = canonical_bytes(manifest)
    manifest_path = package / "evidence-manifest.v1.json"
    manifest_path.write_bytes(manifest_bytes)
    os.chmod(manifest_path, 0o600)
    sidecar = package / "evidence-manifest.v1.sha256"
    sidecar.write_bytes(sha256_bytes(manifest_bytes).encode("ascii"))
    os.chmod(sidecar, 0o600)
    return relative_path(package)


def validate_hold_set(value: Mapping[str, Any]) -> str:
    require(value.get("schemaVersion") == 1, "hold set schema version")
    validate_opaque_id(value.get("holdSetID"), "hold set ID", 64)
    holds = value.get("holds")
    require(isinstance(holds, list), "hold set entries")
    require(len(holds) <= HARD_CAPS["releaseHoldSetEntries"], "hold set cap")
    keys = [(item["packageKind"], item["packageID"]) for item in holds]
    require(keys == sorted(set(keys)), "hold set ordering")
    require(all(item.get("holdReason") == "selectedForRelease" for item in holds), "hold set reason")
    return domain_hash(HOLD_SET_DOMAIN, value)


def verify_release_complete() -> Dict[str, Any]:
    structural = verify_policy_structural()
    verify_hard_caps()
    durable_store_configuration_tests = verify_durable_store_configuration_contract(
        verified_objects_root("build/evidence/objects")
    )
    require(
        release_candidate_input_hash({"schemaVersion": 1})
        == "a190a4775d5faaa5a8451d71d6d232e34ed6e5e347d7ac83b8e0b983e8f749ba",
        "release candidate input domain hash",
    )
    requirements = load_requirements()
    routes = owners_query("M3-012A")
    require(len(routes["fixtureRoutes"]) == 7, "M3-012A fixture route count")
    require(len(routes["runnerRoutes"]) == 7, "M3-012A runner route count")
    route_by_id = {
        route["requirementID"]: route
        for route in load_canonical(ROOT / OWNERS_ROOT)["routes"]
    }
    for route in routes["fixtureRoutes"]:
        requirement = requirements[route["requirementID"]]
        validate_fixture(requirement, ROOT / route["fixtureRelativePath"])
    for route in routes["runnerRoutes"]:
        requirement = requirements[route["requirementID"]]
        validate_adapter(requirement, route_by_id[route["requirementID"]])
    synthetic_candidate = {
        "catalogExposedScopes": [
            {"productActionID": "runtime.status.global", "scopeKind": "host"},
            {
                "deviceClass": "iPhone",
                "osClaim": {
                    "boundedVersionRange": {
                        "maximumExclusive": "27.0.0",
                        "minimumInclusive": "14.0.0",
                    },
                    "claimKind": "boundedVersionRange",
                },
                "productActionID": "app.install",
                "scopeKind": "device",
            },
            {
                "deviceClass": "iPhone",
                "nonCommandFeatureID": "live.audioPreview",
                "osClaim": {
                    "boundedVersionRange": {
                        "maximumExclusive": "27.0.0",
                        "minimumInclusive": "14.0.0",
                    },
                    "claimKind": "boundedVersionRange",
                },
                "scopeKind": "device",
            },
        ]
    }
    proposed = public_scope_from_candidate(synthetic_candidate)
    profile_rows, scopes, environments = derive_profile_requirements(
        "formalRelease", synthetic_candidate, proposed
    )
    require(profile_rows and scopes and environments, "synthetic release profile expansion")
    cohort_rows = [
        row for row in profile_rows if row.get("stageRunCohortID") is not None
    ]
    require(
        {row["requirementID"] for row in cohort_rows}
        == {
            "T-018/performance-threshold-evaluation-l5",
            "T-018/stability-stage-run-l5",
        },
        "Formal cohort exact membership",
    )
    synthetic_profile = {
        "environmentProfiles": environments,
        "evidencePolicy": {
            "hash": structural["evidencePolicyHash"],
            "policyID": structural["policyID"],
        },
        "evidenceStoreBindingID": "durable-self-test-v1",
        "profileID": "profile-self-test",
        "proposedReleaseScopes": proposed,
        "releaseFlowID": "flow-self-test",
        "releaseInput": {
            "candidateInput": {
                "candidate": {
                    "appBundleContentHash": "0" * 64,
                    "appVersion": "0.0.0",
                    "buildID": "0",
                },
                "implementationContractIdentity": {},
                "sourceCommit": "0" * 40,
            },
            "candidateInputHash": "0" * 64,
        },
        "releaseStage": "formalRelease",
        "requirements": profile_rows,
        "schemaVersion": 1,
        "scopeProjections": scopes,
    }
    profile_hash = validate_profile(synthetic_profile)
    synthetic_selection = {
        "entries": [
            {
                "environmentProfileHash": row["environmentProfileHash"],
                "environmentProfileID": row["environmentProfileID"],
                "requirementID": row["requirementID"],
                "scopeProjectionHash": row["scopeProjectionHash"],
                "selectedScenarios": [],
                "verificationID": row["verificationID"],
            }
            for row in profile_rows
        ],
        "evidenceStoreBindingID": "durable-self-test-v1",
        "formalStageRunAttemptLedgers": [],
        "releaseFlowID": "flow-self-test",
        "releaseGateProfileHash": profile_hash,
        "releaseGateProfileID": "profile-self-test",
        "releaseStage": "formalRelease",
        "schemaVersion": 1,
        "selectionSetID": "selection-self-test",
    }
    validate_selection(synthetic_profile, synthetic_selection)
    outcome, evaluated = evaluate_selection(synthetic_profile, synthetic_selection)
    require(outcome == "unknown", "empty selection must be unknown")
    require(
        all(item["reasonCodes"] == ["requiredScenarioMissing"] for item in evaluated),
        "empty selection reason",
    )
    require(
        aggregate_outcomes(["passed", "unknown", "failed"]) == "failed",
        "stage outcome precedence",
    )
    synthetic_grant = {
        "alphaStage": {},
        "evidenceStoreBindingID": "durable-self-test-v1",
        "grantID": "grant-self-test",
        "grantedContractArtifacts": [],
        "releaseFlowID": "flow-self-test",
        "removals": [],
        "repositoryBaseCommit": "0" * 40,
        "schemaVersion": 1,
        "sourceEvidencePolicy": synthetic_profile["evidencePolicy"],
        "sourcePublicExposure": {},
        "sourceRefs": [],
    }
    synthetic_plan = {
        "changedContractArtifacts": [],
        "evidenceStoreBindingID": "durable-self-test-v1",
        "planID": "plan-self-test",
        "releaseFlowID": "flow-self-test",
        "reopenedGateResults": [
            {
                "gateID": "M0-900",
                "outcome": "passed",
                "reportArtifactID": "m0-report",
                "reportSHA256": "0" * 64,
            },
            {
                "gateID": "M2-900",
                "outcome": "passed",
                "reportArtifactID": "m2-report",
                "reportSHA256": "1" * 64,
            },
        ],
        "repositoryResultCommit": "0" * 40,
        "resultEvidencePolicy": synthetic_profile["evidencePolicy"],
        "resultPublicExposure": {},
        "schemaVersion": 1,
        "surfaceValidation": {
            "catalog": "passed",
            "cli": "passed",
            "docs": "passed",
            "gui": "passed",
            "help": "passed",
            "policy": "passed",
            "tests": "passed",
        },
        "writeGrant": synthetic_grant,
        "writeGrantHash": domain_hash(
            "pulsephone.negative-removal-write-grant.v1", synthetic_grant
        ),
    }
    validate_negative_removal_plan(synthetic_plan)
    synthetic_hold_set = {
        "evidenceStoreBindingID": "durable-self-test-v1",
        "formalProvisionalManifestSHA256": "0" * 64,
        "formalProvisionalManifestStoreRef": "ref-self-test",
        "formalProvisionalStageManifestID": "stage-self-test",
        "formalProvisionalStoreRecordSHA256": "1" * 64,
        "holdSetID": "hold-set-self-test",
        "holds": [],
        "releaseFlowID": "flow-self-test",
        "schemaVersion": 1,
    }
    validate_hold_set(synthetic_hold_set)
    stage_observation_tests = (
        verify_stage_observation_predicate()
        + verify_profile_input_contract()
        + verify_performance_evidence_command()
    )
    return {
        "durableStoreConfigurationTests": durable_store_configuration_tests,
        "evidencePolicyHash": structural["evidencePolicyHash"],
        "fixtureCount": len(routes["fixtureRoutes"]),
        "formalProfileTupleCount": len(profile_rows),
        "runnerAdapterCount": len(routes["runnerRoutes"]),
        "stageObservationTests": stage_observation_tests,
    }


def print_json(value: Mapping[str, Any]) -> None:
    sys.stdout.buffer.write(canonical_bytes(value) + b"\n")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="evidence-tool")
    commands = parser.add_subparsers(dest="command", required=True)

    owners = commands.add_parser("owners")
    owners.add_argument("--task", required=True)

    contracts = commands.add_parser("contracts")
    contracts_commands = contracts.add_subparsers(dest="contracts_command", required=True)
    verify = contracts_commands.add_parser("verify")
    verify.add_argument(
        "--profile",
        choices=[
            "bootstrap",
            "evidence-policy-structural",
            "evidence-policy-release-complete",
        ],
        required=True,
    )

    identity = commands.add_parser("contract-identity")
    identity.add_argument(
        "--kind", choices=["evidence-policy", "implementation-gate"], required=True
    )

    artifact_path = commands.add_parser("artifact-path")
    artifact_path.add_argument("--domain", required=True)
    artifact_path.add_argument("--opaque-id", required=True)
    artifact_path.add_argument("--objects-root", required=True)

    snapshot = commands.add_parser("source-snapshot")
    snapshot.add_argument("--output")

    run = commands.add_parser("run")
    run.add_argument("--member", action="append", default=[])
    run.add_argument("--suite")
    run.add_argument("--profile")
    run.add_argument("--task")
    run.add_argument("--release-flow")
    run.add_argument("--release-profile")
    run.add_argument("--evidence-stage")
    run.add_argument("--candidate-record")
    run.add_argument("--negative-removal-plan")
    run.add_argument("--input-artifact", action="append", default=[])
    run.add_argument("--reusable-legal-record", action="append", default=[])
    run.add_argument("--evidence-record", action="append", default=[])
    run.add_argument("--profile-input-artifact", action="append", default=[])
    run.add_argument("--objects-root", required=True)

    validate = commands.add_parser("validate-package")
    validate.add_argument("--kind", choices=["evidence-run"], required=True)
    validate.add_argument("--package", required=True)
    validate.add_argument("--output", required=True)

    store = commands.add_parser("store")
    store_commands = store.add_subparsers(dest="store_command", required=True)
    put = store_commands.add_parser("put")
    put.add_argument("--package", required=True)
    put.add_argument("--validation", required=True)
    put.add_argument("--objects-root", required=True)
    fetch = store_commands.add_parser("fetch")
    fetch.add_argument("--record", required=True)
    fetch.add_argument("--objects-root", required=True)
    store_verify_parser = store_commands.add_parser("verify")
